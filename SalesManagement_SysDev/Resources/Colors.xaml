<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ThemePrimaryColor">#061A3D</Color>
    <Color x:Key="ThemeAccentColor">#2196F3</Color>
    <Color x:Key="ThemeSecondaryColor">#90CAF9</Color>
    <Color x:Key="ThemePaleBlueColor">#E3F2FD</Color>
    <Color x:Key="ThemeCanvasColor">#F8FAFC</Color>
    <Color x:Key="ThemeSurfaceColor">#FFFFFF</Color>
    <Color x:Key="ThemeTextColor">#1E293B</Color>
    <Color x:Key="ThemeSecondaryTextColor">#64748B</Color>
    <Color x:Key="ThemeBorderColor">#E2E8F0</Color>
    <Color x:Key="ThemeInputBorderColor">#CBD5E1</Color>
    <Color x:Key="ThemeSuccessColor">#16A34A</Color>
    <Color x:Key="ThemeWarningColor">#D97706</Color>
    <Color x:Key="ThemeDangerColor">#DC2626</Color>
    <Color x:Key="ThemeSuccessTextColor">#166534</Color>
    <Color x:Key="ThemeWarningTextColor">#92400E</Color>
    <Color x:Key="ThemeDangerTextColor">#991B1B</Color>

    <SolidColorBrush x:Key="ThemePrimary" Color="{StaticResource ThemePrimaryColor}" />
    <SolidColorBrush x:Key="ThemeSecondary" Color="{StaticResource ThemeSecondaryColor}" />
    <SolidColorBrush x:Key="ThemeAccent" Color="{StaticResource ThemeAccentColor}" />
    <SolidColorBrush x:Key="ThemePaleBlue" Color="{StaticResource ThemePaleBlueColor}" />
    <SolidColorBrush x:Key="ThemeText" Color="{StaticResource ThemeTextColor}" />
    <SolidColorBrush x:Key="ThemeSecondaryText" Color="{StaticResource ThemeSecondaryTextColor}" />
    <SolidColorBrush x:Key="ThemeCanvas" Color="{StaticResource ThemeCanvasColor}" />
    <SolidColorBrush x:Key="ThemeSurface" Color="{StaticResource ThemeSurfaceColor}" />
    <SolidColorBrush x:Key="ThemeSubtle" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ThemeBorder" Color="{StaticResource ThemeBorderColor}" />
    <SolidColorBrush x:Key="ThemeInputBorder" Color="{StaticResource ThemeInputBorderColor}" />
    <SolidColorBrush x:Key="ThemeHover" Color="{StaticResource ThemePaleBlueColor}" />
    <SolidColorBrush x:Key="ThemeSidebar" Color="{StaticResource ThemePrimaryColor}" />
    <SolidColorBrush x:Key="ThemeSidebarForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSidebarMuted" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ThemeSidebarCategory" Color="{StaticResource ThemeSecondaryColor}" />
    <SolidColorBrush x:Key="ThemeSidebarHover" Color="#10284D" />
    <SolidColorBrush x:Key="ThemeSidebarActive" Color="#12345A" />
    <SolidColorBrush x:Key="ThemeSidebarSeparator" Color="#294466" />
    <SolidColorBrush x:Key="ThemeDanger" Color="{StaticResource ThemeDangerColor}" />
    <SolidColorBrush x:Key="ThemeDangerText" Color="{StaticResource ThemeDangerTextColor}" />
    <SolidColorBrush x:Key="ThemeDangerSurface" Color="#FEF2F2" />
    <SolidColorBrush x:Key="ThemeDangerBorder" Color="#FECACA" />
    <SolidColorBrush x:Key="ThemeSuccess" Color="{StaticResource ThemeSuccessColor}" />
    <SolidColorBrush x:Key="ThemeSuccessText" Color="{StaticResource ThemeSuccessTextColor}" />
    <SolidColorBrush x:Key="ThemeSuccessSurface" Color="#F0FDF4" />
    <SolidColorBrush x:Key="ThemeWarning" Color="{StaticResource ThemeWarningColor}" />
    <SolidColorBrush x:Key="ThemeWarningText" Color="{StaticResource ThemeWarningTextColor}" />
    <SolidColorBrush x:Key="ThemeWarningSurface" Color="#FFFBEB" />
    <SolidColorBrush x:Key="ThemeIconDefault" Color="{StaticResource ThemeSecondaryTextColor}" />
    <SolidColorBrush x:Key="ThemeIconActive" Color="{StaticResource ThemeAccentColor}" />
    <SolidColorBrush x:Key="ThemeIconPrimary" Color="{StaticResource ThemeAccentColor}" />
    <SolidColorBrush x:Key="ThemeIconSidebar" Color="#B8D9F5" />
    <SolidColorBrush x:Key="ThemeIconSuccess" Color="{StaticResource ThemeSuccessColor}" />
    <SolidColorBrush x:Key="ThemeIconWarning" Color="{StaticResource ThemeWarningColor}" />
    <SolidColorBrush x:Key="ThemeIconError" Color="{StaticResource ThemeDangerColor}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource ThemePaleBlueColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource ThemeTextColor}" />
</ResourceDictionary>
