<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    <Style x:Key="PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource TypographyLabel}">
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="CardHeading" TargetType="TextBlock" BasedOn="{StaticResource TypographySection}">
        <Setter Property="FontSize" Value="{StaticResource TypographyCardHeadingSize}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource ThemeCard}">
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <Style x:Key="DialogHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ThemePrimary}" />
        <Setter Property="Padding" Value="24,16" />
        <Setter Property="MinHeight" Value="68" />
    </Style>
    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style x:Key="MultilineInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="80" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="TableText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="TableNumber" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="TableCenter" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="InlineFeedback" TargetType="TextBlock" BasedOn="{StaticResource TypographyValidation}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource ThemeDangerText}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
