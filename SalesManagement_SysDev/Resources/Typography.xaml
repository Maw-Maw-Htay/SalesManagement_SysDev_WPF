<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- WPF device-independent units scale with the display DPI. -->
    <FontFamily x:Key="TypographyFontFamily">Noto Sans JP, Yu Gothic UI, Meiryo</FontFamily>
    <sys:Double x:Key="TypographyPageTitleSize">24</sys:Double>
    <sys:Double x:Key="TypographySectionSize">18</sys:Double>
    <sys:Double x:Key="TypographyCardHeadingSize">16</sys:Double>
    <sys:Double x:Key="TypographySystemTitleSize">22</sys:Double>
    <sys:Double x:Key="TypographyNavigationSize">14</sys:Double>
    <sys:Double x:Key="TypographySidebarMenuSize">13</sys:Double>
    <sys:Double x:Key="TypographySidebarCategorySize">12</sys:Double>
    <sys:Double x:Key="TypographyInputSize">14</sys:Double>
    <sys:Double x:Key="TypographyLabelSize">13</sys:Double>
    <sys:Double x:Key="TypographyTableHeaderSize">13</sys:Double>
    <sys:Double x:Key="TypographyBodySize">14</sys:Double>
    <sys:Double x:Key="TypographyButtonSize">14</sys:Double>
    <sys:Double x:Key="TypographyBadgeSize">12</sys:Double>
    <sys:Double x:Key="TypographyValidationSize">12</sys:Double>
    <FontWeight x:Key="TypographyRegular">400</FontWeight>
    <FontWeight x:Key="TypographyMedium">500</FontWeight>
    <FontWeight x:Key="TypographySemiBold">600</FontWeight>
    <FontWeight x:Key="TypographyBold">700</FontWeight>

    <Style x:Key="TypographyBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TypographyBodySize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="TypographyPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="FontSize" Value="{StaticResource TypographyPageTitleSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyBold}" />
    </Style>
    <Style x:Key="TypographySection" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="FontSize" Value="{StaticResource TypographySectionSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
    </Style>
    <Style x:Key="TypographyLabel" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="FontSize" Value="{StaticResource TypographyLabelSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
    </Style>
    <Style x:Key="TypographyBadge" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="FontSize" Value="{StaticResource TypographyBadgeSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
    </Style>
    <Style x:Key="TypographyValidation" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="FontSize" Value="{StaticResource TypographyValidationSize}" />
    </Style>
    <Style x:Key="TypographyTableHeader" TargetType="TextBlock" BasedOn="{StaticResource TypographyBody}">
        <Setter Property="FontSize" Value="{StaticResource TypographyTableHeaderSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
    </Style>
</ResourceDictionary>
