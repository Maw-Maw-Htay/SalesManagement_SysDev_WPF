<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
        <Setter Property="FontSize" Value="{StaticResource TypographyButtonSize}"/>
        <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}"/>
        <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemeHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemePrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ThemeAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
