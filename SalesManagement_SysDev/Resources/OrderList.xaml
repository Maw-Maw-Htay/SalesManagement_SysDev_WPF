<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SalesManagement_SysDev">
    <SolidColorBrush x:Key="OrderTableHeaderSurface" Color="#E3F0FD" />
    <SolidColorBrush x:Key="OrderTableHeaderText" Color="#102440" />
    <SolidColorBrush x:Key="OrderTableAlternate" Color="#F8FAFC" />
    <SolidColorBrush x:Key="OrderTableHover" Color="#EFF6FF" />
    <SolidColorBrush x:Key="OrderTableSelected" Color="#DBEAFE" />
    <SolidColorBrush x:Key="OrderTableDivider" Color="#E2E8F0" />
    <SolidColorBrush x:Key="OrderTableText" Color="#0F172A" />
    <SolidColorBrush x:Key="OrderTableMuted" Color="#64748B" />
    <SolidColorBrush x:Key="OrderListTabActive" Color="#0B4DBB" />
    <SolidColorBrush x:Key="OrderListTabText" Color="#334155" />
    <SolidColorBrush x:Key="OrderListControlBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="OrderSortActive" Color="#1D4ED8" />
    <SolidColorBrush x:Key="OrderPendingIconBrush" Color="#D97706" />
    <SolidColorBrush x:Key="OrderConfirmedIconBrush" Color="#15803D" />
    <SolidColorBrush x:Key="OrderActionDisabledText" Color="#94A3B8" />
    <SolidColorBrush x:Key="OrderActionDisabledSurface" Color="#F1F5F9" />
    <GeometryGroup x:Key="IconOrderWarning">
        <PathGeometry Figures="M10.3 4.9a2 2 0 0 1 3.4 0l8 13.6A2 2 0 0 1 20 21H4a2 2 0 0 1-1.7-2.5z M12 9v4 M12 17h.01" />
    </GeometryGroup>
    <GeometryGroup x:Key="IconOrderDraft">
        <PathGeometry Figures="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h8" />
    </GeometryGroup>

    <Style x:Key="OrderListTab" TargetType="MenuItem">
        <Setter Property="IsCheckable" Value="True" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,5,4" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
        <Setter Property="Foreground" Value="{StaticResource OrderListTabText}" />
        <Setter Property="Background" Value="{StaticResource OrderTableAlternate}" />
        <Setter Property="BorderBrush" Value="{StaticResource OrderListControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static local:OrderStatusTab.Pending}">
                <Setter Property="Background" Value="#FEF3C7" /><Setter Property="Foreground" Value="#92400E" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static local:OrderStatusTab.Confirmed}">
                <Setter Property="Background" Value="#DCFCE7" /><Setter Property="Foreground" Value="#166534" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static local:OrderStatusTab.Draft}">
                <Setter Property="Background" Value="#DBEAFE" /><Setter Property="Foreground" Value="#1D4ED8" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static local:OrderStatusTab.Hidden}">
                <Setter Property="Background" Value="#FEE2E2" /><Setter Property="Foreground" Value="#991B1B" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static local:OrderStatusTab.History}">
                <Setter Property="Background" Value="#E2E8F0" /><Setter Property="Foreground" Value="#334155" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="7,0" />
                <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Tag" Value="{x:Static local:OrderStatusTab.All}" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource OrderListTabActive}" />
                <Setter Property="BorderBrush" Value="{StaticResource OrderListTabActive}" />
                <Setter Property="Foreground" Value="White" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ThemeAccent}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderListTabCount" TargetType="Border">
        <Setter Property="Background" Value="#160F172A" />
        <Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                <Setter Property="Background" Value="#32FFFFFF" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OrderHeaderGrip" TargetType="Thumb">
        <Setter Property="Width" Value="5" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="OrderTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource OrderTableHeaderSurface}" />
        <Setter Property="Foreground" Value="{StaticResource OrderTableHeaderText}" />
        <Setter Property="Padding" Value="7,0" /><Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource OrderTableDivider}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
                <Grid>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource OrderHeaderGrip}" HorizontalAlignment="Left" />
                    <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource OrderHeaderGrip}" HorizontalAlignment="Right" />
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource OrderTableSelected}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderTableCenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderTableHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="5,0" />
    </Style>
    <Style x:Key="OrderTableRightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderTableHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="OrderSortArrow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OrderTableMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="13" /><Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource OrderTableHover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65" /></Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="OrderSortableHeading">
        <DockPanel>
            <Border DockPanel.Dock="Right" Width="22" Margin="4,0,0,0" VerticalAlignment="Center">
                <StackPanel>
                    <Button Content="▲" AutomationProperties.Name="昇順" ToolTip="昇順"
                            Command="{Binding DataContext.SortAscendingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding Column.SortMemberPath, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OrderSortArrow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending">
                                    <Setter Property="Foreground" Value="{StaticResource OrderSortActive}" />
                                    <Setter Property="Background" Value="{StaticResource OrderTableSelected}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Button Content="▼" AutomationProperties.Name="降順" ToolTip="降順"
                            Command="{Binding DataContext.SortDescendingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding Column.SortMemberPath, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OrderSortArrow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending">
                                    <Setter Property="Foreground" Value="{StaticResource OrderSortActive}" />
                                    <Setter Property="Background" Value="{StaticResource OrderTableSelected}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>

    <Style x:Key="OrderTableRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource OrderTableText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="{StaticResource OrderTableAlternate}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource OrderTableHover}" /></Trigger>
            <DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter Property="Background" Value="{StaticResource OrderTableSelected}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderTableCell" TargetType="DataGridCell">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
    </Style>
    <Style x:Key="OrderStatePill" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="25" /><Setter Property="Width" Value="80" />
        <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="#FDE68A" /><Setter Property="TextElement.Foreground" Value="#92400E" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                <Setter Property="Background" Value="#BBF7D0" /><Setter Property="TextElement.Foreground" Value="#166534" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                <Setter Property="Background" Value="#E2E8F0" /><Setter Property="TextElement.Foreground" Value="#475569" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDraft}" Value="True">
                <Setter Property="Background" Value="#DBEAFE" /><Setter Property="TextElement.Foreground" Value="#1E40AF" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderStateIcon" TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
        <Setter Property="Width" Value="13" /><Setter Property="Height" Value="13" /><Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Data" Value="{StaticResource IconOrderWarning}" />
        <Setter Property="Stroke" Value="{StaticResource OrderPendingIconBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                <Setter Property="Data" Value="{StaticResource IconCheckCircle}" />
                <Setter Property="Stroke" Value="{StaticResource OrderConfirmedIconBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                <Setter Property="Data" Value="{StaticResource IconEyeOff}" /><Setter Property="Stroke" Value="#475569" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDraft}" Value="True">
                <Setter Property="Data" Value="{StaticResource IconOrderDraft}" /><Setter Property="Stroke" Value="#1E40AF" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderRowActionMenu" TargetType="ContextMenu">
        <Setter Property="Width" Value="208" />
        <Setter Property="Placement" Value="Custom" />
        <Setter Property="StaysOpen" Value="False" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource OrderTableText}" />
        <Setter Property="BorderBrush" Value="{StaticResource OrderListControlBorder}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
                <Grid>
                    <Border Margin="4" Background="{TemplateBinding Background}" CornerRadius="8" IsHitTestVisible="False">
                        <Border.Effect><DropShadowEffect Color="#102440" Opacity="0.16" ShadowDepth="1" BlurRadius="8" /></Border.Effect>
                    </Border>
                    <Border x:Name="menuCard" Margin="4" Padding="3" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="OrderRowMenuItem" TargetType="MenuItem">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Foreground" Value="{StaticResource OrderTableText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="MenuItem">
                <Border CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <DockPanel VerticalAlignment="Center">
                        <local:LucideIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0"
                                          Data="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" />
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsHighlighted" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource OrderTableHover}" />
                <Setter Property="Foreground" Value="{StaticResource OrderSortActive}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource OrderActionDisabledText}" />
                <Setter Property="Cursor" Value="No" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderRegisteredMenuItem" TargetType="MenuItem" BasedOn="{StaticResource OrderRowMenuItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDraft}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderHideMenuItem" TargetType="MenuItem" BasedOn="{StaticResource OrderRegisteredMenuItem}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True"><Setter Property="Foreground" Value="#DC2626" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderDraftMenuItem" TargetType="MenuItem" BasedOn="{StaticResource OrderRowMenuItem}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDraft}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderRowMenuSeparator" TargetType="Separator">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Separator">
                <Border Height="1" Margin="11,3" Background="{StaticResource OrderTableDivider}" />
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions><Condition Binding="{Binding IsHidden}" Value="True" /><Condition Binding="{Binding CanRestore}" Value="False" /></MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderBulkButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="106" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource OrderTableText}" />
        <Setter Property="BorderBrush" Value="{StaticResource OrderListControlBorder}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="buttonSurface" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:LucideIcon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}"
                                          Width="15" Height="15" Margin="0,0,6,0" />
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="buttonSurface" Property="BorderBrush" Value="{StaticResource OrderSortActive}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="buttonSurface" Property="Opacity" Value="0.76" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource OrderTableHover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource OrderActionDisabledSurface}" />
                <Setter Property="Foreground" Value="{StaticResource OrderActionDisabledText}" />
                <Setter Property="BorderBrush" Value="{StaticResource OrderTableDivider}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderBulkHideButton" TargetType="Button" BasedOn="{StaticResource OrderBulkButton}">
        <Setter Property="Foreground" Value="#991B1B" />
        <Setter Property="BorderBrush" Value="#FECACA" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="#FEF2F2" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OrderPageButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
        <Setter Property="MinWidth" Value="30" /><Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6,2" /><Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="12" /><Setter Property="BorderBrush" Value="{StaticResource OrderListControlBorder}" />
    </Style>
</ResourceDictionary>
