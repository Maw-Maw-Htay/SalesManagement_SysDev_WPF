<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SalesManagement_SysDev">
        <SolidColorBrush x:Key="OrderCanvas" Color="{StaticResource ThemeCanvasColor}" />
        <SolidColorBrush x:Key="OrderHeader" Color="{StaticResource ThemePrimaryColor}" />
        <SolidColorBrush x:Key="OrderSurface" Color="{StaticResource ThemeSurfaceColor}" />
        <SolidColorBrush x:Key="OrderSurfaceAlt" Color="{StaticResource ThemeCanvasColor}" />
        <SolidColorBrush x:Key="OrderInput" Color="{StaticResource ThemeSurfaceColor}" />
        <SolidColorBrush x:Key="OrderInputBorder" Color="{StaticResource ThemeInputBorderColor}" />
        <SolidColorBrush x:Key="OrderText" Color="{StaticResource ThemeTextColor}" />
        <SolidColorBrush x:Key="OrderSecondaryText" Color="{StaticResource ThemeSecondaryTextColor}" />
        <SolidColorBrush x:Key="OrderDivider" Color="{StaticResource ThemeBorderColor}" />
        <SolidColorBrush x:Key="OrderHover" Color="#F1F5F9" />
        <SolidColorBrush x:Key="OrderSelection" Color="{StaticResource ThemePaleBlueColor}" />
        <SolidColorBrush x:Key="OrderFocus" Color="{StaticResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="OrderOrange" Color="{StaticResource ThemeWarningTextColor}" />
        <SolidColorBrush x:Key="OrderOrangeSurface" Color="#FFFBEB" />
        <SolidColorBrush x:Key="OrderGreen" Color="{StaticResource ThemeSuccessTextColor}" />
        <SolidColorBrush x:Key="OrderGreenSurface" Color="#F0FDF4" />
        <SolidColorBrush x:Key="OrderDanger" Color="{StaticResource ThemeDangerTextColor}" />
        <SolidColorBrush x:Key="OrderDangerSurface" Color="#FEF2F2" />
        <SolidColorBrush x:Key="OrderDangerBorder" Color="#FECACA" />
        <SolidColorBrush x:Key="OrderDisabledText" Color="#94A3B8" />
        <SolidColorBrush x:Key="OrderDisabledSurface" Color="#F1F5F9" />
        <BooleanToVisibilityConverter x:Key="OrderBooleanVisibility" />
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="{StaticResource TypographyLabelSize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="Background" Value="{StaticResource OrderInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderInputBorder}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="Background" Value="{StaticResource OrderSurface}" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource OrderHover}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource OrderSelection}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource OrderSurface}" />
            <Setter Property="Foreground" Value="{StaticResource OrderSecondaryText}" />
        </Style>
        <Style x:Key="OrderColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{StaticResource OrderSurface}" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="OrderCenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="OrderRightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="OrderListCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrderSelection}" />
                    <Setter Property="Foreground" Value="{StaticResource OrderText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderGridRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrderHover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrderSelection}" />
                    <Setter Property="Foreground" Value="{StaticResource OrderText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderStatusBadge" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{StaticResource OrderOrangeSurface}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource OrderOrange}" />
            <Style.Triggers><DataTrigger Binding="{Binding 状態}" Value="確定"><Setter Property="Background" Value="{StaticResource OrderGreenSurface}" /><Setter Property="TextElement.Foreground" Value="{StaticResource OrderGreen}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FilterInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="CaretBrush" Value="{StaticResource OrderText}" />
            <Setter Property="Background" Value="{StaticResource OrderInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="OrderQuickSearchFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource OrderInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource OrderFocus}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="Background" Value="{StaticResource OrderInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderInputBorder}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="Foreground" Value="{StaticResource OrderText}" />
                        <Setter Property="Background" Value="{StaticResource OrderInput}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource OrderHover}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource OrderSelection}" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterDate" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="Background" Value="{StaticResource OrderInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderInputBorder}" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Foreground" Value="{StaticResource OrderText}" />
                        <Setter Property="Background" Value="{StaticResource OrderInput}" />
                        <Setter Property="BorderBrush" Value="{StaticResource OrderInputBorder}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{StaticResource OrderInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderDivider}" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="112" />
        </Style>
        <Style x:Key="OrderToolbarButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="Background" Value="{StaticResource OrderInput}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderInputBorder}" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style x:Key="OrderRegisterButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="{StaticResource OrderHeader}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderHeader}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
        </Style>
        <Style x:Key="OrderActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource OrderInput}" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderDivider}" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource OrderDisabledSurface}" />
                    <Setter Property="Foreground" Value="{StaticResource OrderDisabledText}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OrderDisabledSurface}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderHideActionButton" TargetType="Button" BasedOn="{StaticResource OrderActionButton}">
            <Setter Property="Foreground" Value="{StaticResource OrderDanger}" />
            <Setter Property="Background" Value="{StaticResource OrderDangerSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource OrderDangerBorder}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource OrderDisabledSurface}" />
                    <Setter Property="Foreground" Value="{StaticResource OrderDisabledText}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OrderDisabledSurface}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderFilterField" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="OrderFilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
            <Setter Property="Foreground" Value="{StaticResource OrderText}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- RotateCcw, using the same 24-unit viewport as the existing Lucide icons. -->
        <GeometryGroup x:Key="IconOrderReset">
            <PathGeometry Figures="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <PathGeometry Figures="M3 3v5h5" />
        </GeometryGroup>
        <GeometryGroup x:Key="IconOrderFilter">
            <PathGeometry Figures="M4 4h16l-6 7v7l-4 2v-9z" />
        </GeometryGroup>
        <Style x:Key="StatusMenuItem" TargetType="MenuItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource OrderSecondaryText}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource OrderHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource OrderHeader}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource OrderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusTabIcon" TargetType="{x:Type local:LucideIcon}">
            <Setter Property="Stroke" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                    <Setter Property="Stroke" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTabColoredText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTabCountBadge" TargetType="Border">
            <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource OrderHeader}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
</ResourceDictionary>
