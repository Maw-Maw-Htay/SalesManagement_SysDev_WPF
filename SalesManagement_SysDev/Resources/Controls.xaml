<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SalesManagement_SysDev">
    <BitmapImage x:Key="SalesManagementLogoImage"
                 UriSource="/SalesManagement_SysDev;component/Resources/Branding/SalesManagementLogo.png" />
    <DrawingImage x:Key="SalesManagementWindowIcon">
        <DrawingImage.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,256,256" RadiusX="38" RadiusY="38" />
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Brush>
                    <ImageBrush ImageSource="{StaticResource SalesManagementLogoImage}"
                                Viewbox="0.015444,0.057471,0.237452,0.904215"
                                ViewboxUnits="RelativeToBoundingBox"
                                Stretch="UniformToFill" />
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>
    <Style TargetType="Window">
        <Setter Property="Icon" Value="{StaticResource SalesManagementWindowIcon}" />
        <Setter Property="FontFamily" Value="{StaticResource TypographyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypographyBodySize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Background" Value="{StaticResource ThemeCanvas}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource TypographyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypographyBodySize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style x:Key="ThemeCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="ThemeButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{StaticResource TypographyButtonSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                      <Border x:Name="buttonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                      </Border>
                      <Border x:Name="focusRing" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="2"
                              CornerRadius="8" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonBorder" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonBorder" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StatusFilterButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="focusRing" BorderBrush="{StaticResource ThemeAccent}" BorderThickness="2"
                                CornerRadius="18" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tabBorder" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tabBorder" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="tabBorder" Property="Opacity" Value="0.42" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="StatusActive" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="tabBorder" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="StatusActive" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="tabBorder" Property="Opacity" Value="1" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="StatusActive">
                <Setter Property="Background" Value="{StaticResource ThemePrimary}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ThemeButton}" />
    <Style x:Key="ThemePrimaryButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
        <Setter Property="Background" Value="{StaticResource ThemePrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeSurface}" />
    </Style>
    <Style x:Key="ThemeIconButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{StaticResource ThemePaleBlue}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="inputBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="inputBorder" Property="BorderBrush" Value="{StaticResource ThemeAccent}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="inputBorder" Property="BorderBrush" Value="{StaticResource ThemeDanger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="inputBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="inputBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="inputBorder" Property="BorderBrush" Value="{StaticResource ThemeAccent}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="inputBorder" Property="BorderBrush" Value="{StaticResource ThemeDanger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="inputBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorder}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="comboBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" />
                        <ContentPresenter x:Name="selection" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="9,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="5,1,40,1"
                                 Padding="4,0" BorderThickness="0" Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}"
                                 VerticalContentAlignment="Center" />
                        <ToggleButton x:Name="dropDownToggle" Focusable="False" ClickMode="Press" MinWidth="40" MinHeight="40"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <local:LucideIcon Data="{DynamicResource IconChevronDown}" Stroke="{StaticResource ThemeIconDefault}"
                                                          Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="selection" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="dropDownToggle" Property="Width" Value="40" />
                            <Setter TargetName="dropDownToggle" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="comboBorder" Property="BorderBrush" Value="{StaticResource ThemeAccent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="comboBorder" Property="BorderBrush" Value="{StaticResource ThemeAccent}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="comboBorder" Property="BorderBrush" Value="{StaticResource ThemeDanger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="comboBorder" Property="Opacity" Value="0.5" />
                            <Setter TargetName="selection" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="itemBorder" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource ThemeHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource ThemePaleBlue}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="itemBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource TypographyFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="RowBackground" Value="{StaticResource ThemeSurface}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource ThemeSubtle}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="ColumnHeaderHeight" Value="44" />
        <Setter Property="FontSize" Value="{StaticResource TypographyBodySize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource ThemeHover}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontSize" Value="{StaticResource TypographyTableHeaderSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemeHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemePaleBlue}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="FontFamily" Value="{StaticResource TypographyFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypographyBodySize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemePaleBlue}" />
                <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DatePickerTextBox">
        <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
    </Style>
    <Style x:Key="ThemeDatePickerTextEntry" TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type DatePickerTextBox}}">
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="ThemeDatePickerCalendarButton" TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
        <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="{StaticResource TypographyInputSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyRegular}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="dateBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Style="{DynamicResource ThemeDatePickerTextEntry}" BorderThickness="0" Background="Transparent"
                                               Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center" />
                            <Button x:Name="PART_Button" Grid.Column="1" Style="{DynamicResource ThemeDatePickerCalendarButton}" Focusable="False"
                                    ToolTip="カレンダーを開く" AutomationProperties.Name="カレンダーを開く">
                                <local:LucideIcon Data="{DynamicResource IconCalendar}" Width="16" Height="16" Stroke="{StaticResource ThemeIconDefault}" />
                            </Button>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="dateBorder" Property="BorderBrush" Value="{StaticResource ThemeIconPrimary}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="dateBorder" Property="BorderBrush" Value="{StaticResource ThemeDanger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource TypographyLabelSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TypographyLabelSize}" />
        <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
    </Style>
</ResourceDictionary>
