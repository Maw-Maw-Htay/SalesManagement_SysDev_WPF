<Window x:Class="SalesManagement_SysDev.F_OrderManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesManagement_SysDev"
        Title="受注管理"
        Style="{StaticResource {x:Type Window}}"
        Width="1440"
        Height="760"
        MinWidth="1180"
        MinHeight="620"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource TypographyFontFamily}"
        Background="{DynamicResource OrderCanvas}" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/OrderManagement.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource OrderCanvas}">
        <Grid x:Name="orderRoot" Margin="16" SizeChanged="OrderRootSizeChanged" PreviewKeyDown="OrderRootPreviewKeyDown" Background="{StaticResource OrderCanvas}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="quickSearchRow" Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="quickSearchField" Grid.Row="0" Grid.Column="0" Background="{StaticResource OrderInput}" BorderBrush="{StaticResource OrderInputBorder}" BorderThickness="1" CornerRadius="8" MinHeight="44">
                    <Grid>
                                                <TextBox x:Name="search" Style="{StaticResource FilterInput}" Height="42" Padding="40,4,42,4" BorderThickness="0" Background="Transparent"
                                 Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="受注番号・顧客ID・顧客名で受注を検索" ToolTip="受注番号、顧客ID、顧客名などで検索。入力後に自動で更新します。" />
                        <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0" Stroke="{StaticResource OrderSecondaryText}" IsHitTestVisible="False" />
                        <TextBlock Text="受注番号・顧客ID・顧客名で検索..." Foreground="{StaticResource OrderSecondaryText}" Margin="40,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Click="ClearKeyword" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Margin="0,0,3,0" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="キーワードだけを消去" AutomationProperties.Name="キーワードを消去">
                            <local:LucideIcon Data="{StaticResource IconX}" Width="16" Height="16" Stroke="{StaticResource OrderSecondaryText}" />
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=search}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <StackPanel x:Name="searchActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="clearFiltersButton" Command="{Binding ClearFiltersCommand}" Style="{StaticResource OrderToolbarButton}" Height="36" Visibility="Collapsed" Margin="0,0,8,0"
                            ToolTip="選択中のタブと詳細条件の開閉状態を保って、検索条件をクリア" AutomationProperties.Name="条件クリア">
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconOrderReset}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" />
                            <TextBlock Text="条件クリア" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="collapseButton" Command="{Binding ToggleFiltersCommand}" Style="{StaticResource OrderToolbarButton}" Height="36"
                            ToolTip="{Binding FiltersToggleLabel}" AutomationProperties.Name="{Binding FiltersToggleLabel}">
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" />
                                                        <TextBlock Text="詳細条件" VerticalAlignment="Center" />
                            <Border Background="{StaticResource OrderHover}" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                    Visibility="{Binding HasActiveDetailedFilters, Converter={StaticResource OrderBooleanVisibility}}">
                                <TextBlock Text="{Binding ActiveDetailedFilterCount, StringFormat='({0})'}" Foreground="{StaticResource OrderText}" FontSize="12" VerticalAlignment="Center" />
                            </Border>
                            <local:LucideIcon Width="13" Height="13" Stroke="{StaticResource OrderSecondaryText}" Margin="6,0,0,0">
                                <local:LucideIcon.Style>
                                    <Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                        <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True"><Setter Property="Data" Value="{StaticResource IconChevronUp}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </local:LucideIcon.Style>
                            </local:LucideIcon>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border x:Name="filtersCard" Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding IsFiltersExpanded, Converter={StaticResource OrderBooleanVisibility}}">
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="検索条件" Foreground="{StaticResource OrderText}" VerticalAlignment="Center" FontSize="14" FontWeight="{StaticResource TypographySemiBold}" />
                        <TextBlock Grid.Column="1" Text="入力すると自動で一覧を更新します" Foreground="{StaticResource OrderSecondaryText}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
                    </Grid>
                    <Grid x:Name="filterDetails" SizeChanged="FilterDetailsSizeChanged" Margin="0,0,-12,-12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource OrderFilterField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="受注番号" Style="{StaticResource OrderFilterLabel}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="orderIdFilter" Style="{StaticResource FilterInput}" Height="38"
                                         Text="{Binding OrderNumberFilter, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="受注番号で絞り込み" ToolTip="受注番号の数字または ORD-000123 形式で入力。部分検索もできます。" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource OrderFilterField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="顧客ID・顧客名" Style="{StaticResource OrderFilterLabel}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="customerNameFilter" Style="{StaticResource FilterInput}" Height="38"
                                         Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="顧客ID・顧客名で絞り込み" ToolTip="数値は顧客IDに完全一致、文字は顧客名の一部に一致します。" />
                                <Popup Grid.Row="1" Grid.ColumnSpan="2" x:Name="customerSuggestionPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderInputBorder}" BorderThickness="1" CornerRadius="6">
                                        <ListBox x:Name="customerSuggestions" MaxHeight="180" BorderThickness="0" Background="{StaticResource OrderSurface}" Foreground="{StaticResource OrderText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="SuggestionMouseUp" PreviewKeyDown="SuggestionListKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}" ToolTip="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource OrderFilterField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" x:Name="employeeFilterLabel" Text="担当者" Style="{StaticResource OrderFilterLabel}" />
                                <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="employeeNameFilter" Style="{StaticResource FilterInput}" Height="38"
                                         Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="担当者で絞り込み" ToolTip="担当者名の一部を入力。候補を選択できます。" />
                                <Popup Grid.Row="1" Grid.ColumnSpan="2" x:Name="employeeSuggestionPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderInputBorder}" BorderThickness="1" CornerRadius="6">
                                        <ListBox x:Name="employeeSuggestions" MaxHeight="180" BorderThickness="0" Background="{StaticResource OrderSurface}" Foreground="{StaticResource OrderText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="SuggestionMouseUp" PreviewKeyDown="SuggestionListKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}" ToolTip="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                                                <Border Grid.Column="3" Grid.Row="0" Style="{StaticResource OrderFilterField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="受付営業所" Style="{StaticResource OrderFilterLabel}" />
                                <ComboBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="officeFilter" Style="{StaticResource FilterCombo}" Height="38"
                                          SelectedValuePath="Id" SelectedValue="{Binding SelectedOfficeId, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="受付営業所で絞り込み" />
                            </Grid>
                        </Border>
                        <Border x:Name="orderDateField" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource OrderFilterField}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock x:Name="dateRangeLabel" Text="受注期間（受注日）" Style="{StaticResource OrderFilterLabel}" Margin="0" VerticalAlignment="Center" />
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="今日" Style="{StaticResource QuickButton}" Click="TodayDateRange" />
                                        <Button Content="直近7日" Style="{StaticResource QuickButton}" Click="LastSevenDaysRange" />
                                        <Button Content="今月" Style="{StaticResource QuickButton}" Click="ThisMonthRange" />
                                        <Button Content="全期間" Style="{StaticResource QuickButton}" Click="AllDateRange" />
                                    </WrapPanel>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="fromDate" Style="{StaticResource FilterDate}" Height="38" SelectedDate="{Binding OrderDateFrom, UpdateSourceTrigger=PropertyChanged}" SelectedDateChanged="FilterDateChanged" DateValidationError="FilterDateValidationError" LostKeyboardFocus="FilterDateLostFocus" AutomationProperties.Name="期間の開始日" />
                                    <TextBlock Grid.Column="1" Text="～" Margin="6,0" Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center" />
                                    <DatePicker x:Name="toDate" Grid.Column="2" Style="{StaticResource FilterDate}" Height="38" SelectedDate="{Binding OrderDateTo, UpdateSourceTrigger=PropertyChanged}" SelectedDateChanged="FilterDateChanged" DateValidationError="FilterDateValidationError" LostKeyboardFocus="FilterDateLostFocus" AutomationProperties.Name="期間の終了日" />
                                </Grid>
                                <TextBlock x:Name="dateRangeError" Text="開始日は終了日以前を指定してください。" Foreground="{StaticResource OrderDanger}" Margin="0,5,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="deliveryDateField" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource OrderFilterField}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Height="26" Margin="0,0,0,4">
                                    <TextBlock Text="納期（納品希望日）" Style="{StaticResource OrderFilterLabel}" Margin="0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="deliveryUnsetOnly" DockPanel.Dock="Right" Content="納期未設定のみ" IsChecked="{Binding DeliveryDateUnsetOnly, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Foreground="{StaticResource OrderText}" ToolTip="納品希望日が登録されていない受注だけを表示" FontSize="13" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="deliveryFromDate" Style="{StaticResource FilterDate}" Height="38" SelectedDate="{Binding DeliveryDateFrom, UpdateSourceTrigger=PropertyChanged}" SelectedDateChanged="FilterDateChanged" DateValidationError="FilterDateValidationError" LostKeyboardFocus="FilterDateLostFocus" AutomationProperties.Name="納期の開始日" />
                                    <TextBlock Grid.Column="1" Text="～" Margin="6,0" Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center" />
                                    <DatePicker x:Name="deliveryToDate" Grid.Column="2" Style="{StaticResource FilterDate}" Height="38" SelectedDate="{Binding DeliveryDateTo, UpdateSourceTrigger=PropertyChanged}" SelectedDateChanged="FilterDateChanged" DateValidationError="FilterDateValidationError" LostKeyboardFocus="FilterDateLostFocus" AutomationProperties.Name="納期の終了日" />
                                </Grid>
                                <TextBlock x:Name="deliveryRangeError" Text="納期の開始日は終了日以前を指定してください。" Foreground="{StaticResource OrderDanger}" Margin="0,5,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="filterInputError" Foreground="{StaticResource OrderDanger}" Margin="5,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource OrderDivider}" BorderThickness="0,0,0,1" Padding="0" Margin="0,0,0,4">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Menu x:Name="orderStatusMenu" Grid.Column="0" Background="Transparent" Padding="0" IsMainMenu="False"
                      AutomationProperties.Name="受注状態メニュー">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                    <MenuItem x:Name="allOrdersMenuItem" Style="{StaticResource StatusMenuItem}" Click="ShowAllOrders"
                              ToolTip="すべての受注（非表示を除く）を表示" AutomationProperties.Name="すべて">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Data="{StaticResource IconOrder}" Width="16" Height="16" Stroke="{StaticResource OrderText}" />
                            <Border Width="8" />
                                <TextBlock Text="すべて" VerticalAlignment="Center" />
                                <Border x:Name="allBadge" Background="{StaticResource OrderInput}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="allCount" Text="0 件" Foreground="{StaticResource OrderText}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                                </Border>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem x:Name="pendingMenuItem" Style="{StaticResource StatusMenuItem}" Click="ShowPendingOrders"
                              ToolTip="未確定の受注だけを表示" AutomationProperties.Name="未確定">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Data="{StaticResource IconPending}" Width="16" Height="16" Stroke="{StaticResource OrderOrange}" />
                                <Border Width="8" />
                                <TextBlock Text="未確定" Margin="0" VerticalAlignment="Center" />
                <Border x:Name="pendingBadge" Background="{StaticResource OrderInput}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="pendingCount" Text="0 件" Foreground="{StaticResource OrderText}" FontSize="{StaticResource TypographyBadgeSize}" FontWeight="{StaticResource TypographyMedium}" />
                                </Border>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem x:Name="confirmedMenuItem" Style="{StaticResource StatusMenuItem}" Click="ShowConfirmedOrders"
                              ToolTip="確定済みの受注だけを表示" AutomationProperties.Name="確定済み">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Data="{StaticResource IconCheckCircle}" Width="16" Height="16" Stroke="{StaticResource OrderGreen}" />
                                <Border Width="8" />
                                <TextBlock Text="確定済み" Margin="0" VerticalAlignment="Center" />
                                <Border x:Name="confirmedBadge" Background="{StaticResource OrderHover}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="confirmedCount" Text="0 件" Foreground="{StaticResource OrderText}" FontSize="{StaticResource TypographyBadgeSize}" FontWeight="{StaticResource TypographyMedium}" />
                                </Border>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem x:Name="hiddenMenuItem" Style="{StaticResource StatusMenuItem}" Click="ShowHiddenOrders"
                              ToolTip="非表示の受注だけを表示" AutomationProperties.Name="非表示">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Data="{StaticResource IconHidden}" Width="16" Height="16" Stroke="{StaticResource OrderDanger}" />
                                <Border Width="8" />
                                <TextBlock Text="非表示" Margin="0" Foreground="{StaticResource OrderDanger}" VerticalAlignment="Center" />
                                <Border x:Name="hiddenBadge" Background="{StaticResource OrderDangerSurface}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="hiddenCount" Text="0 件" Foreground="{StaticResource OrderDanger}" FontSize="{StaticResource TypographyBadgeSize}" FontWeight="{StaticResource TypographyMedium}" />
                                </Border>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem x:Name="historyMenuItem" Style="{StaticResource StatusMenuItem}" Click="ShowOrderHistory"
                              ToolTip="受注履歴" AutomationProperties.Name="受注履歴">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Data="{StaticResource IconHistory}" Width="16" Height="16" Stroke="{StaticResource OrderSecondaryText}" />
                                <Border Width="8" />
                                <TextBlock Text="受注履歴" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </Menu>
                    <StackPanel x:Name="orderListActionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Command="{Binding ImportCsvCommand}" Style="{StaticResource OrderToolbarButton}" Height="32" MinWidth="108" Padding="10,3" Margin="0,0,8,0"
                                Background="{StaticResource OrderInput}" Foreground="#061A3D" BorderBrush="{StaticResource OrderInputBorder}"
                                ToolTip="CSVを検証してプレビューし、確認後に受注を取り込みます" AutomationProperties.Name="CSV取込">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Data="M14,2 L6,2 A2,2 0 0,0 4,4 L4,20 A2,2 0 0,0 6,22 L18,22 A2,2 0 0,0 20,20 L20,8 Z M14,2 L14,8 L20,8 M12,18 L12,12 M9,15 L12,12 L15,15" Width="15" Height="15" Stroke="#061A3D" Margin="0,0,7,0" />
                                <TextBlock Text="CSV取込" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource OrderToolbarButton}" Height="32" MinWidth="88" Padding="12,3"
                                Background="#061A3D" Foreground="White" BorderBrush="#061A3D"
                                ToolTip="現在の検索条件に一致する受注をA4横でプレビューします" AutomationProperties.Name="印刷">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <local:LucideIcon Data="M6,9 L6,2 L18,2 L18,9 M6,17 L3,17 L3,9 L21,9 L21,17 L18,17 M6,14 L18,14 L18,22 L6,22 Z M17,11 L18,11" Width="15" Height="15" Stroke="White" Margin="0,0,7,0" />
                                <TextBlock Text="印刷" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="listContainer" Grid.Row="3" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            <Grid x:Name="listToolbar" Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock x:Name="pageTitle" Text="受注一覧" Foreground="{StaticResource OrderText}" FontSize="15" FontWeight="{StaticResource TypographySemiBold}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="resultCount" Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" FontSize="13" Margin="0,0,12,0" />
                    <TextBlock x:Name="selectionCount" Foreground="{StaticResource OrderSecondaryText}" Background="{StaticResource OrderInput}" Padding="7,3" ToolTip="チェックした受注を一括確定・非表示できます" FontSize="12" FontWeight="{StaticResource TypographyMedium}" VerticalAlignment="Center" />
                    <TextBlock x:Name="listInteractionHint" Text="行をダブルクリックすると詳細を表示" Foreground="{StaticResource OrderSecondaryText}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="{StaticResource TypographyRegular}" />
                </WrapPanel>
                <StackPanel x:Name="orderActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="選択を確定" Command="{Binding ConfirmSelectedCommand}" ToolTip="チェックした未確定・表示中の受注を確定" Style="{StaticResource OrderActionButton}" FontSize="{StaticResource TypographyButtonSize}" FontWeight="{StaticResource TypographySemiBold}" />
                    <Button Content="選択を非表示" Command="{Binding HideSelectedCommand}" ToolTip="チェックした表示中の受注を理由付きで非表示" Style="{StaticResource OrderHideActionButton}" Margin="8,0,0,0" FontSize="{StaticResource TypographyButtonSize}" FontWeight="{StaticResource TypographySemiBold}" />
                </StackPanel>
                <TextBlock x:Name="activeFilterSummary" Grid.Row="1" Grid.ColumnSpan="2"
                           Foreground="{StaticResource OrderSecondaryText}" Margin="2,3,2,2"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
            </Grid>

            <Grid Grid.Row="1">
            <DataGrid x:Name="grid"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      FrozenColumnCount="2"
                      ColumnHeaderStyle="{StaticResource OrderColumnHeader}"
                      CellStyle="{StaticResource OrderListCell}"
                      CanUserResizeColumns="True"
                      SelectionMode="Extended"
                      RowHeight="44"
                      ColumnHeaderHeight="44"
                      HeadersVisibility="Column"
                      Background="{StaticResource OrderSurface}"
                      Foreground="{StaticResource OrderText}"
                      BorderBrush="Transparent" BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource OrderDivider}"
                      VerticalGridLinesBrush="Transparent"
                      RowStyle="{StaticResource OrderGridRow}"
                      RowBackground="{StaticResource OrderSurface}"
                      AlternatingRowBackground="{StaticResource OrderSurfaceAlt}"
                      AlternationCount="2"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                       ScrollViewer.PanningMode="Both" Margin="0" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" MinWidth="40" MaxWidth="40" CanUserResize="False" HeaderStyle="{StaticResource OrderCenterHeader}">
                        <DataGridTemplateColumn.Header><CheckBox x:Name="selectAllRows" IsThreeState="True" Click="SelectAllClick" ToolTip="すべて選択／すべて解除" AutomationProperties.Name="すべての受注を選択／解除" /></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding 選択, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="RowSelectionChanged" Unchecked="RowSelectionChanged" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding 受注番号, StringFormat='受注 {0} を選択'}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="受注番号" Binding="{Binding 受注番号}" Width="112" MinWidth="112" IsReadOnly="True" HeaderStyle="{StaticResource OrderCenterHeader}" ElementStyle="{StaticResource TableCenter}" />
                    <DataGridTemplateColumn Header="受注日 / 納期" Width="156" MinWidth="148" IsReadOnly="True" SortMemberPath="受注日" CanUserSort="True" HeaderStyle="{StaticResource OrderCenterHeader}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding 日付説明}" Margin="8,2">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:LucideIcon Data="{StaticResource IconCalendar}" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="{Binding 受注日, StringFormat=yyyy-MM-dd}" LineHeight="18" /></StackPanel>
                                <TextBlock Text="{Binding 納品希望日表示}" FontSize="12" LineHeight="16" Foreground="{StaticResource OrderSecondaryText}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="顧客名" Binding="{Binding 顧客}" Width="215*" MinWidth="128" IsReadOnly="True" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="受注合計金額" Binding="{Binding 合計金額, StringFormat='¥{0:N0}'}" Width="160*" MinWidth="132" IsReadOnly="True" HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}" />
                    <DataGridTemplateColumn Header="受注状態" Width="110*" MinWidth="96" IsReadOnly="True" HeaderStyle="{StaticResource OrderCenterHeader}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource OrderStatusBadge}"><TextBlock Text="{Binding 状態表示}" Style="{StaticResource TypographyBadge}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="orderEmptyState" Text="該当する受注はありません。条件を変更するか、条件クリアをお試しください。"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource OrderSecondaryText}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20" IsHitTestVisible="False" Visibility="Collapsed" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}" />
            <Grid x:Name="historyPanel" Visibility="Collapsed" Margin="2,0,2,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="185" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,12,0">
                        <TextBox x:Name="historySearch" Height="40" Padding="10,5" Background="{StaticResource OrderInput}" BorderBrush="{StaticResource OrderInputBorder}" Foreground="{StaticResource OrderText}"
                                     ToolTip="受注番号、顧客名、実行担当者、操作内容で検索" />
                        <TextBlock Text="受注番号、顧客名、担当者、操作内容で検索..." Foreground="{StaticResource OrderSecondaryText}"
                                       Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=historySearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                <ComboBox x:Name="historyOperationFilter" Grid.Column="1" Style="{StaticResource FilterCombo}" Height="40" Padding="8,4"
                                  VerticalContentAlignment="Center" ToolTip="操作種別で絞り込み" />
                        <TextBlock x:Name="historyResultCount" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,2,0" Foreground="{StaticResource OrderSecondaryText}" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                    </Grid>
                </Border>
                        <DataGrid x:Name="historyGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                          SelectionMode="Single" MinRowHeight="44" ColumnHeaderHeight="42" HeadersVisibility="Column"
                          Background="{StaticResource OrderSurface}" BorderBrush="Transparent" BorderThickness="0" Foreground="{StaticResource OrderText}"
                          RowStyle="{StaticResource OrderGridRow}" RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource OrderDivider}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}" />
                <TextBlock x:Name="historyEmptyState" Grid.Row="1" Text="該当する操作履歴がありません。"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource OrderSecondaryText}" Visibility="Collapsed" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}" />
                <TextBlock Grid.Row="2" Text="既存の受注は「記録開始時の状態」として表示します。過去の操作日時や変更前の値は未記録です。"
                            Foreground="{StaticResource OrderSecondaryText}" TextWrapping="Wrap" Margin="2,6,2,0" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
            </Grid>
            </Grid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
