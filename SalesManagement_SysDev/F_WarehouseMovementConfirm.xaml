<Window x:Class="SalesManagement_SysDev.F_WarehouseMovementConfirm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確定確認" Width="560" SizeToContent="Height" MinWidth="440" MaxWidth="700" MaxHeight="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="66" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <TextBlock Text="{Binding ConfirmationPrompt}" Foreground="{StaticResource ThemeText}" FontSize="14" TextWrapping="Wrap" />
                <Border Background="{StaticResource ThemeSubtle}" CornerRadius="6" Padding="12" Margin="0,14,0,10">
                    <TextBlock Text="{Binding TargetText}" Foreground="{StaticResource ThemeText}" TextWrapping="Wrap" />
                </Border>
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" ColumnHeaderHeight="34" MaxHeight="180"
                          Visibility="{Binding HasStoredLines, Converter={StaticResource BooleanVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" Width="110" />
                        <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="数量" Binding="{Binding QuantityText}" Width="78" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Visibility="{Binding IsAwaitingReceipt, Converter={StaticResource BooleanVisibility}}"
                            IsEnabled="{Binding CanEditReceipt}">
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="入庫日" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <DatePicker Width="150" SelectedDate="{Binding ReceiptDate}" DateValidationError="ReceiptDate_ValidationError"
                                    AutomationProperties.Name="実際の入庫日" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding ReceiptEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeight="42" ColumnHeaderHeight="34" MaxHeight="230">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" Width="105" />
                            <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource TableText}" />
                            <DataGridTextColumn Header="発注数量" Binding="{Binding OrderedQuantity, StringFormat=N0}" Width="81"
                                                ElementStyle="{StaticResource TableNumber}" />
                            <DataGridTemplateColumn Header="実入庫数量" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                                 Height="32" Margin="5,0" VerticalAlignment="Center" TextAlignment="Right"
                                                 AutomationProperties.Name="{Binding ProductName, StringFormat={}{0}の実入庫数量}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <Border Background="{StaticResource ThemeWarningSurface}" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                    <TextBlock Text="{Binding ImpactText}" Foreground="{StaticResource ThemeWarningText}" TextWrapping="Wrap" FontSize="12" />
                </Border>
                <TextBlock Text="{Binding LineError}" Foreground="{StaticResource ThemeDangerText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,10,0,0" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="キャンセル" IsCancel="True" MinWidth="106" Height="38" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="{Binding ActionLabel}" IsDefault="True" MinWidth="136" Height="38" Background="{StaticResource ThemePrimary}"
                            Foreground="White" BorderBrush="{StaticResource ThemePrimary}" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
