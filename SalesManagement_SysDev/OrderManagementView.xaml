<UserControl x:Class="SalesManagement_SysDev.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}" SizeChanged="OrderView_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/OrderManagement.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="OrderCustomerCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="ToolTip" Value="{Binding Customer}" />
            </Style>
            <Style x:Key="OrderOfficeCell" TargetType="TextBlock" BasedOn="{StaticResource OrderCustomerCell}">
                <Setter Property="ToolTip" Value="{Binding Office}" />
            </Style>
            <Style x:Key="ChumonCenterCell" TargetType="TextBlock" BasedOn="{StaticResource TableCenter}">
                <Setter Property="Margin" Value="4,0" />
            </Style>
            <Style x:Key="ChumonNumberCell" TargetType="TextBlock" BasedOn="{StaticResource TableNumber}">
                <Setter Property="Margin" Value="4,0,8,0" />
            </Style>
            <Style x:Key="ChumonHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
                <Setter Property="Padding" Value="5,0" />
            </Style>
            <Style x:Key="ChumonCenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ChumonHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ChumonRightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ChumonHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style x:Key="OrderConfirmActionButton" TargetType="Button" BasedOn="{StaticResource OrderActionButton}">
                <Setter Property="Background" Value="{StaticResource OrderHeader}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource OrderHeader}" />
                <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource OrderDisabledSurface}" />
                        <Setter Property="Foreground" Value="{StaticResource OrderDisabledText}" />
                        <Setter Property="BorderBrush" Value="{StaticResource OrderDisabledSurface}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OrderFilterSlot" TargetType="StackPanel">
                <Setter Property="Margin" Value="4,0,4,6" />
            </Style>
            <Style x:Key="OrderRangeDate" TargetType="DatePicker" BasedOn="{StaticResource FilterDate}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <EventSetter Event="SelectedDateChanged" Handler="FilterDateChanged" />
                <EventSetter Event="PreviewTextInput" Handler="FilterDateEditing" />
            </Style>
            <Style x:Key="OrderDetailButton" TargetType="Button" BasedOn="{StaticResource OrderToolbarButton}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="7,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="QuickSearchRow" Grid.Row="0" Margin="0,0,0,8" SizeChanged="QuickSearchRow_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="QuickSearchField" Grid.Row="0" Grid.Column="0" Style="{StaticResource OrderQuickSearchFrame}"
                    Background="{StaticResource OrderInput}" BorderThickness="1" CornerRadius="8" MinHeight="44">
                <Grid>
                    <TextBox x:Name="QuickSearch" Style="{StaticResource FilterInput}" Height="42" Padding="40,4,42,4"
                             BorderThickness="0" Background="Transparent"
                             Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="注文番号・顧客ID・顧客名で注文を検索"
                             ToolTip="注文番号、顧客ID、顧客名で検索します。入力後に自動で更新します。" />
                    <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" HorizontalAlignment="Left"
                                      Margin="12,0,0,0" Stroke="{StaticResource OrderSecondaryText}" IsHitTestVisible="False" />
                    <TextBlock Text="注文番号・顧客ID・顧客名で検索..." Foreground="{StaticResource OrderSecondaryText}"
                               Margin="40,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Click="ClearQuickSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="36" Height="36" Margin="0,0,3,0" Padding="0" Background="Transparent"
                            BorderBrush="Transparent" ToolTip="キーワードを消去" AutomationProperties.Name="キーワードを消去">
                        <local:LucideIcon Data="{StaticResource IconX}" Width="16" Height="16" Stroke="{StaticResource OrderSecondaryText}" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <StackPanel x:Name="SearchActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ToggleFiltersButton" Click="ToggleFilters_Click" Style="{StaticResource OrderToolbarButton}"
                        Height="36" Margin="8,0,8,0" ToolTip="{Binding FiltersToggleLabel}" AutomationProperties.Name="詳細条件">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="15" Height="15"
                                          Stroke="{StaticResource OrderText}" Margin="0,0,6,0" />
                        <TextBlock Text="詳細条件" VerticalAlignment="Center" />
                        <local:LucideIcon Width="13" Height="13" Stroke="{StaticResource OrderSecondaryText}" Margin="6,0,0,0">
                            <local:LucideIcon.Style>
                                <Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconChevronUp}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:LucideIcon.Style>
                        </local:LucideIcon>
                    </StackPanel>
                </Button>
                <Button Content="注文履歴" Click="BusinessHistory_Click" Style="{StaticResource OrderToolbarButton}" Height="36" Margin="0,0,8,0" />
                <Button Click="Reload_Click" Style="{StaticResource OrderToolbarButton}" Height="36"
                        ToolTip="注文一覧を再読込" AutomationProperties.Name="再読込">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" />
                        <TextBlock Text="再読込" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                Visibility="{Binding IsFiltersExpanded, Converter={StaticResource OrderBooleanVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="AdvancedFieldsScroll" MaxHeight="214" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid x:Name="AdvancedFields" Columns="4">
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="注文番号" Style="{StaticResource OrderFilterLabel}" />
                            <TextBox Text="{Binding OrderFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                     Height="36" ToolTip="例: CH-000173" AutomationProperties.Name="注文番号" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="顧客名" Style="{StaticResource OrderFilterLabel}" />
                            <TextBox Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                     Height="36" AutomationProperties.Name="顧客名" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="注文日（開始）" Style="{StaticResource OrderFilterLabel}" />
                            <DatePicker SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OrderRangeDate}" DateValidationError="FilterDateValidationError"
                                        AutomationProperties.Name="注文日（開始）" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="注文日（終了）" Style="{StaticResource OrderFilterLabel}" />
                            <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OrderRangeDate}" DateValidationError="FilterDateValidationError"
                                        AutomationProperties.Name="注文日（終了）" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="納期（開始）" Style="{StaticResource OrderFilterLabel}" />
                            <DatePicker SelectedDate="{Binding DeliveryFrom, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OrderRangeDate}" DateValidationError="FilterDateValidationError"
                                        AutomationProperties.Name="納期（開始）" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="納期（終了）" Style="{StaticResource OrderFilterLabel}" />
                            <DatePicker SelectedDate="{Binding DeliveryTo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OrderRangeDate}" DateValidationError="FilterDateValidationError"
                                        AutomationProperties.Name="納期（終了）" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="受付営業所" Style="{StaticResource OrderFilterLabel}" />
                            <ComboBox ItemsSource="{Binding OfficeOptions}" SelectedValue="{Binding OfficeFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" Style="{StaticResource FilterCombo}" Height="36"
                                      AutomationProperties.Name="受付営業所" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="注文状態" Style="{StaticResource OrderFilterLabel}" />
                            <ComboBox ItemsSource="{Binding StateOptions}" SelectedValue="{Binding StateFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" Style="{StaticResource FilterCombo}" Height="36"
                                      AutomationProperties.Name="注文状態" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource OrderFilterSlot}">
                            <TextBlock Text="管理状態" Style="{StaticResource OrderFilterLabel}" />
                            <ComboBox ItemsSource="{Binding ManagementOptions}" SelectedValue="{Binding ManagementFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" Style="{StaticResource FilterCombo}" Height="36"
                                      AutomationProperties.Name="管理状態" ToolTip="非表示の注文は「非表示」タブで確認できます。" />
                        </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
                <DockPanel Grid.Row="1" Margin="4,2,4,0">
                    <Button x:Name="ClearFiltersButton" DockPanel.Dock="Right" Click="ClearFilters_Click" Style="{StaticResource OrderToolbarButton}"
                            Height="32" Margin="8,0,0,0" ToolTip="選択中のタブを保って検索条件をクリア">
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconOrderReset}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" />
                            <TextBlock Text="条件クリア" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="DateInputError" DockPanel.Dock="Top" Foreground="{StaticResource OrderDanger}" TextWrapping="Wrap"
                               FontSize="12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding FilterValidationMessage}" Foreground="{StaticResource OrderDanger}" TextWrapping="Wrap"
                               FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Grid>
        </Border>

        <Menu Grid.Row="2" Margin="0,0,0,8" Background="Transparent" Padding="0" VerticalAlignment="Center"
              IsMainMenu="False" AutomationProperties.Name="注文状態メニュー">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </Menu.ItemsPanel>
                <MenuItem x:Name="AllTab" Style="{StaticResource StatusMenuItem}" Click="All_Click"
                          ToolTip="表示中のすべての注文">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconOrder}" Width="16" Height="16" Tag="{StaticResource OrderText}" Style="{StaticResource StatusTabIcon}" />
                            <Border Width="8" />
                            <TextBlock Text="すべて" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0">
                                <TextBlock Text="{Binding AllCount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="PendingTab" Style="{StaticResource StatusMenuItem}" Click="Pending_Click"
                          ToolTip="未確定の注文だけを表示">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconPending}" Width="16" Height="16" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabIcon}" />
                            <Border Width="8" />
                            <TextBlock Text="未確定" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0">
                                <TextBlock Text="{Binding PendingCount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="ConfirmedTab" Style="{StaticResource StatusMenuItem}" Click="Confirmed_Click"
                          ToolTip="確定済みの注文だけを表示">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconCheckCircle}" Width="16" Height="16" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabIcon}" />
                            <Border Width="8" />
                            <TextBlock Text="確定済み" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderHover}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0">
                                <TextBlock Text="{Binding ConfirmedCount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="HiddenTab" Style="{StaticResource StatusMenuItem}" Click="Hidden_Click"
                          ToolTip="非表示の注文だけを表示">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconHidden}" Width="16" Height="16" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabIcon}" />
                            <Border Width="8" />
                            <TextBlock Text="非表示" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderDangerSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0">
                                <TextBlock Text="{Binding HiddenCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
        </Menu>

        <Border Grid.Row="3" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ListHeader" Grid.Row="0" Margin="0,0,0,8" SizeChanged="ListHeader_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="注文一覧" Foreground="{StaticResource OrderText}" FontSize="15"
                                   FontWeight="{StaticResource TypographySemiBold}" VerticalAlignment="Center" Margin="2,0,8,0"
                                   ToolTip="{Binding Text, ElementName=ListHelp}" />
                        <TextBlock Text="{Binding CountText}" Foreground="{StaticResource OrderSecondaryText}"
                                   FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="BulkActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCount, StringFormat=選択 {0:N0} 件}" Foreground="{StaticResource OrderSecondaryText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="選択を非表示" Click="Hide_Click" Style="{StaticResource OrderHideActionButton}"
                                Height="36" Margin="0,0,8,0" IsEnabled="{Binding CanHide}" />
                        <Button Content="選択した注文を確定" Click="Confirm_Click" Style="{StaticResource OrderConfirmActionButton}"
                                Height="36" IsEnabled="{Binding CanConfirm}" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="OrdersGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow" FrozenColumnCount="2"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="42" ColumnHeaderHeight="38"
                          AlternationCount="2" ColumnHeaderStyle="{StaticResource ChumonHeader}"
                          CellStyle="{StaticResource OrderListCell}" RowStyle="{StaticResource OrderGridRow}"
                          Background="{StaticResource OrderSurface}" Foreground="{StaticResource OrderText}"
                          BorderBrush="Transparent" BorderThickness="0" HorizontalGridLinesBrush="{StaticResource OrderDivider}"
                          VerticalGridLinesBrush="Transparent" RowBackground="{StaticResource OrderSurface}"
                          AlternatingRowBackground="{StaticResource OrderSurfaceAlt}"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="OrdersGrid_DoubleClick"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                          FontSize="13" FontWeight="{StaticResource TypographyRegular}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40" MinWidth="40" MaxWidth="40" CanUserResize="False"
                                                CanUserSort="False" IsReadOnly="False" HeaderStyle="{StaticResource ChumonCenterHeader}">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="選択" FontSize="11" HorizontalAlignment="Center" />
                                    <CheckBox HorizontalAlignment="Center" Click="SelectAll_Click"
                                              IsEnabled="{Binding DataContext.CanSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              IsChecked="{Binding DataContext.AllEligibleSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                              ToolTip="表示中の確定可能な注文をすべて選択／解除"
                                              AutomationProperties.Name="表示中の確定可能な注文をすべて選択／解除" />
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsEligible}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="注文番号" Binding="{Binding OrderNumber}" Width="88" MinWidth="88"
                                            IsReadOnly="True" HeaderStyle="{StaticResource ChumonCenterHeader}"
                                            ElementStyle="{StaticResource ChumonCenterCell}" />
                        <DataGridTemplateColumn Header="注文日 / 納期" Width="108" MinWidth="108" IsReadOnly="True"
                                                SortMemberPath="OrderDate" HeaderStyle="{StaticResource ChumonCenterHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,2"
                                                ToolTip="{Binding OrderDate, StringFormat=yyyy/MM/dd}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:LucideIcon Data="{StaticResource IconCalendar}" Width="14" Height="14" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding OrderDate, StringFormat=yyyy/MM/dd, TargetNullValue=—}" LineHeight="18" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <TextBlock Text="納期" FontSize="12" LineHeight="16"
                                                       Foreground="{StaticResource OrderSecondaryText}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding DeliveryDate, StringFormat=yyyy/MM/dd, TargetNullValue=—}" FontSize="12" LineHeight="16"
                                                       Foreground="{StaticResource OrderSecondaryText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="顧客名" Binding="{Binding Customer}" Width="2*" MinWidth="78"
                                            IsReadOnly="True" ElementStyle="{StaticResource OrderCustomerCell}" />
                        <DataGridTextColumn Header="受付営業所" Binding="{Binding Office}" Width="1.2*" MinWidth="80"
                                            IsReadOnly="True" ElementStyle="{StaticResource OrderOfficeCell}" />
                        <DataGridTextColumn Header="明細数" Binding="{Binding LineCount, StringFormat={}{0:N0}}" Width="54" MinWidth="54"
                                            IsReadOnly="True" HeaderStyle="{StaticResource ChumonCenterHeader}"
                                            ElementStyle="{StaticResource ChumonCenterCell}" />
                        <DataGridTextColumn Header="合計金額" Binding="{Binding Total, StringFormat=¥{0:N0}, TargetNullValue=—}" Width="1.2*" MinWidth="90"
                                            IsReadOnly="True" HeaderStyle="{StaticResource ChumonRightHeader}"
                                            ElementStyle="{StaticResource ChumonNumberCell}" />
                        <DataGridTemplateColumn Header="注文状態" Width="78" MinWidth="78" IsReadOnly="True"
                                                SortMemberPath="State" HeaderStyle="{StaticResource ChumonCenterHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource OrderOrangeSurface}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource OrderOrange}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="確定済み">
                                                        <Setter Property="Background" Value="{StaticResource OrderGreenSurface}" />
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource OrderGreen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding State}" Style="{StaticResource TypographyBadge}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="管理状態" Binding="{Binding ManagementState}" Width="74" MinWidth="74"
                                            IsReadOnly="True" HeaderStyle="{StaticResource ChumonCenterHeader}"
                                            ElementStyle="{StaticResource ChumonCenterCell}" />
                        <DataGridTemplateColumn Header="詳細" Width="52" MinWidth="52" CanUserSort="False"
                                                HeaderStyle="{StaticResource ChumonCenterHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="詳細" Click="Details_Click" Style="{StaticResource OrderDetailButton}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding OrderNumber, StringFormat='注文 {0} の詳細'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="2,0,2,0">
                    <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource ThemeDangerText}" TextWrapping="Wrap" Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Feedback}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="ListHelp" Text="合計金額は関連受注の明細金額です。注文操作履歴は既存データに記録されていません。"
                               Foreground="{StaticResource OrderSecondaryText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
