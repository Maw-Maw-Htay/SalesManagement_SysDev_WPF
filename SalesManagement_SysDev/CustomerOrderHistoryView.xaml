<UserControl x:Class="SalesManagement_SysDev.CustomerOrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="ja-JP" Loaded="View_Loaded">
    <UserControl.Resources>
        <ResourceDictionary Source="Resources/OrderManagement.xaml"/>
    </UserControl.Resources>
    <Grid Margin="2,10,2,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="再読込" Click="Reload_Click"
                    Height="30" Padding="8,2" Margin="8,0,0,0"/>
            <TextBlock x:Name="Feedback" Foreground="{StaticResource ThemeSecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single" RowHeight="34" ColumnHeaderHeight="34"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowBackground="{StaticResource OrderSurface}"
                  AlternatingRowBackground="{StaticResource OrderSurfaceAlt}" AlternationCount="2"
                  ColumnHeaderStyle="{StaticResource OrderColumnHeader}" RowStyle="{StaticResource OrderGridRow}"
                  CellStyle="{StaticResource OrderListCell}" EnableRowVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="受注番号" Binding="{Binding Code}" Width="1.2*" MinWidth="118" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="受注日" Binding="{Binding OrderDate, StringFormat=yyyy/MM/dd}" Width="*" MinWidth="105" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="明細数" Binding="{Binding LineCount, StringFormat=N0}" Width="74"
                                    HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}"/>
                <DataGridTextColumn Header="合計金額" Binding="{Binding Amount, StringFormat=C0, ConverterCulture=ja-JP}" Width="1.2*" MinWidth="105"
                                    HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}"/>
                <DataGridTemplateColumn Header="受注状態" Width="96">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Style><Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource OrderOrangeSurface}"/>
                                <Setter Property="TextElement.Foreground" Value="{StaticResource OrderOrange}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding State}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource OrderGreenSurface}"/>
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource OrderGreen}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="{Binding Status}" FontSize="12"/>
                        </Border>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="管理状態" Binding="{Binding VisibilityStatus}" Width="84" ElementStyle="{StaticResource TableCenter}"/>
                <DataGridTemplateColumn Header="詳細" Width="60">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Content="詳細" Click="OpenDetail_Click" Height="25" Padding="4,0" Margin="4,0" VerticalAlignment="Center"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,7,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PreviousButton" Content="前へ" Click="Previous_Click" IsEnabled="False" Height="30" Padding="8,2"/>
                <TextBlock x:Name="PageIndicator" VerticalAlignment="Center" Margin="8,0"/>
                <Button x:Name="NextButton" Content="次へ" Click="Next_Click" IsEnabled="False" Height="30" Padding="8,2"/>
            </StackPanel>
            <TextBlock x:Name="RangeIndicator" VerticalAlignment="Center" Foreground="{StaticResource ThemeSecondaryText}"/>
        </DockPanel>
    </Grid>
</UserControl>
