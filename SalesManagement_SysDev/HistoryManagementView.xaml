<UserControl x:Class="SalesManagement_SysDev.HistoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/OrderManagement.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="HistoryFilterInput" TargetType="Control">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistoryCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="7,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ThemeSubtle}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemePaleBlue}" />
                    <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ThemePaleBlue}" />
                    <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="各管理業務の操作履歴を検索・確認できます"
                   Style="{StaticResource PageSubtitle}" Margin="2,0,0,12" />

        <Border Grid.Row="1" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource ThemeInputBorder}" BorderThickness="1" CornerRadius="6" Background="White" MinHeight="38">
                    <Grid>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" BorderThickness="0" Background="Transparent"
                                 Padding="38,7,10,7" VerticalContentAlignment="Center" FontSize="13"
                                 ToolTip="記録済みの伝票番号・商品名・顧客名・担当者・変更内容で検索します"
                                 AutomationProperties.Name="履歴キーワード検索" />
                        <local:LucideIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="12,0,0,0"
                                          HorizontalAlignment="Left" IsHitTestVisible="False" Stroke="{StaticResource ThemeSecondaryText}" />
                        <TextBlock x:Name="SearchPlaceholder" Text="伝票番号・商品名・顧客名・担当者・変更内容で検索..."
                                   Margin="38,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource ThemeSecondaryText}"
                                   IsHitTestVisible="False" FontSize="13" />
                    </Grid>
                </Border>
                <Button Grid.Column="1" Click="ToggleFilters_Click" Margin="8,0,0,0" Padding="11,7"
                        Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}"
                        AutomationProperties.Name="詳細条件の表示切替">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconDetails}" Width="15" Height="15" Margin="0,0,6,0" Stroke="{StaticResource ThemePrimary}" />
                        <TextBlock x:Name="AdvancedCaption" Text="詳細条件" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="Reload_Click" Margin="8,0,0,0" Style="{StaticResource OrderToolbarButton}" AutomationProperties.Name="再読込">
                    <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Margin="0,0,6,0" /><TextBlock Text="再読込" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="AdvancedFilters" Grid.Row="2" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="業務区分" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <ComboBox x:Name="ModuleFilter" SelectionChanged="Filter_SelectionChanged" Style="{StaticResource HistoryFilterInput}"
                              AutomationProperties.Name="対象管理で絞り込み" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="操作種別" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <ComboBox x:Name="OperationFilter" SelectionChanged="Filter_SelectionChanged" Style="{StaticResource HistoryFilterInput}"
                              AutomationProperties.Name="操作種別で絞り込み" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="対象番号" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <TextBox x:Name="TargetNumberFilter" TextChanged="ActorFilter_TextChanged" Style="{StaticResource HistoryFilterInput}" AutomationProperties.Name="対象番号" /></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="対象名" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <TextBox x:Name="TargetNameFilter" TextChanged="ActorFilter_TextChanged" Style="{StaticResource HistoryFilterInput}" AutomationProperties.Name="対象名" /></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,8,10,0">
                    <TextBlock Text="操作日時（開始）" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <DatePicker x:Name="FromDate" SelectedDateChanged="DateFilter_Changed" DateValidationError="DateFilter_Invalid" Style="{StaticResource HistoryFilterInput}"
                                AutomationProperties.Name="履歴開始日" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,10,0">
                    <TextBlock Text="操作日時（終了）" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <DatePicker x:Name="ToDate" SelectedDateChanged="DateFilter_Changed" DateValidationError="DateFilter_Invalid" Style="{StaticResource HistoryFilterInput}"
                                AutomationProperties.Name="履歴終了日" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,10,0">
                    <TextBlock Text="操作担当者" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <TextBox x:Name="ActorFilter" TextChanged="ActorFilter_TextChanged" Style="{StaticResource HistoryFilterInput}"
                             AutomationProperties.Name="操作担当者で絞り込み" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,8,0,0"><TextBlock Text="処理結果" Style="{StaticResource FormLabel}" Margin="0,0,0,5" />
                    <TextBox Text="未記録" IsReadOnly="True" IsEnabled="False" Style="{StaticResource HistoryFilterInput}" AutomationProperties.Name="処理結果は未記録" /></StackPanel>
                <Button Grid.Row="2" Grid.Column="3" Content="条件クリア" Click="ClearFilters_Click" HorizontalAlignment="Right" Margin="0,8,0,0" Style="{StaticResource OrderToolbarButton}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" x:Name="BusinessHistoryButton" Click="BusinessHistory_Click" Content="業務履歴" Margin="8,0,0,0" Style="{StaticResource OrderToolbarButton}" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <Menu x:Name="ModuleTabs" Background="Transparent" IsMainMenu="False" AutomationProperties.Name="対象の業務区分" />
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Row="4" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}"
                BorderThickness="1" CornerRadius="8" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" FontSize="12"
                          Background="{StaticResource ThemeSurface}" BorderThickness="0" RowBackground="White"
                          AlternatingRowBackground="#FAFBFD" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="HistoryGrid_SelectionChanged" PreviewMouseDoubleClick="HistoryGrid_PreviewMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="操作日時" Binding="{Binding Timestamp}" Width="1.15*" MinWidth="108" ElementStyle="{StaticResource HistoryCellText}" />
                        <DataGridTextColumn Header="業務区分" Binding="{Binding Module}" Width="0.7*" MinWidth="64" ElementStyle="{StaticResource HistoryCellText}" />
                        <DataGridTemplateColumn Header="操作種別" Width="1.15*" MinWidth="88"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Border Background="{Binding OperationBackground}" CornerRadius="8" Padding="6,3" Margin="4,3" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="150">
                                <TextBlock Text="{Binding Operation}" Foreground="{Binding OperationForeground}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Operation}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="対象番号" Binding="{Binding TargetNumber}" Width="0.95*" MinWidth="88" ElementStyle="{StaticResource HistoryCellText}" />
                        <DataGridTextColumn Header="対象名" Binding="{Binding TargetName}" Width="1.05*" MinWidth="74" ElementStyle="{StaticResource HistoryCellText}" />
                        <DataGridTextColumn Header="内容（変更概要）" Binding="{Binding Summary}" Width="2.2*" MinWidth="114" ElementStyle="{StaticResource HistoryCellText}" />
                        <DataGridTextColumn Header="操作担当者" Binding="{Binding ActorName}" Width="0.9*" MinWidth="82" ElementStyle="{StaticResource HistoryCellText}" />
                        <DataGridTemplateColumn Header="詳細" Width="0.62*" MinWidth="62" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="詳細" Click="OpenDetails_Click" Padding="8,4" Margin="4,3"
                                            Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}"
                                            ToolTip="記録された履歴の詳細を表示" AutomationProperties.Name="履歴詳細を表示" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                    <local:LucideIcon Data="{StaticResource IconHistory}" Width="26" Height="26" Margin="0,0,0,10" Stroke="{StaticResource ThemeSecondaryText}" />
                    <TextBlock x:Name="EmptyTitle" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource ThemeText}" />
                    <TextBlock x:Name="EmptyHint" Margin="0,4,0,0" TextAlignment="Center" Foreground="{StaticResource ThemeSecondaryText}" />
                </StackPanel>
                <Border x:Name="LoadingOverlay" Background="#BFFFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="5" IsIndeterminate="True" />
                        <TextBlock Text="履歴を読み込んでいます..." Margin="0,10,0,0" Foreground="{StaticResource ThemeSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border x:Name="ErrorOverlay" Background="{StaticResource ThemeSurface}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
                        <TextBlock x:Name="ErrorText" Text="履歴を取得できませんでした。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ThemeDangerText}" />
                        <Button Content="再読込" Click="Reload_Click" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,6" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="2,10,2,0" LastChildFill="False">
            <TextBlock x:Name="ResultCount" Text="0件" VerticalAlignment="Center" Foreground="{StaticResource ThemeSecondaryText}" />
            <Button x:Name="TimelineButton" DockPanel.Dock="Right" Content="タイムライン" Click="Timeline_Click" IsEnabled="False" Margin="8,0,0,0" Style="{StaticResource OrderToolbarButton}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PreviousPageButton" Content="前へ" Click="PreviousPage_Click" Padding="12,6" Margin="0,0,6,0" IsEnabled="False" />
                <StackPanel x:Name="PageButtons" Orientation="Horizontal" />
                <Button x:Name="NextPageButton" Content="次へ" Click="NextPage_Click" Padding="12,6" IsEnabled="False" />
                <ComboBox x:Name="PageSizePicker" Width="117" Margin="8,0,0,0" ItemStringFormat="{}{0}件 / ページ" SelectionChanged="PageSize_Changed" AutomationProperties.Name="1ページの表示件数" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
