<Window x:Class="SalesManagement_SysDev.F_ArrivalConfirm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入荷を確定する" Width="520" MinWidth="460" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" CornerRadius="8" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="64" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0">
                <DockPanel VerticalAlignment="Center" LastChildFill="True">
                    <TextBlock Text="入荷を確定する" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <Button DockPanel.Dock="Right" Content="×" Click="Cancel_Click" Width="32" Height="32" Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="20" />
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <TextBlock Text="この入荷情報を確定しますか？" Foreground="{StaticResource ThemeText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Border Background="{StaticResource ThemeCanvas}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="入荷番号" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4" />
                        <TextBlock Grid.Column="1" Text="{Binding Arrival.Code}" Foreground="{StaticResource ThemeText}" FontWeight="SemiBold" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="注文番号" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Arrival.OrderCode}" Foreground="{StaticResource ThemeText}" Margin="0,4" />
                        <TextBlock Grid.Row="2" Text="営業所" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Arrival.OfficeName}" Foreground="{StaticResource ThemeText}" Margin="0,4" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="商品行・入荷数量" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{StaticResource ThemeText}" Margin="0,4">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="LineCountText" /><Binding Path="QuantityText" /></MultiBinding></TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="4" Text="顧客" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Arrival.CustomerName}" Foreground="{StaticResource ThemeText}" Margin="0,4" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Border Background="{StaticResource ThemeWarningSurface}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="入荷を確定すると、未確定の出荷情報が作成されます。出荷確定と在庫数量の変更は行いません。"
                               Foreground="{StaticResource ThemeWarningText}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,10,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Padding="20,0" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="キャンセル" Click="Cancel_Click" IsCancel="True" MinWidth="110" Height="38" Margin="0,0,8,0" IsEnabled="{Binding CanConfirm}" />
                    <Button Content="入荷を確定" Click="Confirm_Click" MinWidth="130" Height="38" IsEnabled="{Binding CanConfirm}"
                            Background="{StaticResource ThemePrimary}" BorderBrush="{StaticResource ThemePrimary}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
