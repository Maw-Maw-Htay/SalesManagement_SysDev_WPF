<UserControl x:Class="SalesManagement_SysDev.InventoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}" SizeChanged="InventoryView_SizeChanged"
             Loaded="InventoryView_Loaded" Unloaded="InventoryView_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/OrderManagement.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="InventoryCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                <Setter Property="Margin" Value="7,0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="InventoryNumericCell" TargetType="TextBlock" BasedOn="{StaticResource InventoryCell}">
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
            <Style x:Key="InventoryHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Background" Value="{StaticResource OrderSurfaceAlt}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="InventoryNumericHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource InventoryHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style x:Key="InventoryToolbarButton" TargetType="Button" BasedOn="{StaticResource OrderToolbarButton}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
            <Style x:Key="InventorySummaryCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource OrderSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource OrderDivider}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>
            <Style x:Key="InventoryFilterSlot" TargetType="StackPanel">
                <Setter Property="Margin" Value="4,0,4,6" />
            </Style>
            <Style x:Key="InventoryConditionBadge" TargetType="Border" BasedOn="{StaticResource OrderStatusBadge}">
                <Setter Property="Padding" Value="9,2" />
                <Setter Property="Background" Value="{StaticResource OrderGreenSurface}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource OrderGreen}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Condition}" Value="{x:Static local:InventoryCondition.Low}">
                        <Setter Property="Background" Value="{StaticResource OrderOrangeSurface}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource OrderOrange}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Condition}" Value="{x:Static local:InventoryCondition.Empty}">
                        <Setter Property="Background" Value="{StaticResource OrderDangerSurface}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource OrderDanger}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Condition}" Value="{x:Static local:InventoryCondition.Unavailable}">
                        <Setter Property="Background" Value="{StaticResource OrderDisabledSurface}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource OrderSecondaryText}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="QuickSearchRow" Margin="0,0,0,8" SizeChanged="QuickSearchRow_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="QuickSearchField" Style="{StaticResource OrderQuickSearchFrame}" Background="{StaticResource OrderInput}" CornerRadius="8" MinHeight="44">
                <Grid>
                    <TextBox x:Name="QuickSearch" Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                             Height="42" Padding="40,4,42,4" BorderThickness="0" Background="Transparent"
                             ToolTip="商品コード、商品名、カテゴリ、メーカーで検索" AutomationProperties.Name="在庫一覧を検索" />
                    <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" Margin="12,0,0,0" HorizontalAlignment="Left" Stroke="{StaticResource OrderSecondaryText}" />
                    <TextBlock Text="商品コード・商品名・カテゴリで検索..." Foreground="{StaticResource OrderSecondaryText}" FontSize="13"
                               Margin="40,0,42,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Click="ClearQuickSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Margin="0,0,3,0"
                            Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="キーワードを消去" AutomationProperties.Name="キーワードを消去">
                        <local:LucideIcon Data="{StaticResource IconX}" Width="16" Height="16" Stroke="{StaticResource OrderSecondaryText}" Margin="0" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <StackPanel x:Name="SearchActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="ToggleFilters_Click" Style="{StaticResource InventoryToolbarButton}" ToolTip="{Binding FiltersToggleLabel}" AutomationProperties.Name="詳細条件">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" />
                        <TextBlock Text="詳細条件" VerticalAlignment="Center" />
                        <local:LucideIcon Width="12" Height="12" Stroke="{StaticResource OrderSecondaryText}" Margin="5,0,0,0">
                            <local:LucideIcon.Style>
                                <Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                    <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True"><Setter Property="Data" Value="{StaticResource IconChevronUp}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </local:LucideIcon.Style>
                        </local:LucideIcon>
                    </StackPanel>
                </Button>
                <Button Click="Reload_Click" Style="{StaticResource InventoryToolbarButton}" IsEnabled="{Binding CanReload}" AutomationProperties.Name="再読込">
                        <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" /><TextBlock Text="再読込" VerticalAlignment="Center" /></StackPanel>
                    </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1"
                CornerRadius="8" Padding="8" Margin="0,0,0,8" Visibility="{Binding IsFiltersExpanded, Converter={StaticResource OrderBooleanVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Click="ClearConditions_Click" Style="{StaticResource InventoryToolbarButton}"
                        Margin="0" Height="30" Content="条件クリア" IsEnabled="{Binding HasConditions}" />
                <ScrollViewer x:Name="FiltersScroll" MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid x:Name="AdvancedFilters" Columns="3">
                    <StackPanel Style="{StaticResource InventoryFilterSlot}">
                        <TextBlock Text="商品コード" Style="{StaticResource OrderFilterLabel}" />
                        <TextBox Text="{Binding CodeFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="商品コード" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource InventoryFilterSlot}">
                        <TextBlock Text="商品名" Style="{StaticResource OrderFilterLabel}" />
                        <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="商品名" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource InventoryFilterSlot}">
                        <TextBlock Text="カテゴリ" Style="{StaticResource OrderFilterLabel}" />
                        <TextBox Text="{Binding ClassificationFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="カテゴリ" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource InventoryFilterSlot}">
                        <TextBlock Text="メーカー名" Style="{StaticResource OrderFilterLabel}" />
                        <TextBox Text="{Binding MakerFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="メーカー名" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource InventoryFilterSlot}">
                        <TextBlock Text="在庫数（最小）" Style="{StaticResource OrderFilterLabel}" />
                        <TextBox Text="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="在庫数（最小）" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource InventoryFilterSlot}">
                        <TextBlock Text="在庫数（最大）" Style="{StaticResource OrderFilterLabel}" />
                        <TextBox Text="{Binding MaxQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="在庫数（最大）" />
                    </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <UniformGrid x:Name="SummaryCards" Grid.Row="2" Columns="4" Margin="0,0,-8,0">
                <Border Style="{StaticResource InventorySummaryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <local:LucideIcon Data="{StaticResource IconProduct}" Width="21" Height="21" Stroke="{StaticResource OrderHeader}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="登録商品数" Foreground="{StaticResource OrderHeader}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalCount, StringFormat={}{0:N0}, TargetNullValue=—}" Foreground="{StaticResource OrderText}"
                                           FontSize="22" FontWeight="{StaticResource TypographyBold}" />
                                <TextBlock Text="件" Margin="4,0,0,2" VerticalAlignment="Bottom" Foreground="{StaticResource OrderText}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource InventorySummaryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <local:LucideIcon Data="{StaticResource IconPending}" Width="21" Height="21" Stroke="{StaticResource OrderOrange}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="在庫不足" Foreground="{StaticResource OrderHeader}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LowCount, StringFormat={}{0:N0}, TargetNullValue=—}" Foreground="{StaticResource OrderOrange}"
                                           FontSize="22" FontWeight="{StaticResource TypographyBold}" />
                                <TextBlock Text="件" Margin="4,0,0,2" VerticalAlignment="Bottom" Foreground="{StaticResource OrderOrange}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource InventorySummaryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <local:LucideIcon Data="{StaticResource IconHidden}" Width="21" Height="21" Stroke="{StaticResource OrderDanger}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="在庫切れ" Foreground="{StaticResource OrderHeader}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EmptyCount, StringFormat={}{0:N0}, TargetNullValue=—}" Foreground="{StaticResource OrderDanger}"
                                           FontSize="22" FontWeight="{StaticResource TypographyBold}" />
                                <TextBlock Text="件" Margin="4,0,0,2" VerticalAlignment="Bottom" Foreground="{StaticResource OrderDanger}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource InventorySummaryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <local:LucideIcon Data="{StaticResource IconInventory}" Width="21" Height="21" Stroke="{StaticResource OrderHeader}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="在庫総数" Foreground="{StaticResource OrderHeader}" FontSize="12" FontWeight="{StaticResource TypographyMedium}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalQuantity, StringFormat={}{0:N0}, TargetNullValue=—}" Foreground="{StaticResource OrderText}"
                                           FontSize="22" FontWeight="{StaticResource TypographyBold}" />
                                <TextBlock Text="点" Margin="4,0,0,2" VerticalAlignment="Bottom" Foreground="{StaticResource OrderText}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
        </UniformGrid>

        <Grid x:Name="StatusFiltersRow" Grid.Row="3" Margin="0,0,0,8" SizeChanged="StatusFiltersRow_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Menu Background="Transparent" Padding="0" IsMainMenu="False" AutomationProperties.Name="在庫状態">
                <Menu.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></Menu.ItemsPanel>
                <MenuItem x:Name="AllTab" Style="{StaticResource StatusMenuItem}" Click="AllTab_Click">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconInventory}" Width="15" Height="15" Tag="{StaticResource OrderHeader}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="すべて" Tag="{StaticResource OrderHeader}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="6" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalCount, StringFormat={}{0:N0}, TargetNullValue=—}" Tag="{StaticResource OrderHeader}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="NormalTab" Style="{StaticResource StatusMenuItem}" Click="NormalTab_Click">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconCheckCircle}" Width="15" Height="15" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="正常" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderGreenSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="6" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NormalCount, StringFormat={}{0:N0}, TargetNullValue=—}" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="LowTab" Style="{StaticResource StatusMenuItem}" Click="LowTab_Click">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconPending}" Width="15" Height="15" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="在庫不足" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderOrangeSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="6" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LowCount, StringFormat={}{0:N0}, TargetNullValue=—}" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="EmptyTab" Style="{StaticResource StatusMenuItem}" Click="EmptyTab_Click">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconHidden}" Width="15" Height="15" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="在庫切れ" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderDangerSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="6" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EmptyCount, StringFormat={}{0:N0}, TargetNullValue=—}" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
            <WrapPanel x:Name="StatusActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource InventoryToolbarButton}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="時系列の在庫残高が記録されていません。">
                        <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconSales}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" /><TextBlock Text="在庫推移" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                <Button Style="{StaticResource InventoryToolbarButton}" Click="MovementHistory_Click" ToolTip="在庫移動の記録状況と関連する入庫・出庫履歴を確認">
                        <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconHistory}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" /><TextBlock Text="在庫移動履歴" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                <Button Click="Export_Click" Style="{StaticResource InventoryToolbarButton}" IsEnabled="{Binding CanExport}" ToolTip="絞り込みに一致する全ページを出力" AutomationProperties.Name="CSV出力">
                        <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconDetails}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" /><TextBlock Text="CSV出力" VerticalAlignment="Center" /></StackPanel>
                    </Button>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,6">
                    <TextBlock Text="在庫一覧" FontSize="15" FontWeight="{StaticResource TypographySemiBold}" Foreground="{StaticResource OrderText}" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" Foreground="{StaticResource OrderSecondaryText}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource OrderDanger}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <DataGrid x:Name="InventoryGrid" Grid.Row="1" ItemsSource="{Binding Rows, NotifyOnTargetUpdated=True}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" FrozenColumnCount="2"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeight="36" ColumnHeaderHeight="33" AlternationCount="2"
                          ColumnHeaderStyle="{StaticResource InventoryHeader}" CellStyle="{StaticResource OrderListCell}" RowStyle="{StaticResource OrderGridRow}"
                          Background="{StaticResource OrderSurface}" BorderThickness="0" HorizontalGridLinesBrush="{StaticResource OrderDivider}"
                          RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          TargetUpdated="InventoryGrid_RowsUpdated" Sorting="InventoryGrid_Sorting" MouseDoubleClick="InventoryGrid_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="選択" Width="39" MinWidth="39" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding IsMarked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding DisplayCode, StringFormat='商品 {0} を選択'}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="商品コード" Binding="{Binding DisplayCode}" Width="84" MinWidth="84" SortMemberPath="Code" SortDirection="Ascending" ElementStyle="{StaticResource InventoryCell}" />
                        <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="2*" MinWidth="87" SortMemberPath="Name" ElementStyle="{StaticResource InventoryCell}" />
                        <DataGridTextColumn Header="カテゴリ" Binding="{Binding Classification}" Width="1.2*" MinWidth="73" SortMemberPath="Category" ElementStyle="{StaticResource InventoryCell}" />
                        <DataGridTextColumn Header="現在庫数" Binding="{Binding QuantityText}" Width="70" MinWidth="70" SortMemberPath="Quantity" HeaderStyle="{StaticResource InventoryNumericHeader}" ElementStyle="{StaticResource InventoryNumericCell}" />
                        <DataGridTextColumn Header="安全在庫数" Binding="{Binding SafetyStockText}" Width="81" MinWidth="81" SortMemberPath="SafetyStock" HeaderStyle="{StaticResource InventoryNumericHeader}" ElementStyle="{StaticResource InventoryNumericCell}" />
                        <DataGridTemplateColumn Header="在庫状態" Width="82" MinWidth="82" SortMemberPath="Condition">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Style="{StaticResource InventoryConditionBadge}" ToolTip="{Binding ConditionDetail}"><TextBlock Text="{Binding ConditionLabel}" Style="{StaticResource TypographyBadge}" /></Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="最終更新日時" Binding="{Binding LastUpdatedText}" Width="1.15*" MinWidth="94" CanUserSort="False" ElementStyle="{StaticResource InventoryCell}" />
                        <DataGridTemplateColumn Header="詳細" Width="58" MinWidth="58" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Click="Details_Click" Style="{StaticResource InventoryToolbarButton}" Height="26" Padding="6,0" Margin="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayCode, StringFormat='商品 {0} の詳細'}">
                                    <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconDetails}" Width="12" Height="12" Stroke="{StaticResource OrderText}" Margin="0,0,3,0" /><TextBlock Text="詳細" VerticalAlignment="Center" FontSize="12" /></StackPanel>
                                </Button>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Text="条件に一致する在庫がありません。" Foreground="{StaticResource OrderSecondaryText}"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource OrderBooleanVisibility}}" />
                <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="False">
                    <TextBlock Text="{Binding PageRangeText}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="1,0,8,0" FontSize="12" />
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Click="Previous_Click" Style="{StaticResource InventoryToolbarButton}" Height="30" Content="前へ" IsEnabled="{Binding CanPrevious}" />
                        <TextBox x:Name="PageNumber" Width="44" Height="30" Margin="6,0,0,0" Padding="3,0" TextAlignment="Center"
                                 Style="{StaticResource FilterInput}" Text="{Binding CurrentPage, Mode=OneWay}" KeyDown="PageNumber_KeyDown"
                                 AutomationProperties.Name="ページ番号" ToolTip="ページ番号を入力して Enter" />
                        <TextBlock Text="{Binding PageCount, StringFormat=/ {0:N0}}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        <Button Click="Next_Click" Style="{StaticResource InventoryToolbarButton}" Height="30" Content="次へ" IsEnabled="{Binding CanNext}" />
                        <ComboBox Width="70" Height="30" Margin="8,0,0,0" Name="PageSizeSelector" Style="{StaticResource FilterCombo}"
                                  ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}" AutomationProperties.Name="1ページの表示件数" ToolTip="1ページの表示件数" />
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
