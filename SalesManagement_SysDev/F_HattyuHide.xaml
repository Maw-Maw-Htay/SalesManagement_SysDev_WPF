<Window x:Class="SalesManagement_SysDev.F_HattyuHide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="発注を非表示にする" Width="540" SizeToContent="Height" MinWidth="440" MaxWidth="650" MaxHeight="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="発注を非表示にする" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right" Text="!" Foreground="{StaticResource ThemeWarning}" FontSize="22" FontWeight="Bold" />
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="22,20">
                <TextBlock Text="この発注情報を非表示にしますか？" Foreground="{StaticResource ThemeText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Border Background="{StaticResource ThemeSubtle}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="発注番号" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,3" />
                        <TextBlock Grid.Column="1" Text="{Binding Order.Code}" Foreground="{StaticResource ThemeText}" FontWeight="SemiBold" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="メーカー" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Order.MakerName}" Foreground="{StaticResource ThemeText}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="発注日" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Order.OrderDate, StringFormat={}{0:yyyy/MM/dd}}" Foreground="{StaticResource ThemeText}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Text="発注数量" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Order.OrderedQuantity, StringFormat={}{0:N0}}" Foreground="{StaticResource ThemeText}" Margin="0,3" />
                    </Grid>
                </Border>
                <Border Background="{StaticResource ThemeWarningSurface}" BorderBrush="{StaticResource ThemeWarning}" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,14">
                    <TextBlock Text="発注データは削除されません。管理状態のみ変更します。入庫待ちの発注も入庫管理の参照と履歴を維持します。" Foreground="{StaticResource ThemeText}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="非表示理由 *（必須）" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Height="88" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource ThemeDangerText}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="キャンセル" Click="Cancel_Click" IsCancel="True" MinWidth="110" Height="38" Margin="0,0,8,0" />
                    <Button Content="非表示にする" Click="Confirm_Click" IsDefault="True" IsEnabled="{Binding CanConfirm}"
                            MinWidth="130" Height="38" Background="{StaticResource ThemeDanger}" Foreground="White" BorderBrush="{StaticResource ThemeDanger}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
