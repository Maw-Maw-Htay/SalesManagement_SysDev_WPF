<Window x:Class="SalesManagement_SysDev.F_OrderUpdate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesManagement_SysDev"
        Title="受注更新" Width="1150" Height="760" MinWidth="900" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}">
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding EscapeCommand}" /></Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Registration.xaml" />
                <ResourceDictionary Source="Resources/QuantityInput.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="UpdateQuantity" TargetType="local:QuantityUpDown" BasedOn="{StaticResource HorizontalQuantityUpDown}">
                <Setter Property="Validation.ErrorTemplate">
                    <Setter.Value><ControlTemplate><AdornedElementPlaceholder /></ControlTemplate></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsQuantityChanged}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondary}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayout" Background="{DynamicResource ThemeOrderEntryCanvas}"
          TextElement.Foreground="{DynamicResource ThemeOrderEntryText}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="Header" Height="64" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeOrderEntryBorder}"
                BorderThickness="0,0,0,1" Padding="24,0" MouseLeftButtonDown="HeaderMouseDown">
            <DockPanel>
                <Button x:Name="HeaderCloseButton" DockPanel.Dock="Right" Command="{Binding CloseCommand}"
                        Style="{StaticResource ThemeIconButton}" ToolTip="閉じる" AutomationProperties.Name="閉じる">
                    <local:LucideIcon Data="{StaticResource IconX}" Width="18" Height="18" />
                </Button>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <local:LucideIcon Data="{StaticResource IconClipboardPlus}" Width="21" Height="21"
                                      Stroke="{DynamicResource ThemeOrderEntryNavy}" Margin="0,0,10,0" />
                    <TextBlock Text="受注更新" FontSize="20" FontWeight="{StaticResource TypographyBold}"
                               Foreground="{DynamicResource ThemeOrderEntryNavy}" />
                </StackPanel>
                <TextBlock Text="{Binding SessionHeader}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0" />
            </DockPanel>
        </Border>

        <Grid x:Name="RegistrationPanels" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="21*" /><ColumnDefinition Width="29*" /></Grid.ColumnDefinitions>
            <Border Margin="12,10,6,10">
                <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <Border x:Name="CustomerCard" IsEnabled="{Binding CanEdit}" Style="{StaticResource RegistrationFormCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="受注情報" Style="{StaticResource RegistrationSectionHeading}" Margin="0" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Grid.Column" Value="1" />
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource RegistrationBelowBreakpoint}, ConverterParameter=224}" Value="True">
                                                        <Setter Property="Grid.Row" Value="1" />
                                                        <Setter Property="Grid.Column" Value="0" />
                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                        <Setter Property="Margin" Value="0,4,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Detail.OrderNumber}" ToolTip="{Binding Detail.FooterOrderNumber}" AutomationProperties.Name="受注番号"
                                                   FontSize="12" FontWeight="{StaticResource TypographySemiBold}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource ThemeWarningSurface}" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Detail.BusinessStatus.Text}" Foreground="{DynamicResource ThemeWarningText}" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid Style="{StaticResource RegistrationFieldPair}" Margin="0,0,0,4">
                                    <StackPanel Style="{StaticResource RegistrationPairFirst}">
                                        <TextBlock Text="受注元顧客 *" Style="{StaticResource RegistrationLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Height="40" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="6" Padding="8,0">
                                                <TextBlock Text="{Binding CustomerName}" ToolTip="{Binding CustomerDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           AutomationProperties.Name="受注元顧客" />
                                            </Border>
                                            <Button Grid.Column="1" Content="変更" Command="{Binding ChangeCustomerCommand}" Width="48" Height="40" Padding="6,0" Margin="4,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource RegistrationPairSecond}">
                                        <TextBlock Text="受付営業所" Style="{StaticResource RegistrationLabel}" />
                                        <Border Height="40" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="8,0">
                                            <TextBlock Text="{Binding Detail.OfficeName}" ToolTip="{Binding Detail.OfficeName}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" AutomationProperties.Name="受付営業所（変更不可）" />
                                        </Border>
                                    </StackPanel>
                                </UniformGrid>
                                <local:RegistrationLookup x:Name="CustomerLookup" Visibility="{Binding IsCustomerSelectionVisible, Converter={StaticResource BooleanVisibility}}"
                                    Text="{Binding Entry.CustomerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Entry.Clients}"
                                    SelectCommand="{Binding SelectCustomerCommand}" SuggestionTemplate="{StaticResource RegistrationCustomerSuggestion}"
                                    Placeholder="顧客コード・顧客名" AccessibleName="変更する顧客" Margin="0,0,0,4" />
                                <UniformGrid Style="{StaticResource RegistrationFieldPair}">
                                    <StackPanel Style="{StaticResource RegistrationPairFirst}">
                                        <TextBlock Text="受注日 *" Style="{StaticResource RegistrationLabel}" />
                                        <DatePicker x:Name="OrderDateInput" SelectedDate="{Binding OrderDate, Mode=TwoWay}" DateValidationError="DateValidationError"
                                                    SelectedDateChanged="DateInputChanged" Style="{StaticResource OrderEntryDatePicker}" AutomationProperties.Name="受注日" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource RegistrationPairSecond}">
                                        <TextBlock Text="納品希望日" Style="{StaticResource RegistrationLabel}" />
                                        <DatePicker x:Name="DeliveryDateInput" SelectedDate="{Binding DeliveryDate, Mode=TwoWay}" DateValidationError="DateValidationError"
                                                    SelectedDateChanged="DateInputChanged" Style="{StaticResource OrderEntryDatePicker}" AutomationProperties.Name="納品希望日" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding DateInputError}" Style="{StaticResource RegistrationHint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border IsEnabled="{Binding CanEdit}" Style="{StaticResource RegistrationFormCard}">
                            <StackPanel>
                                <TextBlock Text="商品入力" Style="{StaticResource RegistrationSectionHeading}" Margin="0,0,0,4" />
                                <local:OrderProductInput x:Name="ProductInput" DataContext="{Binding Entry}" />
                                <TextBlock Text="{Binding Entry.Feedback}" Style="{StaticResource RegistrationHint}" />
                                <Button x:Name="AddProductButton" Command="{Binding AddLineCommand}" Style="{StaticResource RegistrationPrimaryAction}"
                                        Height="42" Margin="0,6,0,0" AutomationProperties.Name="商品を追加">
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Data="{StaticResource IconPlus}" Width="16" Height="16" Stroke="White" Margin="0,0,8,0" />
                                        <TextBlock Text="商品を追加" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RemarksCard" Style="{StaticResource RegistrationFormCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="備考" Style="{StaticResource RegistrationSectionHeading}" Margin="0,0,0,4" />
                                <Grid>
                                    <TextBox x:Name="RemarksInput" Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding RemarksMaxLength}"
                                             Style="{StaticResource MultilineInput}" Height="50" AutomationProperties.Name="備考" IsEnabled="{Binding CanEdit}" />
                                    <TextBlock Style="{StaticResource RegistrationRemarksPlaceholder}" />
                                </Grid>
                                <TextBlock Text="{Binding RemarksError}" Style="{StaticResource RegistrationHint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="6,10,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="ItemsCard" Style="{StaticResource RegistrationWorkspaceCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel x:Name="ItemsHeading" Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="12" Padding="9,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QuantitySummary}" FontSize="12" Foreground="{DynamicResource ThemeOrderNavy}"
                                           FontWeight="{StaticResource TypographyMedium}" />
                            </Border>
                            <TextBlock Text="受注明細" Style="{StaticResource RegistrationSectionHeading}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Grid.Row="1" DataContext="{Binding Entry}" Style="{StaticResource RegistrationEmptyState}">
                            <TextBlock Text="商品が追加されていません" TextAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="左側で商品を選択して追加してください。" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="ItemsGrid" Grid.Row="1" ItemsSource="{Binding Lines}" Visibility="{Binding Entry.HasItems, Converter={StaticResource BooleanVisibility}}"
                                  Style="{StaticResource RegistrationItemsGrid}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" EnableRowVirtualization="True"
                                  BorderThickness="0" HorizontalGridLinesBrush="{DynamicResource ThemeOrderEntryBorder}">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="商品コード・商品名" Width="*" MinWidth="108"
                                                        HeaderStyle="{StaticResource RegistrationProductHeader}" CellTemplate="{StaticResource RegistrationDetailProduct}" />
                                <DataGridTextColumn Header="単価" Binding="{Binding UnitPrice, StringFormat='¥{0:N0}'}" Width="96" MinWidth="76"
                                                    ElementStyle="{StaticResource RegistrationUnitPrice}" HeaderStyle="{StaticResource RegistrationDetailHeader}" />
                                <DataGridTemplateColumn Header="数量" Width="114" MinWidth="108" HeaderStyle="{StaticResource RegistrationCenteredDetailHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:QuantityUpDown Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                Maximum="{Binding MaximumQuantity}" PreserveInvalidInput="True" Style="{StaticResource UpdateQuantity}"
                                                Width="102" Height="34" Margin="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                AutomationProperties.Name="{Binding ProductName, StringFormat='{}{0}の数量'}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="小計" Binding="{Binding SubtotalText}" Width="106" MinWidth="84"
                                                    ElementStyle="{StaticResource RegistrationLineTotal}" HeaderStyle="{StaticResource RegistrationDetailHeader}" />
                                <DataGridTemplateColumn Header="操作" Width="52" MinWidth="44" HeaderStyle="{StaticResource RegistrationCenteredDetailHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource ThemeIconButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ToolTip="{Binding RemoveHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding ProductName, StringFormat='{}{0}を削除'}">
                                                <local:LucideIcon Data="{StaticResource IconTrash}" Width="16" Height="16" Stroke="{DynamicResource ThemeDanger}" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Visibility="{Binding HasUndo, Converter={StaticResource BooleanVisibility}}"
                        Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeOrderEntryBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                    <DockPanel>
                        <Button Content="元に戻す" Command="{Binding UndoRemoveLineCommand}" DockPanel.Dock="Right" Padding="8,2" MinHeight="28" />
                        <TextBlock Text="商品を削除しました。" VerticalAlignment="Center" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>
                <ContentControl x:Name="AmountSummary" Grid.Row="2" Focusable="False" IsTabStop="False"
                                Template="{StaticResource RegistrationTotalsTemplate}" Tag="{Binding ActualHeight, ElementName=RegistrationPanels}" />
            </Grid>
        </Grid>

        <Border x:Name="Footer" Grid.Row="2" MinHeight="64" Background="{DynamicResource ThemeSurface}"
                BorderBrush="{DynamicResource ThemeOrderEntryBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entry.IsProductDetailsVisible}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="ReturnToListButton" Content="一覧に戻る" Command="{Binding CloseCommand}" Tag="{StaticResource IconArrowLeft}"
                        Style="{StaticResource RegistrationFooterBack}" />
                <DockPanel Style="{StaticResource OrderEntryFooterFeedback}">
                    <local:LucideIcon DockPanel.Dock="Left" Data="{StaticResource IconInfo}" Width="16" Height="16" Margin="0,0,6,0"
                                      Stroke="{DynamicResource ThemeSecondaryText}" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdateFeedbackText" Text="{Binding Feedback}" ToolTip="{Binding Feedback}" VerticalAlignment="Center"
                               FontSize="12" MaxHeight="40" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeDangerText}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding HasSaved}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeSuccessText}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <StackPanel Style="{StaticResource RegistrationFooterRightActions}">
                    <Button x:Name="SaveButton" Content="変更を保存" Command="{Binding SaveCommand}" Tag="{StaticResource IconSave}"
                            Style="{StaticResource RegistrationFooterSubmit}" />
                </StackPanel>
            </Grid>
        </Border>

        <local:OrderProductDetailsOverlay x:Name="ProductDetailsOverlay" DataContext="{Binding Entry}" Grid.RowSpan="3" Panel.ZIndex="90" />
    </Grid>
</Window>
