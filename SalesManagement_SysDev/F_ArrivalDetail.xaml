<Window x:Class="SalesManagement_SysDev.F_ArrivalDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入荷詳細" Width="940" Height="700" MinWidth="720" MinHeight="520" MaxWidth="1200" MaxHeight="900"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="22,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="入荷詳細" Foreground="White" FontSize="19" FontWeight="Bold" />
                        <TextBlock Text="{Binding Arrival.Code}" Foreground="#D8E5F7" FontSize="14" Margin="12,3,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Background="{Binding ArrivalStateBackground}" CornerRadius="8" Padding="9,4" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ArrivalStateLabel}" Foreground="{Binding ArrivalStateForeground}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <Button Content="×" Click="Close_Click" Width="34" Height="34" Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="21" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,7,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="入荷情報" Grid.ColumnSpan="2" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Text="注文番号" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Arrival.OrderCode}" Foreground="{StaticResource ThemeText}" Margin="0,5" />
                                <TextBlock Grid.Row="2" Text="顧客" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Arrival.CustomerName}" Foreground="{StaticResource ThemeText}" Margin="0,5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="3" Text="営業所" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Arrival.OfficeName}" Foreground="{StaticResource ThemeText}" Margin="0,5" />
                                <TextBlock Grid.Row="4" Text="入荷日" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Arrival.ArrivalDateText}" Foreground="{StaticResource ThemeText}" Margin="0,5" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="7,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="入荷状況" Grid.ColumnSpan="2" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Text="状態" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArrivalStateLabel}" Foreground="{StaticResource ThemeText}" FontWeight="SemiBold" Margin="0,5" />
                                <TextBlock Grid.Row="2" Text="商品行" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LineCountText}" Foreground="{StaticResource ThemeText}" Margin="0,5" />
                                <TextBlock Grid.Row="3" Text="入荷数量" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding QuantityText}" Foreground="{StaticResource ThemeText}" Margin="0,5" />
                                <TextBlock Grid.Row="4" Text="入荷担当者" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,5" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Arrival.EmployeeName}" Foreground="{StaticResource ThemeText}" Margin="0,5" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Background="{StaticResource ThemeSubtle}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="管理状態" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,3" />
                            <TextBlock Grid.Column="1" Text="{Binding ManagementLabel}" Foreground="{StaticResource ThemeText}" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock Grid.Row="1" Text="非表示理由" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,3" Visibility="{Binding HasHiddenReason, Converter={StaticResource BooleanVisibility}}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Arrival.HiddenReason}" Foreground="{StaticResource ThemeText}" Margin="0,3" TextWrapping="Wrap"
                                       Visibility="{Binding HasHiddenReason, Converter={StaticResource BooleanVisibility}}" />
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="入荷明細" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}" />
                        <TextBlock DockPanel.Dock="Right" Text="数量は出庫確定時に作成された入荷明細の値です。" Foreground="{StaticResource ThemeSecondaryText}" FontSize="11" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="38" EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" Width="150" />
                            <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="入荷数量" Binding="{Binding QuantityText}" Width="120" ElementStyle="{StaticResource TableNumber}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="既存データには出庫番号、実受領数量、数量差異、確定日時の専用項目がありません。" Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="20,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <Button Content="非表示にする" Click="Hide_Click" IsEnabled="{Binding CanHide}" Visibility="{Binding CanHide, Converter={StaticResource BooleanVisibility}}"
                            Background="{StaticResource ThemeDanger}" Foreground="White" BorderBrush="{StaticResource ThemeDanger}" />
                    <Button Content="入荷を確定" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" Visibility="{Binding CanConfirm, Converter={StaticResource BooleanVisibility}}"
                            Background="{StaticResource ThemePrimary}" Foreground="White" BorderBrush="{StaticResource ThemePrimary}" Margin="8,0" />
                    <Button Content="閉じる" Click="Close_Click" IsCancel="True" MinWidth="110" Height="38" DockPanel.Dock="Right" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
