<UserControl x:Class="SalesManagement_SysDev.OutboundManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}" SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/OrderManagement.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="OutboundButton" TargetType="Button" BasedOn="{StaticResource OrderToolbarButton}">
                <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="9,0" /><Setter Property="Margin" Value="6,0,0,0" />
            </Style>
            <Style x:Key="OutboundDate" TargetType="DatePicker" BasedOn="{StaticResource FilterDate}">
                <Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="SummaryCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource OrderSurface}" /><Setter Property="BorderBrush" Value="{StaticResource OrderDivider}" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" />
                <Setter Property="Margin" Value="0,0,7,7" /><Setter Property="Padding" Value="9,5" />
            </Style>
            <Style x:Key="OutboundHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
                <Setter Property="Background" Value="{StaticResource OrderSurfaceAlt}" /><Setter Property="Padding" Value="4,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="OutboundCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                <Setter Property="Margin" Value="4,0" /><Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="OutboundCustomer" TargetType="TextBlock" BasedOn="{StaticResource OutboundCell}">
                <Setter Property="ToolTip" Value="{Binding Data.PartnerName}" />
            </Style>
            <Style x:Key="OutboundNumber" TargetType="TextBlock" BasedOn="{StaticResource OutboundCell}">
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
            <Style x:Key="ArrivalBadge" TargetType="Border" BasedOn="{StaticResource OrderStatusBadge}">
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="Background" Value="{StaticResource OrderInput}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource OrderSecondaryText}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Data.ArrivalStatus}" Value="{x:Static local:OutboundArrivalStatus.Pending}">
                        <Setter Property="Background" Value="{StaticResource OrderOrangeSurface}" /><Setter Property="TextElement.Foreground" Value="{StaticResource OrderOrange}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Data.ArrivalStatus}" Value="{x:Static local:OutboundArrivalStatus.Completed}">
                        <Setter Property="Background" Value="{StaticResource OrderGreenSurface}" /><Setter Property="TextElement.Foreground" Value="{StaticResource OrderGreen}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="QuickSearchRow" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource OrderQuickSearchFrame}" Background="{StaticResource OrderInput}" CornerRadius="8" MinHeight="44">
                <Grid>
                    <TextBox x:Name="QuickSearch" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Height="42" Padding="40,4,37,4"
                             BorderThickness="0" Background="Transparent" Style="{StaticResource FilterInput}" AutomationProperties.Name="出庫一覧を検索" />
                    <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0"
                                      Stroke="{StaticResource OrderSecondaryText}" IsHitTestVisible="False" />
                    <TextBlock Text="出庫番号・注文番号・顧客名で検索..." Margin="40,0,37,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource OrderSecondaryText}" FontSize="13" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Button Click="ClearQuickSearch_Click" HorizontalAlignment="Right" Width="34" Height="34" Margin="0,0,2,0" Padding="0"
                            Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="キーワードを消去">
                        <local:LucideIcon Data="{StaticResource IconX}" Width="15" Height="15" />
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ToggleFilters_Click" Style="{StaticResource OutboundButton}" ToolTip="{Binding FiltersToggleLabel}">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="16" Height="16" Stroke="{StaticResource OrderText}" Margin="0,0,7,0" />
                        <TextBlock Text="詳細条件" />
                        <local:LucideIcon Width="12" Height="12" Margin="5,0,0,0">
                            <local:LucideIcon.Style><Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True"><Setter Property="Data" Value="{StaticResource IconChevronUp}" /></DataTrigger></Style.Triggers>
                            </Style></local:LucideIcon.Style>
                        </local:LucideIcon>
                    </StackPanel>
                </Button>
                <Button Content="再読込" Click="Reload_Click" Style="{StaticResource OutboundButton}" IsEnabled="{Binding CanReload}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1"
                CornerRadius="8" Padding="8" Margin="0,0,0,8" Visibility="{Binding IsFiltersExpanded, Converter={StaticResource OrderBooleanVisibility}}">
            <DockPanel>
                <Button Content="条件クリア" Click="ClearConditions_Click" Style="{StaticResource OutboundButton}" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Height="28" IsEnabled="{Binding HasConditions}" />
                <ScrollViewer x:Name="FilterScroll" MaxHeight="205" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid x:Name="FilterFields" Columns="4">
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="出庫番号" Style="{StaticResource OrderFilterLabel}" />
                            <TextBox Text="{Binding OutboundCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="36" AutomationProperties.Name="出庫番号" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="注文番号" Style="{StaticResource OrderFilterLabel}" />
                            <TextBox Text="{Binding RelatedCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="36" AutomationProperties.Name="注文番号" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="顧客名" Style="{StaticResource OrderFilterLabel}" />
                            <TextBox Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="36" AutomationProperties.Name="顧客名" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="担当営業所" Style="{StaticResource OrderFilterLabel}" />
                            <ComboBox ItemsSource="{Binding PrimaryOptions}" SelectedValue="{Binding PrimarySelection}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilterCombo}" Height="36" AutomationProperties.Name="担当営業所" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="出庫日（開始）" Style="{StaticResource OrderFilterLabel}" />
                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutboundDate}" DateValidationError="Date_Invalid" SelectedDateChanged="Date_Changed" PreviewTextInput="Date_Editing" AutomationProperties.Name="出庫日（開始）" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="出庫日（終了）" Style="{StaticResource OrderFilterLabel}" />
                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource OutboundDate}" DateValidationError="Date_Invalid" SelectedDateChanged="Date_Changed" PreviewTextInput="Date_Editing" AutomationProperties.Name="出庫日（終了）" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="出庫状態" Style="{StaticResource OrderFilterLabel}" />
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Value" DisplayMemberPath="Name" Style="{StaticResource FilterCombo}" Height="36" AutomationProperties.Name="出庫状態" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="入荷状況" Style="{StaticResource OrderFilterLabel}" />
                            <ComboBox ItemsSource="{Binding ArrivalOptions}" SelectedValue="{Binding ArrivalSelection}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilterCombo}" Height="36" AutomationProperties.Name="入荷状況" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="商品コード・商品名" Style="{StaticResource OrderFilterLabel}" />
                            <TextBox Text="{Binding Product, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="36" AutomationProperties.Name="商品コード・商品名" />
                        </StackPanel>
                        <StackPanel Margin="4,0,4,6">
                            <TextBlock Text="出庫担当者" Style="{StaticResource OrderFilterLabel}" />
                            <ComboBox ItemsSource="{Binding EmployeeOptions}" SelectedValue="{Binding EmployeeSelection}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilterCombo}" Height="36" AutomationProperties.Name="出庫担当者" />
                        </StackPanel>
                    </UniformGrid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <UniformGrid x:Name="SummaryCards" Grid.Row="2" Columns="4" Margin="0,0,-7,0">
            <UniformGrid.Style><Style TargetType="UniformGrid"><Style.Triggers>
                <DataTrigger Binding="{Binding ShowingOutboundHistory}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></UniformGrid.Style>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconOutbound}" Width="16" Height="16" Stroke="{StaticResource OrderHeader}" Margin="0,0,7,0" />
                    <StackPanel>
                        <TextBlock Text="出庫件数" FontSize="12" Foreground="{StaticResource OrderHeader}" />
                        <TextBlock Text="{Binding VisibleCount, StringFormat={}{0:N0} 件}" Foreground="{StaticResource OrderHeader}" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconPending}" Width="16" Height="16" Stroke="{StaticResource OrderOrange}" Margin="0,0,7,0" />
                    <StackPanel>
                        <TextBlock Text="未確定" FontSize="12" Foreground="{StaticResource OrderHeader}" />
                        <TextBlock Text="{Binding PendingCount, StringFormat={}{0:N0} 件}" Foreground="{StaticResource OrderOrange}" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconCheckCircle}" Width="16" Height="16" Stroke="{StaticResource OrderGreen}" Margin="0,0,7,0" />
                    <StackPanel>
                        <TextBlock Text="確定済み" FontSize="12" Foreground="{StaticResource OrderHeader}" />
                        <TextBlock Text="{Binding ConfirmedCount, StringFormat={}{0:N0} 件}" Foreground="{StaticResource OrderGreen}" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryCard}">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconArrival}" Width="16" Height="16" Stroke="{StaticResource OrderHeader}" Margin="0,0,7,0" />
                    <StackPanel>
                        <TextBlock Text="入荷未完了" FontSize="12" Foreground="{StaticResource OrderHeader}" />
                        <TextBlock Text="{Binding ArrivalPendingCount, StringFormat={}{0:N0} 件}" Foreground="{StaticResource OrderHeader}" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid x:Name="StatusRow" Grid.Row="3" Margin="0,0,0,7" SizeChanged="StatusRow_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Menu x:Name="StatusTabs" Background="Transparent" Padding="0" IsMainMenu="False" AutomationProperties.Name="出庫状態">
                <Menu.Style><Style TargetType="Menu"><Style.Triggers>
                    <DataTrigger Binding="{Binding ShowingOutboundHistory}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></Menu.Style>
                <Menu.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Menu.ItemsPanel>
                <MenuItem x:Name="AllTab" Click="AllTab_Click" Style="{StaticResource StatusMenuItem}" >
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconOutbound}" Width="15" Height="15" Tag="{StaticResource OrderHeader}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="すべて" Tag="{StaticResource OrderHeader}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="5" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VisibleCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderHeader}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="PendingTab" Click="PendingTab_Click" Style="{StaticResource StatusMenuItem}" >
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconPending}" Width="15" Height="15" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="未確定" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="5" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="ConfirmedTab" Click="ConfirmedTab_Click" Style="{StaticResource StatusMenuItem}" >
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconCheckCircle}" Width="15" Height="15" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="確定済み" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="5" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConfirmedCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem x:Name="HiddenTab" Click="HiddenTab_Click" Style="{StaticResource StatusMenuItem}" Visibility="{Binding CanViewHidden, Converter={StaticResource OrderBooleanVisibility}}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconHidden}" Width="15" Height="15" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="非表示" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" VerticalAlignment="Center" />
                            <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="5" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HiddenCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
            <TextBlock Text="操作履歴は未記録です。" Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center"
                       Visibility="{Binding ShowingOutboundHistory, Converter={StaticResource OrderBooleanVisibility}}" />
            <Button x:Name="HistoryButton" Grid.Column="1" Click="History_Click" Height="34" HorizontalAlignment="Right">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OutboundButton}">
                    <Setter Property="Content" Value="出庫履歴" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowingOutboundHistory}" Value="True"><Setter Property="Content" Value="出庫一覧に戻る" /></DataTrigger>
                    </Style.Triggers>
                </Style></Button.Style>
            </Button>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,6">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ListTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Feedback}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource OrderSecondaryText}" />
                </DockPanel>
                <DataGrid x:Name="MovementsGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          FrozenColumnCount="1" RowHeight="36" ColumnHeaderHeight="34" ColumnHeaderStyle="{StaticResource OutboundHeader}"
                          CellStyle="{StaticResource OrderListCell}" RowStyle="{StaticResource OrderGridRow}" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource OrderDivider}"
                          RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}" AlternationCount="2"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="MovementsGrid_MouseDoubleClick" Sorting="Grid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="選択" Width="35" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Code, StringFormat={}{0} を選択}" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="出庫番号" Binding="{Binding Code}" Width="86" SortMemberPath="Id" ElementStyle="{StaticResource OutboundCell}" />
                        <DataGridTextColumn Header="注文番号" Binding="{Binding Data.RelatedOrderCode}" Width="80" SortMemberPath="RelatedOrderId" ElementStyle="{StaticResource OutboundCell}" />
                        <DataGridTextColumn Header="顧客名" Binding="{Binding Data.PartnerName}" Width="1.55*" MinWidth="54" SortMemberPath="PartnerName" ElementStyle="{StaticResource OutboundCustomer}" />
                        <DataGridTextColumn Header="出庫日" Binding="{Binding MovementDateText}" Width="80" SortMemberPath="MovementDate" ElementStyle="{StaticResource OutboundCell}" />
                        <DataGridTextColumn x:Name="HistoryEmployeeColumn" Header="出庫担当者" Binding="{Binding Data.EmployeeName}"
                                            Width="100" SortMemberPath="EmployeeName" Visibility="Collapsed" ElementStyle="{StaticResource OutboundCell}" />
                        <DataGridTextColumn Header="担当営業所" Binding="{Binding Data.OfficeName}" Width="*" MinWidth="67" SortMemberPath="OfficeName" ElementStyle="{StaticResource OutboundCell}" />
                        <DataGridTextColumn Header="明細数" Binding="{Binding Data.LineCount, StringFormat={}{0:N0}}" Width="49" SortMemberPath="LineCount" ElementStyle="{StaticResource OutboundNumber}" />
                        <DataGridTextColumn Header="出庫数量" Binding="{Binding QuantityText}" Width="60" SortMemberPath="Quantity" ElementStyle="{StaticResource OutboundNumber}" />
                        <DataGridTemplateColumn Header="出庫状態" Width="67" SortMemberPath="BusinessState">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Background="{Binding BusinessStatusBackground}" CornerRadius="8" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BusinessStatusLabel}" Foreground="{Binding BusinessStatusForeground}" FontSize="12" />
                                </Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="入荷状況" Width="76" SortMemberPath="ArrivalStatus">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Style="{StaticResource ArrivalBadge}"><TextBlock Text="{Binding Data.ArrivalStatusLabel}" FontSize="12" /></Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="詳細" Width="48" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="詳細" Click="Detail_Click" Tag="{Binding}" Style="{StaticResource OutboundButton}" Height="26" Padding="5,0" Margin="0" HorizontalAlignment="Center" />
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Padding="16,9" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource OrderSurface}"
                        IsHitTestVisible="False" Visibility="{Binding ShowEmptyState, Converter={StaticResource OrderBooleanVisibility}}">
                    <TextBlock Text="{Binding EmptyDescription}" Foreground="{StaticResource OrderSecondaryText}" TextWrapping="Wrap" />
                </Border>
                <DockPanel Grid.Row="2" Margin="1,6,1,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PageText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="前へ" Click="Previous_Click" Style="{StaticResource OutboundButton}" IsEnabled="{Binding CanPrevious}" Height="30" />
                        <TextBox x:Name="PageNumber" Text="{Binding Page, Mode=OneWay}" KeyDown="PageNumber_KeyDown" Width="42" Height="30" Padding="3,0"
                                 Margin="6,0,0,0" Style="{StaticResource FilterInput}" TextAlignment="Center" AutomationProperties.Name="ページ番号" />
                        <TextBlock Text="{Binding PageCount, StringFormat=/ {0:N0}}" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0" />
                        <Button Content="次へ" Click="Next_Click" Style="{StaticResource OutboundButton}" IsEnabled="{Binding CanNext}" Height="30" />
                        <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource FilterCombo}" Height="30" Width="65" Margin="6,0,0,0"
                                  AutomationProperties.Name="1ページの表示件数" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
