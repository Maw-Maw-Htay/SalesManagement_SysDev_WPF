<UserControl x:Class="SalesManagement_SysDev.F_OrderRegistration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesManagement_SysDev"
        Style="{StaticResource {x:Type UserControl}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Registration.xaml" />
                <ResourceDictionary Source="Resources/QuantityInput.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <GeometryGroup x:Key="RegistrationClipboardCheck">
                <RectangleGeometry Rect="9,2,6,4" RadiusX="1" RadiusY="1" />
                <PathGeometry Figures="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3 M9 13l2 2 4-4" />
            </GeometryGroup>
            <Style x:Key="RegistrationCompletionAction" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
                <Setter Property="Height" Value="36" /><Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,6" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.85" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.7" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="{StaticResource ThemeAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <DataTemplate x:Key="RegistrationOfficeSuggestion">
                <StackPanel Margin="4">
                    <TextBlock Text="{Binding SoName}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SoId, StringFormat='営業所ID: {0}'}" Foreground="{StaticResource ThemeSecondaryText}" FontSize="12" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding EscapeCommand}" /></UserControl.InputBindings>
    <Border Background="{DynamicResource ThemeOrderEntryCanvas}" TextElement.Foreground="{DynamicResource ThemeOrderEntryText}"
            KeyboardNavigation.TabNavigation="Cycle">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="RegistrationPanels" Grid.Row="0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsProductDetailsVisible}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsCompletionDialogVisible}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="21*" /><ColumnDefinition Width="29*" /></Grid.ColumnDefinitions>
                <Border Margin="12,10,6,10">
                    <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <Border Style="{StaticResource RegistrationFormCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ThemeWarningSurface}" Padding="8,2" CornerRadius="4"
                                                Visibility="{Binding IsDraft, Converter={StaticResource BooleanVisibility}}">
                                            <TextBlock Text="下書き" Foreground="{StaticResource ThemeWarningText}" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="受注情報" Style="{StaticResource RegistrationSectionHeading}" Margin="0" />
                                    </DockPanel>
                                    <UniformGrid Style="{StaticResource RegistrationFieldPair}" Margin="0,0,0,4">
                                        <StackPanel Style="{StaticResource RegistrationPairFirst}">
                                            <TextBlock Text="受注元顧客 *" Style="{StaticResource RegistrationLabel}" />
                                            <local:RegistrationLookup x:Name="CustomerLookup" Text="{Binding CustomerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding Clients}" SelectCommand="{Binding SelectClientCommand}" SuggestionTemplate="{StaticResource RegistrationCustomerSuggestion}"
                                                Placeholder="顧客コード・顧客名" AccessibleName="受注元顧客" Invalid="{Binding CustomerInputInvalid}" IsEnabled="{Binding IsEditing}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource RegistrationPairSecond}">
                                            <TextBlock Text="受付営業所 *" Style="{StaticResource RegistrationLabel}" />
                                            <local:RegistrationLookup x:Name="OfficeLookup" Text="{Binding OfficeSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding Offices}" SelectCommand="{Binding SelectOfficeCommand}" SuggestionTemplate="{StaticResource RegistrationOfficeSuggestion}"
                                                Placeholder="営業所を検索" AccessibleName="受付営業所" Invalid="{Binding OfficeInputInvalid}" IsEnabled="{Binding IsEditing}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Style="{StaticResource RegistrationFieldPair}">
                                        <StackPanel Style="{StaticResource RegistrationPairFirst}">
                                            <TextBlock Text="受注日 *" Style="{StaticResource RegistrationLabel}" />
                                            <DatePicker x:Name="OrderDateInput" SelectedDate="{Binding OrderDate, Mode=TwoWay}"
                                                        Style="{StaticResource OrderEntryDatePicker}"
                                                        DateValidationError="DateValidationError" SelectedDateChanged="DateInputChanged" AutomationProperties.Name="受注日" IsEnabled="{Binding IsEditing}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource RegistrationPairSecond}">
                                            <TextBlock Text="納品希望日 *" Style="{StaticResource RegistrationLabel}" />
                                            <DatePicker x:Name="DeliveryDateInput" SelectedDate="{Binding DeliveryDate, Mode=TwoWay}"
                                                        Style="{StaticResource OrderEntryDatePicker}"
                                                        DateValidationError="DateValidationError" SelectedDateChanged="DateInputChanged" AutomationProperties.Name="納品希望日" IsEnabled="{Binding IsEditing}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding DateInputError}" Style="{StaticResource RegistrationHint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource RegistrationFormCard}">
                                <StackPanel>
                                    <TextBlock Text="商品入力" Style="{StaticResource RegistrationSectionHeading}" Margin="0,0,0,4" />
                                    <local:OrderProductInput x:Name="ProductInput" />
                                    <Button Command="{Binding AddLineCommand}" Style="{StaticResource RegistrationPrimaryAction}"
                                            Height="42" Margin="0,6,0,0" AutomationProperties.Name="商品を追加" IsEnabled="{Binding IsEditing}">
                                        <StackPanel Orientation="Horizontal">
                                            <local:LucideIcon Data="{StaticResource IconPlus}" Width="16" Height="16" Stroke="White" Margin="0,0,8,0" />
                                            <TextBlock Text="商品を追加" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource RegistrationFormCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="備考" Style="{StaticResource RegistrationSectionHeading}" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="RemarksInput" Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                                                  Style="{StaticResource MultilineInput}" Height="50" AutomationProperties.Name="備考" IsEnabled="{Binding IsEditing}" />
                                        <TextBlock Style="{StaticResource RegistrationRemarksPlaceholder}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                 <Grid x:Name="OrderReviewPanel" Grid.Column="1" Margin="6,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                         <Border Style="{StaticResource RegistrationWorkspaceCard}">
                            <Grid>
                                 <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                     <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="12" Padding="9,3" VerticalAlignment="Center">
                                         <TextBlock Text="{Binding QuantitySummary}" FontSize="12" Foreground="{DynamicResource ThemeOrderNavy}"
                                                    FontWeight="{StaticResource TypographyMedium}" />
                                     </Border>
                                     <TextBlock Text="受注明細" Style="{StaticResource RegistrationSectionHeading}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel Grid.Row="1" Style="{StaticResource RegistrationEmptyState}">
                                    <local:LucideIcon Data="{StaticResource IconOrder}" Width="24" Height="24" Margin="0,0,0,10">
                                        <local:LucideIcon.Style><Style TargetType="local:LucideIcon"><Style.Triggers><DataTrigger Binding="{Binding ActualHeight, ElementName=RegistrationPanels, Converter={StaticResource RegistrationBelowBreakpoint}, ConverterParameter=400}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></local:LucideIcon.Style>
                                    </local:LucideIcon>
                                    <TextBlock Text="商品が追加されていません" TextAlignment="Center" FontWeight="SemiBold" />
                                     <TextBlock Text="左側で商品を選択して追加してください。" TextAlignment="Center" TextWrapping="Wrap"
                                                Foreground="{StaticResource ThemeSecondaryText}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                                <DataGrid x:Name="OrderItemsGrid" Grid.Row="1" ItemsSource="{Binding Lines}" Visibility="{Binding HasItems, Converter={StaticResource BooleanVisibility}}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                          CanUserResizeColumns="False" CanUserReorderColumns="False" SelectionMode="Single"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                           ScrollViewer.CanContentScroll="True" EnableRowVirtualization="True"
                                           BorderThickness="0" HorizontalGridLinesBrush="{DynamicResource ThemeOrderEntryBorder}"
                                           Style="{StaticResource RegistrationItemsGrid}">
                                    <DataGrid.Columns>
                                         <DataGridTemplateColumn Header="商品コード・商品名" Width="*" MinWidth="108"
                                                                 HeaderStyle="{StaticResource RegistrationProductHeader}"
                                                                 CellTemplate="{StaticResource RegistrationDetailProduct}" />
                                         <DataGridTextColumn Header="単価" Binding="{Binding UnitPrice, StringFormat='¥{0:N0}'}" Width="96" MinWidth="76"
                                                             ElementStyle="{StaticResource RegistrationUnitPrice}" HeaderStyle="{StaticResource RegistrationDetailHeader}" />
                                         <DataGridTemplateColumn Header="数量" Width="114" MinWidth="108" HeaderStyle="{StaticResource RegistrationCenteredDetailHeader}">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <local:QuantityUpDown Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Maximum="{Binding MaximumQuantity}"
                                                     Width="102" Height="34" Margin="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Style="{StaticResource HorizontalQuantityUpDown}" PreserveInvalidInput="True"
                                                    AutomationProperties.Name="{Binding ProductName, StringFormat='{}{0}の数量'}"
                                                     ToolTip="{Binding UnitName, StringFormat='単位：{0}'}"
                                                    IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                         <DataGridTextColumn Header="小計" Binding="{Binding Amount, StringFormat='¥{0:N0}'}" Width="106" MinWidth="84"
                                                             ElementStyle="{StaticResource RegistrationLineTotal}" HeaderStyle="{StaticResource RegistrationDetailHeader}" />
                                         <DataGridTemplateColumn Header="操作" Width="52" MinWidth="44" HeaderStyle="{StaticResource RegistrationCenteredDetailHeader}">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                 <Button Style="{StaticResource ThemeIconButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" ToolTip="この商品行を削除" AutomationProperties.Name="{Binding ProductName, StringFormat='{}{0}を削除'}">
                                                    <local:LucideIcon Data="{StaticResource IconTrash}" Width="16" Height="16" Stroke="{StaticResource ThemeDanger}" />
                                                </Button>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                         <Border Grid.Row="1" Visibility="{Binding HasUndo, Converter={StaticResource BooleanVisibility}}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeOrderEntryBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                            <DockPanel><Button Content="元に戻す" Command="{Binding UndoRemoveLineCommand}" DockPanel.Dock="Right" Padding="8,2" MinHeight="28" />
                                <TextBlock Text="商品を削除しました。" VerticalAlignment="Center" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </Border>
                        <ContentControl x:Name="OrderTotalsCard" Grid.Row="2" Focusable="False" IsTabStop="False"
                                        Template="{StaticResource RegistrationTotalsTemplate}" Tag="{Binding ActualHeight, ElementName=RegistrationPanels}" />
                </Grid>
            </Grid>

            <Border x:Name="RegistrationFooter" Grid.Row="1" MinHeight="64" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeOrderEntryBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsProductDetailsVisible}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding IsCompletionDialogVisible}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="ReturnToListButton" Content="一覧に戻る" Tag="{StaticResource IconArrowLeft}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RegistrationFooterBack}">
                                <Setter Property="Command" Value="{Binding CloseCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Command" Value="{Binding ReturnToListCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <DockPanel Style="{StaticResource RegistrationFooterFeedback}">
                        <local:LucideIcon DockPanel.Dock="Left" Data="{StaticResource IconInfo}" Width="16" Height="16"
                                          Stroke="{DynamicResource ThemeSecondaryText}" Margin="0,0,6,0">
                            <local:LucideIcon.Style>
                                <Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Feedback}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:LucideIcon.Style>
                        </local:LucideIcon>
                        <TextBlock x:Name="RegistrationFeedbackText" VerticalAlignment="Center" MaxHeight="40"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12"
                                   AutomationProperties.LiveSetting="Polite" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Feedback}" /><Setter Property="Foreground" Value="{StaticResource ThemeDangerText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Feedback}" Value=""><Setter Property="Text" Value="{Binding ValidationSummary}" /><Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter Property="Foreground" Value="{StaticResource ThemeSuccessText}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsDraftSaveFeedback}" Value="True"><Setter Property="Foreground" Value="{StaticResource ThemeSuccessText}" /></DataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <StackPanel Style="{StaticResource RegistrationFooterRightActions}">
                        <Button x:Name="SaveDraftButton" Content="下書き保存" Command="{Binding SaveDraftCommand}"
                                Tag="{StaticResource IconSave}" Style="{StaticResource RegistrationFooterSave}" />
                        <Button x:Name="RegisterButton" Content="{Binding RegisterButtonText}" Command="{Binding RegisterCommand}"
                                Tag="{StaticResource IconCheck}" Style="{StaticResource RegistrationFooterSubmit}"
                                IsEnabled="{Binding IsEditing}" />
                    </StackPanel>
                </Grid>
            </Border>

            <local:OrderProductDetailsOverlay x:Name="ProductDetailsOverlay" Grid.RowSpan="2" Panel.ZIndex="90" />
            <Grid x:Name="RegistrationCompletionOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#66061A3D"
                  Visibility="{Binding IsCompletionDialogVisible, Converter={StaticResource BooleanVisibility}}"
                  IsHitTestVisible="{Binding IsCompletionDialogVisible}" KeyboardNavigation.TabNavigation="Cycle">
                <Border x:Name="RegistrationCompletionDialog" Width="520" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
                    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.18" /></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource ThemePrimary}" Padding="16,0" CornerRadius="7,7,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <local:LucideIcon Data="{StaticResource RegistrationClipboardCheck}" Width="24" Height="24" Stroke="White" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="受注登録完了" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="DismissCompletionButton" Grid.Column="2" Command="{Binding DismissCompletionCommand}"
                                        Style="{StaticResource RegistrationCompletionAction}" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Background="Transparent"
                                        BorderBrush="Transparent" ToolTip="閉じて次の受注を入力" AutomationProperties.Name="完了ダイアログを閉じる">
                                    <local:LucideIcon Data="{StaticResource IconX}" Width="16" Height="16" Stroke="White" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource ThemeSurface}" Padding="16,8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <local:LucideIcon x:Name="RegistrationSuccessIcon" Data="{StaticResource IconCheckCircle}" Width="40" Height="40"
                                                  Stroke="{StaticResource ThemeSuccess}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding CompletionMessage}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ThemePrimary}"
                                           TextAlignment="Center" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="受注番号" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}" TextAlignment="Center" Margin="0,0,0,2" />
                                <TextBlock x:Name="CompletionOrderNumberText" Text="{Binding RegisteredOrderNumber}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource ThemePrimary}" TextAlignment="Center" />
                                <TextBlock Text="{Binding CompletionError}" FontSize="10" Foreground="{StaticResource ThemeDangerText}" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxHeight="20" Margin="0,3,0,0" ToolTip="{Binding CompletionError}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}"
                                BorderThickness="0,1,0,0" Margin="12,0" Padding="0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="ContinueOrderRegistrationButton" Command="{Binding DismissCompletionCommand}"
                                        Style="{StaticResource RegistrationCompletionAction}" Width="168" Margin="0,0,8,0"
                                        Background="{StaticResource ThemePrimary}" BorderBrush="{StaticResource ThemePrimary}" Foreground="White"
                                        AutomationProperties.Name="続けて受注登録">
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Data="{StaticResource IconClipboardPlus}" Width="18" Height="18" Stroke="White" Margin="0,0,8,0" />
                                        <TextBlock Text="続けて受注登録" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShowRegisteredOrderButton" Grid.Column="1" Command="{Binding ShowRegisteredOrderCommand}"
                                        Style="{StaticResource RegistrationCompletionAction}" Width="152" Margin="0,0,8,0"
                                        Foreground="{StaticResource ThemePrimary}" BorderBrush="{StaticResource ThemeSecondaryText}"
                                        AutomationProperties.Name="受注明細を表示">
                                    <StackPanel Orientation="Horizontal">
                                        <local:LucideIcon Data="{StaticResource IconOrder}" Width="18" Height="18" Stroke="{StaticResource ThemePrimary}" Margin="0,0,8,0" />
                                        <TextBlock Text="受注明細を表示" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CompletionReturnToListButton" Grid.Column="2" Command="{Binding ReturnToListCommand}"
                                        Style="{StaticResource RegistrationCompletionAction}" Width="112" HorizontalAlignment="Right" Padding="4,6"
                                        Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource ThemeAccent}"
                                        AutomationProperties.Name="一覧に戻る">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="一覧に戻る" VerticalAlignment="Center" />
                                        <local:LucideIcon Data="{StaticResource IconArrowRight}" Width="16" Height="16" Stroke="{StaticResource ThemeAccent}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
