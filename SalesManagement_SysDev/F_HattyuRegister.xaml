<Window x:Class="SalesManagement_SysDev.F_HattyuRegister"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="発注登録" Width="1000" Height="680" WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/OrderManagement.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="PurchaseEntryLabel" TargetType="TextBlock" BasedOn="{StaticResource OrderFilterLabel}">
                <Setter Property="Margin" Value="0,9,0,4" />
            </Style>
            <Style x:Key="PurchasePanelTitle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource OrderHeader}" />
                <Setter Property="CornerRadius" Value="6,6,0,0" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="TextElement.Foreground" Value="White" />
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource ThemeCanvas}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="62" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <Button DockPanel.Dock="Right" Content="×" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Width="34" Height="34" Padding="0" FontSize="20" ToolTip="閉じる" />
                    <TextBlock Text="発注登録" Foreground="{StaticResource OrderHeader}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="14" IsEnabled="{Binding CanCancel}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PurchasePanelTitle}"><TextBlock Text="発注情報" /></Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12,2,12,12">
                                <TextBlock Text="仕入先 *" Style="{StaticResource PurchaseEntryLabel}" />
                                <ComboBox ItemsSource="{Binding Makers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMaker}"
                                          TextSearch.TextPath="Name" IsTextSearchEnabled="True" Style="{StaticResource FilterCombo}" AutomationProperties.Name="仕入先" />
                                <TextBlock Text="発注日 *" Style="{StaticResource PurchaseEntryLabel}" />
                                <DatePicker SelectedDate="{Binding OrderDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterDate}"
                                            DateValidationError="Date_Invalid" SelectedDateChanged="Date_Changed" PreviewTextInput="Date_Editing" AutomationProperties.Name="発注日" />
                                <TextBlock Text="発注担当者" Style="{StaticResource PurchaseEntryLabel}" />
                                <TextBlock Text="{Binding EmployeeName}" />
                                <TextBlock Text="担当者の現在の営業所" Style="{StaticResource PurchaseEntryLabel}" />
                                <TextBlock Text="{Binding OfficeName}" />
                                <Separator Margin="0,11,0,2" />
                                <TextBlock Text="商品" Style="{StaticResource PurchaseEntryLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="商品詳細" Click="Product_Click" IsEnabled="{Binding HasInventoryReference}"
                                            Style="{StaticResource OrderToolbarButton}" Padding="7,0" Margin="6,0,0,0" />
                                    <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}" IsEditable="True"
                                              IsTextSearchEnabled="True" TextSearch.TextPath="Name" DisplayMemberPath="SearchLabel"
                                              Style="{StaticResource FilterCombo}" AutomationProperties.Name="商品を検索・選択" />
                                </DockPanel>
                                <TextBlock Text="発注数量 *" Style="{StaticResource PurchaseEntryLabel}" />
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                             InputScope="Number" PreviewTextInput="Quantity_PreviewTextInput" AutomationProperties.Name="発注数量" />
                                    <UniformGrid Grid.Column="1" Rows="2" Margin="2,0,0,0">
                                        <Button Content="＋" Click="QuantityUp_Click" Height="19" Padding="0" AutomationProperties.Name="数量を増やす" />
                                        <Button Content="−" Click="QuantityDown_Click" Height="19" Padding="0" AutomationProperties.Name="数量を減らす" />
                                    </UniformGrid>
                                </Grid>
                                <TextBlock Text="{Binding InventoryReferenceText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource OrderSecondaryText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding InventoryWarning}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource OrderOrange}" Margin="0,4,0,0" />
                                <Button Content="＋ 明細に追加" Command="{Binding AddLineCommand}" Style="{StaticResource OrderToolbarButton}"
                                        Height="34" HorizontalAlignment="Right" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PurchasePanelTitle}"><TextBlock Text="発注明細" /></Border>
                        <StackPanel DockPanel.Dock="Bottom" Margin="10,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="削除を元に戻す" Command="{Binding UndoRemoveCommand}" Height="30" Style="{StaticResource OrderToolbarButton}" />
                                <TextBlock TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <Run Text="{Binding TotalLineCount, Mode=OneWay}" /><Run Text=" 行　合計数量 " /><Run Text="{Binding TotalQuantity, Mode=OneWay, StringFormat={}{0:N0}}" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding AmountNote}" Foreground="{StaticResource OrderSecondaryText}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="34"
                                  CanUserAddRows="False" CanUserDeleteRows="False" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ColumnHeaderStyle="{StaticResource OrderColumnHeader}" CellStyle="{StaticResource OrderListCell}" RowStyle="{StaticResource OrderGridRow}"
                                  AlternationCount="2" RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="商品コード" Binding="{Binding Code}" Width="105" ElementStyle="{StaticResource TableText}" />
                                <DataGridTextColumn Header="商品名" Binding="{Binding Name}" Width="*" MinWidth="84" ElementStyle="{StaticResource TableText}" />
                                <DataGridTemplateColumn Header="数量" Width="66"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="28" Padding="3,0"
                                             TextAlignment="Right" Margin="3,0" InputScope="Number" PreviewTextInput="Quantity_PreviewTextInput" AutomationProperties.Name="明細の発注数量" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="削除" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Style="{StaticResource OrderToolbarButton}" Height="27" Padding="6,0" HorizontalAlignment="Center" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="14,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="キャンセル" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Style="{StaticResource OrderToolbarButton}" Height="36" Margin="0,0,7,0" />
                        <Button x:Name="RegisterButton" Content="発注を登録" Click="Register_Click" IsEnabled="{Binding CanRegister}" Style="{StaticResource OrderRegisterButton}" Height="36" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ValidationMessage}" FontSize="12" Foreground="{StaticResource OrderSecondaryText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Feedback}" FontSize="12" Foreground="{StaticResource OrderDanger}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
