<Window x:Class="SalesManagement_SysDev.F_Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SalesManagement_SysDev"
        Title="販売管理システム" Width="1100" Height="760" MinWidth="760" MinHeight="540" Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource TypographyFontFamily}" Background="{StaticResource ThemeCanvas}" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}">
    <Window.Resources>
        <SolidColorBrush x:Key="RegistrationSidebarActive" Color="#2563EB" />
        <Style x:Key="OrderHeaderRegisterButton" TargetType="Button" BasedOn="{StaticResource ThemeButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="{StaticResource ThemePrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeSurface}" />
            <Setter Property="FontSize" Value="{StaticResource TypographyButtonSize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
        </Style>
        <local:IconResourceConverter x:Key="SidebarIconResource" />
        <PathGeometry x:Key="SidebarChevronLeft" Figures="m15 18-6-6 6-6" />
        <PathGeometry x:Key="SidebarChevronRight" Figures="m9 18 6-6-6-6" />
        <Style x:Key="SidebarExpandedContent" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ThemeSidebarForeground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeIconSidebar}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="サイドバーを折りたたむ" />
            <Setter Property="AutomationProperties.Name" Value="サイドバーを折りたたむ" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Border Margin="-2" CornerRadius="10" BorderBrush="{StaticResource ThemeIconSidebar}" BorderThickness="1" Opacity="0.75" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="toggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <local:LucideIcon x:Name="toggleIcon" Data="{StaticResource SidebarChevronLeft}" Width="18" Height="18" Stroke="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleBorder" Property="Background" Value="{StaticResource ThemeSidebarActive}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <Setter TargetName="toggleIcon" Property="Data" Value="{StaticResource SidebarChevronRight}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="ToolTip" Value="サイドバーを展開する" />
                    <Setter Property="AutomationProperties.Name" Value="サイドバーを展開する" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarLabel" TargetType="TextBlock" BasedOn="{StaticResource SidebarExpandedContent}">
            <Setter Property="FontSize" Value="{StaticResource TypographySidebarMenuSize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeSidebarForeground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="SidebarCategoryLabel" TargetType="TextBlock" BasedOn="{StaticResource SidebarExpandedContent}">
            <Setter Property="FontSize" Value="{StaticResource TypographySidebarCategorySize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeSidebarForeground}" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,8,0" />
        </Style>
        <Style x:Key="SidebarIcon" TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
            <Setter Property="Stroke" Value="{StaticResource ThemeIconSidebar}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Active">
                    <Setter Property="Stroke" Value="{StaticResource ThemeIconActive}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Value="受注登録">
                    <Setter Property="Stroke" Value="{StaticResource ThemeSidebarForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Value="受注更新">
                    <Setter Property="Stroke" Value="{StaticResource ThemeSidebarForeground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="FontSize" Value="{StaticResource TypographySidebarMenuSize}" />
            <Setter Property="FontWeight" Value="{StaticResource TypographyMedium}" />
            <Setter Property="Foreground" Value="{StaticResource ThemeSidebarForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <Grid ClipToBounds="False">
                                <Border x:Name="activeIndicator" Width="3" HorizontalAlignment="Left" Background="{StaticResource ThemeAccent}" Visibility="Collapsed" />
                                <ContentPresenter x:Name="navigationContent" Margin="16,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource ThemeSidebarHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{StaticResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource ThemeSidebarActive}" />
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active" />
                                    <Condition Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Value="受注登録" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource RegistrationSidebarActive}" />
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active" />
                                    <Condition Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Value="受注更新" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource RegistrationSidebarActive}" />
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{StaticResource ThemeSidebarHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <Setter TargetName="navigationContent" Property="Margin" Value="0" />
                                <Setter TargetName="navigationContent" Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="{StaticResource ThemeSidebar}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface" Background="{StaticResource ThemeSidebarMuted}" CornerRadius="5" Margin="2,1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource ThemeSecondary}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource ThemeAccent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource ThemeSurface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="mainSidebar">
            <Border.DataContext>
                <local:SidebarViewModel />
            </Border.DataContext>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="240" />
                    <Setter Property="Background" Value="{StaticResource ThemeSidebar}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                            <Setter Property="Width" Value="56" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Value="受注登録">
                            <Setter Property="Background" Value="{DynamicResource ThemeOrderEntryNavy}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Value="受注更新">
                            <Setter Property="Background" Value="{DynamicResource ThemeOrderEntryNavy}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,8">
                    <Grid Margin="10,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="sidebarToggleButton" Command="{Binding ToggleSidebarCommand}" Style="{StaticResource SidebarToggleButton}" />
                        <TextBlock Grid.Column="1" Text="販売管理システム" Foreground="{StaticResource ThemeSidebarForeground}"
                                   FontSize="14" FontWeight="{StaticResource TypographySemiBold}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource SidebarLabel}" Margin="12,0,0,0" />
                    </Grid>
                    <Button x:Name="homeButton" Click="Home_Click" Style="{StaticResource NavigationButton}" ToolTip="ホーム" AutomationProperties.Name="ホーム" Tag="Active">
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource IconHome}" Width="18" Height="18" Style="{StaticResource SidebarIcon}" />
                            <TextBlock Text="ホーム" Style="{StaticResource SidebarLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="accountButton" DockPanel.Dock="Bottom" Click="LoginManagement_Click" Style="{StaticResource NavigationButton}" ToolTip="アカウント設定" AutomationProperties.Name="アカウント設定">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconCustomer}" Width="18" Height="18" Style="{StaticResource SidebarIcon}" />
                        <TextBlock Text="アカウント設定" Style="{StaticResource SidebarLabel}" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Height="20" Margin="0,4,0,0" VerticalAlignment="Center" Style="{StaticResource SidebarExpandedContent}">
                    <TextBlock Text="設定" Style="{StaticResource SidebarCategoryLabel}" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource ThemeSidebarSeparator}" Margin="16,8,16,8" />
                <ScrollViewer Background="{Binding Background, ElementName=mainSidebar}" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Template>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        Margin="{TemplateBinding Padding}" />
                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                           Style="{StaticResource SidebarScrollBar}" Background="{TemplateBinding Background}"
                                           Orientation="Vertical"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </ScrollViewer.Template>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ClipToBounds="False">
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Height="1" Background="{StaticResource ThemeSidebarSeparator}" Margin="16,5" Visibility="{Binding HasSeparator, Converter={StaticResource BooleanVisibility}}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SidebarCategoryLabel}" />
                                    </StackPanel>
                                    <Button Command="{Binding NavigateCommand}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}" ClipToBounds="False">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Tag" Value="Active" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid ClipToBounds="False">
                                            <StackPanel x:Name="HorizontalNavigationContent" Orientation="Horizontal" ClipToBounds="False">
                                                <Grid Width="18" Height="18" ClipToBounds="False">
                                                    <local:LucideIcon Data="{Binding IconName, Converter={StaticResource SidebarIconResource}}"
                                                                  Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Style="{StaticResource SidebarIcon}" />
                                                    <Border Panel.ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-4,-6,0" MinWidth="16" Height="16" Padding="3,0"
                                                        Background="{StaticResource ThemeDanger}" BorderBrush="{StaticResource ThemeSidebar}"
                                                        BorderThickness="1" CornerRadius="8"
                                                        Visibility="{Binding ShowUnreadBadge, Converter={StaticResource BooleanVisibility}}"
                                                        AutomationProperties.Name="未読履歴件数">
                                                        <TextBlock Text="{Binding UnreadCountText}" Foreground="White" FontSize="9"
                                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource SidebarLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1">
            <Border x:Name="mainHeader" DockPanel.Dock="Top" Height="64" Background="{StaticResource ThemeSurface}"
                    BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:LucideIcon x:Name="orderHeaderIcon" Data="{StaticResource IconClipboardPlus}" Width="21" Height="21" Stroke="{StaticResource ThemePrimary}" Margin="0,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="mainHeaderTitle" Text="販売管理システム" Foreground="{StaticResource ThemeText}" FontSize="18" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="{StaticResource TypographySemiBold}" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="受注登録">
                                            <Setter Property="FontWeight" Value="{StaticResource TypographyBold}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <DockPanel Grid.Column="1" LastChildFill="True" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="productHeaderRegisterButton" DockPanel.Dock="Right" Click="OpenProductRegistration_Click"
                                Style="{StaticResource OrderHeaderRegisterButton}" Margin="16,0,0,0" Visibility="Collapsed"
                                IsEnabled="{Binding CanRegister, FallbackValue=False}" Content="＋ 商品登録" AutomationProperties.Name="商品登録" />
                        <Button x:Name="customerHeaderRegisterButton" DockPanel.Dock="Right" Click="OpenCustomerRegistration_Click"
                                Style="{StaticResource OrderHeaderRegisterButton}" Margin="16,0,0,0" Visibility="Collapsed"
                                IsEnabled="{Binding CanRegister, FallbackValue=False}" Content="＋ 顧客登録" AutomationProperties.Name="顧客登録" />
                        <Button x:Name="employeeHeaderRegisterButton" DockPanel.Dock="Right" Click="OpenEmployeeRegistration_Click"
                                Style="{StaticResource OrderHeaderRegisterButton}" Margin="16,0,0,0" Visibility="Collapsed"
                                IsEnabled="{Binding CanCreate, FallbackValue=False}" Content="＋ 社員登録" AutomationProperties.Name="社員登録" />
                        <Button x:Name="purchaseHeaderRegisterButton" DockPanel.Dock="Right" Click="OpenPurchaseRegistration_Click"
                                Style="{StaticResource OrderHeaderRegisterButton}" Margin="16,0,0,0" Visibility="Collapsed"
                                Content="＋ 発注登録" AutomationProperties.Name="発注登録" />
                        <Button x:Name="orderHeaderRegisterButton" DockPanel.Dock="Right" Click="OpenOrderRegistration_Click"
                                Style="{StaticResource OrderHeaderRegisterButton}" Margin="16,0,0,0" Visibility="Collapsed"
                                AutomationProperties.Name="受注登録">
                            <StackPanel Orientation="Horizontal">
                                <local:LucideIcon Data="{StaticResource IconPlus}" Width="15" Height="15" Stroke="{StaticResource ThemeSurface}" Margin="0,0,7,0" />
                                <TextBlock Text="受注登録" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="orderHeaderSystemTitle" Text="販売・在庫管理システム" Foreground="White" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="{StaticResource TypographyMedium}" Visibility="Collapsed" />
                        <TextBlock x:Name="status" Foreground="{StaticResource ThemeSecondaryText}" Margin="12,0,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                    </DockPanel>
                </Grid>
            </Border>
            <Grid Background="{StaticResource ThemeSurface}">
                <ContentControl x:Name="pageHost" Background="{StaticResource ThemeSurface}">
                    <local:HomeView />
                </ContentControl>
                <ScrollViewer x:Name="loginManagementView" Visibility="Collapsed" Background="{StaticResource ThemeSurface}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="24,26,24,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="ログイン管理" Foreground="{StaticResource ThemeText}" VerticalAlignment="Center" FontSize="{StaticResource TypographyPageTitleSize}" FontWeight="{StaticResource TypographyBold}" />
                        </Grid>
                        <StackPanel Grid.Row="1" MaxWidth="680" HorizontalAlignment="Stretch">
                            <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ログイン中の社員" Foreground="{StaticResource ThemeText}" FontSize="{StaticResource TypographySectionSize}" FontWeight="{StaticResource TypographySemiBold}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="名前" Foreground="{StaticResource ThemeText}" Margin="0,0,0,10" FontSize="{StaticResource TypographyLabelSize}" FontWeight="{StaticResource TypographyMedium}" />
                                        <TextBlock x:Name="loginName" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource ThemeText}" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}" />
                                        <TextBlock Grid.Row="1" Text="社員ID" Foreground="{StaticResource ThemeText}" Margin="0,0,0,10" FontSize="{StaticResource TypographyLabelSize}" FontWeight="{StaticResource TypographyMedium}" />
                                        <TextBlock x:Name="loginId" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource ThemeText}" Margin="0,0,0,10" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}" />
                                        <TextBlock Grid.Row="2" Text="携帯電話" Foreground="{StaticResource ThemeText}" FontSize="{StaticResource TypographyLabelSize}" FontWeight="{StaticResource TypographyMedium}" />
                                        <TextBlock x:Name="loginPhone" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource ThemeText}" TextWrapping="Wrap" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="パスワード変更" Foreground="{StaticResource ThemeText}" FontSize="{StaticResource TypographySectionSize}" FontWeight="{StaticResource TypographySemiBold}" />
                                    <TextBlock Text="半角英数字を4～10文字で設定できます。現在のパスワードとは異なるものにしてください。" Foreground="{StaticResource ThemeText}" Margin="0,5,0,6" TextWrapping="Wrap" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                                    <TextBlock Text="現在のパスワード" Foreground="{StaticResource ThemeText}" Margin="0,12,0,4" FontSize="{StaticResource TypographyLabelSize}" FontWeight="{StaticResource TypographyMedium}" />
                                    <PasswordBox x:Name="currentPassword" MaxWidth="360" Height="40" Padding="9,6" HorizontalAlignment="Stretch" AutomationProperties.Name="現在のパスワード" PasswordChanged="PasswordInputsChanged" />
                                    <TextBlock Text="新しいパスワード" Foreground="{StaticResource ThemeText}" Margin="0,12,0,4" FontSize="{StaticResource TypographyLabelSize}" FontWeight="{StaticResource TypographyMedium}" />
                                    <PasswordBox x:Name="newPassword" MaxWidth="360" Height="40" Padding="9,6" HorizontalAlignment="Stretch" AutomationProperties.Name="新しいパスワード" PasswordChanged="PasswordInputsChanged" />
                                    <TextBlock Text="新しいパスワード（確認）" Foreground="{StaticResource ThemeText}" Margin="0,12,0,4" FontSize="{StaticResource TypographyLabelSize}" FontWeight="{StaticResource TypographyMedium}" />
                                    <PasswordBox x:Name="confirmPassword" MaxWidth="360" Height="40" Padding="9,6" HorizontalAlignment="Stretch" AutomationProperties.Name="新しいパスワード（確認）" PasswordChanged="PasswordInputsChanged" />
                                    <TextBlock x:Name="passwordMessage" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                                    <Button x:Name="changePasswordButton" Content="パスワードを変更" Click="ChangePassword_Click" Width="176" Height="40" HorizontalAlignment="Left"
                                            Style="{StaticResource ThemePrimaryButton}" Margin="0,14,0,0" Cursor="Hand" IsEnabled="False" FontSize="{StaticResource TypographyButtonSize}" FontWeight="{StaticResource TypographySemiBold}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="ログアウト" Foreground="{StaticResource ThemeText}" FontSize="{StaticResource TypographySectionSize}" FontWeight="{StaticResource TypographySemiBold}" />
                                    <TextBlock Text="作業を終える場合は、ログアウトしてログイン画面へ戻ります。" Foreground="{StaticResource ThemeText}" Margin="0,6,0,14" TextWrapping="Wrap" FontSize="{StaticResource TypographyValidationSize}" FontWeight="{StaticResource TypographyRegular}" />
                                    <Button Click="Logout_Click" Width="136" Height="40" HorizontalAlignment="Right"
                                            Background="{StaticResource ThemeSurface}" Foreground="{StaticResource ThemeText}" BorderBrush="{StaticResource ThemeBorder}"
                                            Cursor="Hand" AutomationProperties.Name="ログアウト" FontSize="{StaticResource TypographyButtonSize}" FontWeight="{StaticResource TypographySemiBold}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:LucideIcon Data="{StaticResource IconLogout}" Width="16" Height="16" Stroke="{StaticResource ThemeIconPrimary}" />
                                            <Border Width="8" />
                                            <TextBlock Text="ログアウト" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
