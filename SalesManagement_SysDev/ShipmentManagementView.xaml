<UserControl x:Class="SalesManagement_SysDev.ShipmentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/OrderManagement.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="ShipmentCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="QuickSearchRow" Margin="0,0,0,8" SizeChanged="QuickSearchRow_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="QuickSearchField" Style="{StaticResource OrderQuickSearchFrame}" Background="{StaticResource OrderInput}" CornerRadius="8" MinHeight="44"><Grid>
                <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="{StaticResource OrderSecondaryText}" IsHitTestVisible="False" />
                <TextBox x:Name="QuickSearch" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="42" Padding="38,4,36,4" BorderThickness="0" Background="Transparent" ToolTip="出荷番号、注文番号、営業所、顧客、商品で検索" AutomationProperties.Name="出荷一覧を検索" />
                <Button Click="ClearQuickSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Margin="0,0,3,0" Padding="0" Background="Transparent" BorderBrush="Transparent" ToolTip="キーワードを消去" AutomationProperties.Name="キーワードを消去"><local:LucideIcon Data="{StaticResource IconX}" Width="16" Height="16" Stroke="{StaticResource OrderSecondaryText}" /><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </Grid></Border>
            <StackPanel x:Name="SearchActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="ToggleFilters_Click" Style="{StaticResource OrderToolbarButton}" Height="36" Margin="0,0,8,0" ToolTip="{Binding FiltersToggleLabel}" AutomationProperties.Name="詳細条件"><StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" /><TextBlock Text="詳細条件" /><local:LucideIcon Width="13" Height="13" Stroke="{StaticResource OrderSecondaryText}" Margin="6,0,0,0"><local:LucideIcon.Style><Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}"><Setter Property="Data" Value="{StaticResource IconChevronDown}" /><Style.Triggers><DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True"><Setter Property="Data" Value="{StaticResource IconChevronUp}" /></DataTrigger></Style.Triggers></Style></local:LucideIcon.Style></local:LucideIcon></StackPanel></Button>
                <Button Click="ClearConditions_Click" ToolTip="すべての検索条件をクリア" AutomationProperties.Name="条件クリア"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource OrderToolbarButton}"><Setter Property="Height" Value="36" /><Style.Triggers><DataTrigger Binding="{Binding HasConditions}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconOrderReset}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" /><TextBlock Text="条件クリア" /></StackPanel></Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Visibility="{Binding IsFiltersExpanded, Converter={StaticResource OrderBooleanVisibility}}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="確定日（開始）" Style="{StaticResource OrderFilterLabel}" /><DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterDate}" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="確定日（終了）" Style="{StaticResource OrderFilterLabel}" /><DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterDate}" /></StackPanel>
                <StackPanel Grid.Column="2" Grid.ColumnSpan="2"><TextBlock Text="出荷状況" Style="{StaticResource OrderFilterLabel}" /><ComboBox ItemsSource="{Binding StateOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedState}" Style="{StaticResource FilterCombo}" /></StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="StatusFiltersRow" Grid.Row="2" Margin="0,0,0,8" SizeChanged="StatusFiltersRow_SizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Menu Background="Transparent" Padding="0" IsMainMenu="False" AutomationProperties.Name="出荷管理状態"><Menu.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></Menu.ItemsPanel>
                <MenuItem x:Name="AllTab" Style="{StaticResource StatusMenuItem}" Click="AllTab_Click" ToolTip="すべての出荷を表示"><MenuItem.Header><StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconShipment}" Width="16" Height="16" Tag="{StaticResource OrderText}" Style="{StaticResource StatusTabIcon}" /><Border Width="8" /><TextBlock Text="すべて" /><Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0"><TextBlock Text="{Binding TotalCount, StringFormat={}{0:N0}}" FontSize="12" /></Border></StackPanel></MenuItem.Header></MenuItem>
                <MenuItem x:Name="VisibleTab" Style="{StaticResource StatusMenuItem}" Click="VisibleTab_Click" ToolTip="表示中の出荷を表示"><MenuItem.Header><StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconEye}" Width="16" Height="16" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabIcon}" /><Border Width="8" /><TextBlock Text="表示中" /><Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0"><TextBlock Text="{Binding VisibleCount, StringFormat={}{0:N0}}" FontSize="12" /></Border></StackPanel></MenuItem.Header></MenuItem>
                <MenuItem x:Name="HiddenTab" Style="{StaticResource StatusMenuItem}" Click="HiddenTab_Click" ToolTip="非表示の出荷を表示" Visibility="{Binding CanViewHidden, Converter={StaticResource OrderBooleanVisibility}}"><MenuItem.Header><StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconHidden}" Width="16" Height="16" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabIcon}" /><Border Width="8" /><TextBlock Text="非表示" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" /><Border Tag="{StaticResource OrderDangerSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="3" Padding="5,0" Margin="6,0,0,0"><TextBlock Text="{Binding HiddenCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" FontSize="12" /></Border></StackPanel></MenuItem.Header></MenuItem>
            </Menu>
            <StackPanel x:Name="StatusActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="{Binding Feedback}" Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" Margin="0,0,12,0" /><Button Content="出荷履歴" Click="BusinessHistory_Click" Style="{StaticResource OrderToolbarButton}" Height="36" Margin="0,0,8,0" /><Button Click="Reload_Click" IsEnabled="{Binding CanReload}" Style="{StaticResource OrderToolbarButton}" Height="36" ToolTip="出荷一覧を再読込"><StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Stroke="{StaticResource OrderText}" Margin="0,0,6,0" /><TextBlock Text="再読込" /></StackPanel></Button></StackPanel>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,4"><TextBlock Text="出荷一覧" Foreground="{StaticResource OrderText}" FontSize="15" FontWeight="{StaticResource TypographySemiBold}" Margin="0,0,8,0" /><TextBlock Text="{Binding CountText}" Foreground="{StaticResource OrderSecondaryText}" FontSize="13" VerticalAlignment="Center" /></StackPanel>
            <TextBlock Grid.Row="1" Text="行をダブルクリックすると出荷詳細を表示します。" Foreground="{StaticResource OrderSecondaryText}" FontSize="12" Margin="2,0,2,8" />
            <Grid Grid.Row="2"><DataGrid x:Name="ShipmentsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserSortColumns="True" FrozenColumnCount="2" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="44" ColumnHeaderHeight="44" AlternationCount="2" ColumnHeaderStyle="{StaticResource OrderColumnHeader}" CellStyle="{StaticResource OrderListCell}" RowStyle="{StaticResource OrderGridRow}" Background="{StaticResource OrderSurface}" Foreground="{StaticResource OrderText}" BorderBrush="Transparent" BorderThickness="0" HorizontalGridLinesBrush="{StaticResource OrderDivider}" VerticalGridLinesBrush="Transparent" RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="ShipmentsGrid_MouseDoubleClick" FontSize="{StaticResource TypographyBodySize}" FontWeight="{StaticResource TypographyRegular}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="出荷番号" Binding="{Binding Code}" Width="112" IsReadOnly="True" HeaderStyle="{StaticResource OrderCenterHeader}" ElementStyle="{StaticResource TableCenter}" />
                    <DataGridTextColumn Header="確定日" Binding="{Binding ConfirmedDateText}" Width="112" IsReadOnly="True" HeaderStyle="{StaticResource OrderCenterHeader}" ElementStyle="{StaticResource TableCenter}" />
                    <DataGridTextColumn Header="注文番号" Binding="{Binding OrderCode}" Width="112" IsReadOnly="True" HeaderStyle="{StaticResource OrderCenterHeader}" ElementStyle="{StaticResource TableCenter}" />
                    <DataGridTextColumn Header="顧客" Binding="{Binding CustomerName}" Width="1.2*" MinWidth="130" IsReadOnly="True" ElementStyle="{StaticResource ShipmentCell}" />
                    <DataGridTextColumn Header="出荷元営業所" Binding="{Binding OfficeName}" Width="1.1*" MinWidth="130" IsReadOnly="True" ElementStyle="{StaticResource ShipmentCell}" />
                    <DataGridTextColumn Header="商品 / 行数" Binding="{Binding ProductSummary}" Width="110" IsReadOnly="True" HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}" />
                    <DataGridTextColumn Header="出荷数量" Binding="{Binding QuantityText}" Width="104" IsReadOnly="True" HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}" />
                    <DataGridTemplateColumn Header="出荷状況" Width="106" HeaderStyle="{StaticResource OrderCenterHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding StateBackground}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateForeground}" Style="{StaticResource TypographyBadge}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="管理状態" Width="96" HeaderStyle="{StaticResource OrderCenterHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding ManagementBackground}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding ManagementLabel}" Foreground="{Binding ManagementForeground}" Style="{StaticResource TypographyBadge}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid><Border Grid.Row="0" Panel.ZIndex="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" IsHitTestVisible="False" Visibility="{Binding ShowEmptyState, Converter={StaticResource OrderBooleanVisibility}}"><StackPanel MaxWidth="480"><TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="{StaticResource TypographySemiBold}" Foreground="{StaticResource OrderText}" TextAlignment="Center" /><TextBlock Text="{Binding EmptyDescription}" Margin="0,8,0,0" Foreground="{StaticResource OrderSecondaryText}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Border></Grid>
        </Grid></Border>
    </Grid>
</UserControl>
