<Window x:Class="SalesManagement_SysDev.F_WarehouseMovementHide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="非表示確認" Width="560" SizeToContent="Height" MinWidth="440" MaxWidth="700" MaxHeight="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="66" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <TextBlock Text="この情報を非表示にしますか？データは削除されず、管理状態のみ変更されます。"
                           Foreground="{StaticResource ThemeText}" FontSize="14" TextWrapping="Wrap" />
                <Border Background="{StaticResource ThemeSubtle}" CornerRadius="6" Padding="12" Margin="0,14,0,12">
                    <TextBlock Text="{Binding TargetText}" Foreground="{StaticResource ThemeText}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="明細" Style="{StaticResource FormLabel}" />
                <ItemsControl ItemsSource="{Binding Lines}" MaxHeight="150">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,3" TextTrimming="CharacterEllipsis" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="非表示理由（必須）" Style="{StaticResource FormLabel}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditReason}" MinHeight="74" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="非表示理由" />
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource ThemeDangerText}" Margin="0,6,0,0" />
                <Border Background="{StaticResource ThemeWarningSurface}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <TextBlock Text="{Binding VisibilityWarning}" Foreground="{StaticResource ThemeWarningText}" TextWrapping="Wrap" FontSize="12" />
                </Border>
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,10,0,0" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="キャンセル" IsCancel="True" MinWidth="106" Height="38" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="非表示にする" IsDefault="True" MinWidth="136" Height="38" Background="{StaticResource ThemeDanger}"
                            Foreground="White" BorderBrush="{StaticResource ThemeDanger}" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
