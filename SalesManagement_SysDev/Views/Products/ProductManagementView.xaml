<UserControl x:Class="SalesManagement_SysDev.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}" Language="ja-JP" SizeChanged="ProductView_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SalesManagement_SysDev;component/Resources/OrderManagement.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProductGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
                <Setter Property="Background" Value="{StaticResource OrderSurfaceAlt}"/>
                <Setter Property="Padding" Value="7,0"/>
            </Style>
            <Style x:Key="ProductCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                <Setter Property="Margin" Value="8,0"/>
            </Style>
            <Style x:Key="StatusFilterButtonProductVisible" TargetType="Button" BasedOn="{StaticResource StatusFilterButton}">
                <Setter Property="Foreground" Value="{StaticResource ThemeSuccessText}"/>
            </Style>
            <Style x:Key="StatusFilterTabIconProductVisible" TargetType="local:LucideIcon" BasedOn="{StaticResource StatusFilterTabIcon}">
                <Setter Property="Stroke" Value="{StaticResource ThemeSuccessText}"/>
            </Style>
            <Style x:Key="StatusFilterButtonProductHidden" TargetType="Button" BasedOn="{StaticResource StatusFilterButton}">
                <Setter Property="Foreground" Value="{StaticResource ThemeDangerText}"/>
            </Style>
            <Style x:Key="StatusFilterTabIconProductHidden" TargetType="local:LucideIcon" BasedOn="{StaticResource StatusFilterTabIcon}">
                <Setter Property="Stroke" Value="{StaticResource ThemeDangerText}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource OrderQuickSearchFrame}" Background="{StaticResource OrderInput}" MinHeight="44" CornerRadius="8">
                <Grid>
                    <TextBox x:Name="QuickSearchBox" Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                             Height="42" Padding="40,4,38,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="商品コード・商品名・カテゴリで検索"/>
                    <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0"
                                      Stroke="{StaticResource OrderSecondaryText}" IsHitTestVisible="False"/>
                    <TextBlock Text="商品コード・商品名・カテゴリで検索..." Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center"
                               Margin="40,0,38,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Click="ClearQuickSearch_Click" HorizontalAlignment="Right" Width="34" Height="34" Margin="0,0,3,0"
                            Background="Transparent" BorderBrush="Transparent" ToolTip="キーワードを消去" AutomationProperties.Name="キーワードを消去">
                        <local:LucideIcon Data="{StaticResource IconX}" Width="15" Height="15"/>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button Click="ToggleFilters_Click" Style="{StaticResource OrderToolbarButton}" ToolTip="{Binding FiltersToggleLabel}"
                        AutomationProperties.Name="詳細条件" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="詳細条件" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource OrderHover}" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                Visibility="{Binding HasAdvancedConditions, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding AdvancedCount}" VerticalAlignment="Center"/>
                        </Border>
                        <local:LucideIcon Width="12" Height="12" Margin="6,0,0,0">
                            <local:LucideIcon.Style>
                                <Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                    <Setter Property="Data" Value="{StaticResource IconChevronDown}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconChevronUp}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </local:LucideIcon.Style>
                        </local:LucideIcon>
                    </StackPanel>
                </Button>
                <Button Click="Reload_Click" Style="{StaticResource OrderToolbarButton}" IsEnabled="{Binding CanReload}" AutomationProperties.Name="再読込">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="再読込" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1"
                CornerRadius="8" Padding="8,8,8,1" Margin="0,0,0,8" Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="条件クリア" Style="{StaticResource OrderToolbarButton}" Click="ClearConditions_Click"
                        HorizontalAlignment="Right" Height="34" IsEnabled="{Binding HasConditions}" Margin="4,3,4,6"/>
                <ScrollViewer x:Name="AdvancedFieldsScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,0,4,7">
                    <TextBlock Text="商品コード" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Text="{Binding CodeFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="商品コード"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,7">
                    <TextBlock Text="商品名" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="商品名"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,4,7">
                    <TextBlock Text="カテゴリ" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox ItemsSource="{Binding ClassificationOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding ClassificationSelection, Mode=TwoWay}" Style="{StaticResource FilterCombo}" Height="34" AutomationProperties.Name="カテゴリ"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,4,7">
                    <TextBlock Text="管理状態" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox ItemsSource="{Binding VisibilityOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding VisibilitySelection, Mode=TwoWay}" Style="{StaticResource FilterCombo}" Height="34" AutomationProperties.Name="管理状態"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,0,4,7">
                    <TextBlock Text="販売単価（下限）" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Text="{Binding MinimumPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="販売単価（下限）"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,7">
                    <TextBlock Text="販売単価（上限）" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Text="{Binding MaximumPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="販売単価（上限）"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,4,7">
                    <TextBlock Text="在庫状態" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox ItemsSource="{Binding StockOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding StockSelection, Mode=TwoWay}" Style="{StaticResource FilterCombo}" Height="34" AutomationProperties.Name="在庫状態"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,0,4,7">
                    <TextBlock Text="メーカー" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox ItemsSource="{Binding MakerOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding MakerSelection, Mode=TwoWay}" Style="{StaticResource FilterCombo}" Height="34" AutomationProperties.Name="メーカー"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="4,0,4,7">
                    <TextBlock Text="JANコード" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Text="{Binding JanFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="JANコード"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,4,7">
                    <TextBlock Text="型番" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}" Height="34" AutomationProperties.Name="型番"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="4,0,4,7">
                    <TextBlock Text="発売日（開始）" Style="{StaticResource OrderFilterLabel}"/>
                    <DatePicker SelectedDate="{Binding ReleaseFrom}" Style="{StaticResource FilterDate}" Height="34" SelectedDateFormat="Short"
                                DateValidationError="ReleaseDate_ValidationError" AutomationProperties.Name="発売日（開始）"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="3" Margin="4,0,4,7">
                    <TextBlock Text="発売日（終了）" Style="{StaticResource OrderFilterLabel}"/>
                    <DatePicker SelectedDate="{Binding ReleaseTo}" Style="{StaticResource FilterDate}" Height="34" SelectedDateFormat="Short"
                                DateValidationError="ReleaseDate_ValidationError" AutomationProperties.Name="発売日（終了）"/>
                </StackPanel>
            </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AllTab" Style="{StaticResource StatusFilterButton}" Click="AllTab_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconGrid}" Width="15" Height="15" Margin="0,0,6,0" Style="{StaticResource StatusFilterTabIcon}"/>
                    <TextBlock Text="{Binding AllTabText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="VisibleTab" Style="{StaticResource StatusFilterButtonProductVisible}" Click="VisibleTab_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconEye}" Width="15" Height="15" Margin="0,0,6,0" Style="{StaticResource StatusFilterTabIconProductVisible}"/>
                    <TextBlock Text="{Binding VisibleTabText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="HiddenTab" Style="{StaticResource StatusFilterButtonProductHidden}" Click="HiddenTab_Click" Margin="0,0,8,0" Visibility="{Binding CanViewHidden, Converter={StaticResource BooleanVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconEyeOff}" Width="15" Height="15" Margin="0,0,6,0" Style="{StaticResource StatusFilterTabIconProductHidden}"/>
                    <TextBlock Text="{Binding HiddenTabText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <Border Grid.Row="3" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,6,10,5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding CanViewHidden, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding SelectedCount, StringFormat=選択 {0:N0} 件}" Foreground="{StaticResource ThemeSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="選択を解除" Click="ClearSelection_Click" IsEnabled="{Binding CanClearSelection}" Margin="0,0,6,0" Height="32" Padding="7,3"/>
                            <Button Content="選択を非表示" Click="HideSelected_Click" IsEnabled="{Binding CanHideSelected}" Height="32" Padding="7,3"
                                    Foreground="{StaticResource ThemeDangerText}"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="商品一覧" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" Foreground="{StaticResource ThemeSecondaryText}" FontSize="12"/>
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,4,0,0"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Feedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FilterError}" Foreground="{StaticResource ThemeDangerText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasFilterError, Converter={StaticResource BooleanVisibility}}"/>
                </StackPanel>
                <DataGrid x:Name="ProductGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" ColumnHeaderHeight="34" AlternationCount="2"
                          RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}"
                          RowStyle="{StaticResource OrderGridRow}" ColumnHeaderStyle="{StaticResource ProductGridHeader}" CellStyle="{StaticResource OrderListCell}"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseDoubleClick="ProductGrid_DoubleClick" Sorting="ProductGrid_Sorting" SizeChanged="ProductGrid_SizeChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="52" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.VisibleSelectionState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                          IsEnabled="{Binding DataContext.CanSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}" Click="SelectAll_Click"
                                          ToolTip="検索結果の表示中商品を全ページ選択／解除" AutomationProperties.Name="検索結果の全ページを選択／解除"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を選択}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="商品コード" Binding="{Binding Code}" Width="98" ElementStyle="{StaticResource ProductCell}"/>
                        <DataGridTextColumn x:Name="ProductNameColumn" Header="商品名" Binding="{Binding Name}" Width="2*" MinWidth="125" ElementStyle="{StaticResource ProductCell}"/>
                        <DataGridTextColumn x:Name="CategoryColumn" Header="カテゴリ" Binding="{Binding Classification}" Width="1.15*" MinWidth="95" ElementStyle="{StaticResource ProductCell}"/>
                        <DataGridTextColumn Header="販売単価" Binding="{Binding Price, StringFormat='¥{0:N0}'}" Width="94"
                                            HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}"/>
                        <DataGridTextColumn Header="現在庫数" Binding="{Binding StockText}" SortMemberPath="StockQuantity" Width="84"
                                            HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}"/>
                        <DataGridTemplateColumn Header="管理状態" Width="92" SortMemberPath="ManagementState">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ManagementState}" FontSize="12"/>
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ThemeSuccessSurface}"/>
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource ThemeSuccessText}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ManagementState}" Value="非表示">
                                            <Setter Property="Background" Value="{StaticResource ThemeSubtle}"/>
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource ThemeSecondaryText}"/>
                                        </DataTrigger></Style.Triggers>
                                    </Style></Border.Style>
                                </Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="詳細" Width="65" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="詳細" Click="OpenDetail_Click" Margin="4,0" Padding="5,0" Height="25" VerticalAlignment="Center"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock Text="一致する商品がありません" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="検索条件を変更するか、条件をクリアしてください。" Margin="0,4,0,0" Foreground="{StaticResource ThemeSecondaryText}" TextAlignment="Center"/>
                </StackPanel>
                <DockPanel Grid.Row="2" Margin="10,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="前へ" Click="PreviousPage_Click" IsEnabled="{Binding CanGoBack}" Height="32" Padding="7,2" Margin="0,0,6,0"/>
                        <ListBox ItemsSource="{Binding PageNumbers}" SelectedItem="{Binding PageNumber, Mode=TwoWay}" BorderThickness="0"
                                 Background="Transparent" Height="32" VerticalAlignment="Center" Margin="0,0,6,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once"
                                 AutomationProperties.Name="ページ番号">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
                                    <Setter Property="Margin" Value="0,0,3,0"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1"
                                                MinWidth="28" Height="30" CornerRadius="5" Padding="5,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate></Setter.Value></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ThemeHover}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ThemePrimary}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Button Content="次へ" Click="NextPage_Click" IsEnabled="{Binding CanGoForward}" Height="32" Padding="7,2" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}" Style="{StaticResource FilterCombo}"
                                  Width="78" Height="32" AutomationProperties.Name="1ページの表示件数"/>
                        <TextBlock Text="件 / ページ" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PageRange}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ThemeSecondaryText}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
