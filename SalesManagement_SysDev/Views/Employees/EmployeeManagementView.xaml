<UserControl x:Class="SalesManagement_SysDev.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}" Language="ja-JP">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SalesManagement_SysDev;component/Resources/OrderManagement.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="EmployeeCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="EmployeeHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Background" Value="{StaticResource OrderSurfaceAlt}"/>
        </Style>
        <Style x:Key="EmployeeStatePill" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="TextElement.Foreground" Value="#166534"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="非表示">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="TextElement.Foreground" Value="#475569"/>
                </Trigger>
                <Trigger Property="Tag" Value="要確認">
                    <Setter Property="Background" Value="#FEF3C7"/>
                    <Setter Property="TextElement.Foreground" Value="#92400E"/>
                </Trigger>
                <Trigger Property="Tag" Value="無効">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="TextElement.Foreground" Value="#991B1B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource OrderQuickSearchFrame}" Background="{StaticResource OrderSurface}" CornerRadius="8" MinHeight="44">
                <Grid>
                    <TextBox x:Name="QuickSearchBox" Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                             Height="42" Padding="40,4,38,4" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="社員番号・社員名・ログインIDで検索"/>
                    <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" HorizontalAlignment="Left" Margin="12,0,0,0"
                                      Stroke="{StaticResource OrderSecondaryText}" IsHitTestVisible="False"/>
                    <TextBlock Text="社員番号・社員名・ログインIDで検索..." Foreground="{StaticResource OrderSecondaryText}"
                               VerticalAlignment="Center" Margin="40,0,38,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QuickSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Click="ClearQuickSearch_Click" HorizontalAlignment="Right" Width="34" Height="34" Margin="0,0,3,0"
                            Background="Transparent" BorderBrush="Transparent" ToolTip="キーワードを消去" AutomationProperties.Name="キーワードを消去">
                        <local:LucideIcon Data="{StaticResource IconX}" Width="15" Height="15"/>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QuickSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button Click="ToggleFilters_Click" Style="{StaticResource OrderToolbarButton}" AutomationProperties.Name="詳細条件"
                        ToolTip="{Binding FiltersToggleLabel}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="詳細条件" VerticalAlignment="Center"/>
                        <local:LucideIcon Width="12" Height="12" Margin="6,0,0,0">
                            <local:LucideIcon.Style>
                                <Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                    <Setter Property="Data" Value="{StaticResource IconChevronDown}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconChevronUp}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style>
                            </local:LucideIcon.Style>
                        </local:LucideIcon>
                    </StackPanel>
                </Button>
                <Button Click="Reload_Click" Style="{StaticResource OrderToolbarButton}" IsEnabled="{Binding CanReload}" AutomationProperties.Name="再読込">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="再読込" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1"
                CornerRadius="8" Padding="8,8,8,1" Margin="0,0,0,8" Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanVisibility}}">
            <ScrollViewer MaxHeight="186" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,0,4,7">
                    <TextBlock Text="社員番号" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Style="{StaticResource FilterInput}" Height="34" Text="{Binding IdFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="社員番号"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,7">
                    <TextBlock Text="社員名" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Style="{StaticResource FilterInput}" Height="34" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="社員名"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,4,7">
                    <TextBlock Text="所属営業所" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Height="34" ItemsSource="{Binding OfficeOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding OfficeFilter, Mode=TwoWay}" AutomationProperties.Name="所属営業所"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,4,7">
                    <TextBlock Text="権限ロール" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Height="34" ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding RoleFilter, Mode=TwoWay}" AutomationProperties.Name="権限ロール"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,0,4,7">
                    <TextBlock Text="管理状態" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Height="34" ItemsSource="{Binding ManagementOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding ManagementFilter, Mode=TwoWay}" AutomationProperties.Name="管理状態"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,7">
                    <TextBlock Text="ログイン状態" Style="{StaticResource OrderFilterLabel}"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Height="34" ItemsSource="{Binding LoginOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding LoginFilter, Mode=TwoWay}" AutomationProperties.Name="ログイン状態"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,4,7">
                    <TextBlock Text="入社日（開始）" Style="{StaticResource OrderFilterLabel}"/>
                    <DatePicker Style="{StaticResource FilterDate}" Height="34" SelectedDate="{Binding HiredFrom}" AutomationProperties.Name="入社日（開始）" DateValidationError="HireDate_ValidationError"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,0,4,7">
                    <TextBlock Text="入社日（終了）" Style="{StaticResource OrderFilterLabel}"/>
                    <DatePicker Style="{StaticResource FilterDate}" Height="34" SelectedDate="{Binding HiredTo}" AutomationProperties.Name="入社日（終了）" DateValidationError="HireDate_ValidationError"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="4,0,4,7">
                    <TextBlock Text="電話番号" Style="{StaticResource OrderFilterLabel}"/>
                    <TextBox Style="{StaticResource FilterInput}" Height="34" Text="{Binding PhoneFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="電話番号"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="3" Content="条件クリア" Style="{StaticResource OrderToolbarButton}" Click="ClearConditions_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4,0,4,7"/>
              </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8" SizeChanged="StatusToolbar_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
            <Button x:Name="AllTab" Style="{StaticResource StatusFilterButton}" Click="AllTab_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconGrid}" Width="15" Height="15" Margin="0,0,7,0" Style="{StaticResource StatusFilterTabIcon}"/>
                    <TextBlock Text="{Binding AllTabText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="VisibleTab" Style="{StaticResource StatusFilterButton}" Click="VisibleTab_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconEye}" Width="15" Height="15" Margin="0,0,7,0" Style="{StaticResource StatusFilterTabIcon}"/>
                    <TextBlock Text="{Binding VisibleTabText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="HiddenTab" Style="{StaticResource StatusFilterButton}" Click="HiddenTab_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <local:LucideIcon Data="{StaticResource IconEyeOff}" Width="15" Height="15" Margin="0,0,7,0" Style="{StaticResource StatusFilterTabIcon}"/>
                    <TextBlock Text="{Binding HiddenTabText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </StackPanel>
            <StackPanel x:Name="EmployeeTools" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                <Button Content="権限管理" Style="{StaticResource OrderToolbarButton}" Click="Roles_Click" IsEnabled="{Binding CanViewRoles}" Margin="0,0,8,0"/>
                <Button Content="社員変更履歴" Style="{StaticResource OrderToolbarButton}" Click="EmployeeHistory_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,7,10,5">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectionText}" Foreground="{StaticResource ThemeSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="選択を解除" Click="ClearSelection_Click" IsEnabled="{Binding CanClearSelection}" Margin="0,0,6,0" Padding="7,3"/>
                            <Button Content="選択社員を非表示" Click="HideSelected_Click" IsEnabled="{Binding CanHide}" Padding="7,3"
                                    ToolTip="社員を非表示にし、以降のログインを無効にします。" Foreground="{StaticResource ThemeDangerText}"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="社員一覧" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}"/>
                            <TextBlock Text="{Binding CountText}" Margin="9,0,0,0" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}"/>
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,4,0,0"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Feedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FilterError}" Foreground="{StaticResource ThemeDangerText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasFilterError, Converter={StaticResource BooleanVisibility}}"/>
                </StackPanel>

                <DataGrid x:Name="EmployeeGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" ColumnHeaderHeight="34" AlternationCount="2"
                          RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}"
                          ColumnHeaderStyle="{StaticResource EmployeeHeader}" CellStyle="{StaticResource OrderListCell}"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Sorting="EmployeeGrid_Sorting" PreviewMouseDoubleClick="EmployeeGrid_DoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource OrderGridRow}"/>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="選択" Width="49" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSelectable}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat={}{0}を選択}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="社員番号" Binding="{Binding Code}" Width="0.9*" MinWidth="84" ElementStyle="{StaticResource EmployeeCell}"/>
                        <DataGridTextColumn Header="社員名" Binding="{Binding Name}" Width="1.2*" MinWidth="92" ElementStyle="{StaticResource EmployeeCell}"/>
                        <DataGridTextColumn Header="所属営業所" Binding="{Binding Office}" Width="1.3*" MinWidth="102" ElementStyle="{StaticResource EmployeeCell}"/>
                        <DataGridTextColumn Header="権限ロール" Binding="{Binding Role}" Width="1*" MinWidth="90" ElementStyle="{StaticResource EmployeeCell}"/>
                        <DataGridTemplateColumn Header="管理状態" Width="88" SortMemberPath="ManagementState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Tag="{Binding ManagementState}" Style="{StaticResource EmployeeStatePill}">
                                        <TextBlock Text="{Binding ManagementState}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ログイン状態" Width="94" SortMemberPath="LoginState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Tag="{Binding LoginState}" Style="{StaticResource EmployeeStatePill}">
                                        <TextBlock Text="{Binding LoginState}" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="詳細" Width="65" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Button Content="詳細" Click="OpenDetail_Click" Margin="4,0" Padding="5,0" Height="25" VerticalAlignment="Center"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock Text="該当する社員がありません" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="検索条件を変更するか、条件をクリアしてください。" Margin="0,4,0,0"
                               Foreground="{StaticResource ThemeSecondaryText}" TextAlignment="Center"/>
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="10,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="前へ" Click="PreviousPage_Click" IsEnabled="{Binding CanGoBack}" Padding="7,2" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding PageNumbers}" SelectedItem="{Binding PageNumber, Mode=TwoWay}" Style="{StaticResource FilterCombo}"
                                  Width="78" Height="30" AutomationProperties.Name="ページ番号" ToolTip="ページ番号"/>
                        <TextBlock Text="{Binding PageCount, StringFormat={}/ {0}}" VerticalAlignment="Center" Margin="6,0,8,0" Foreground="{StaticResource ThemeSecondaryText}"/>
                        <Button Content="次へ" Click="NextPage_Click" IsEnabled="{Binding CanGoForward}" Padding="7,2" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}" Style="{StaticResource FilterCombo}"
                                  Width="78" Height="30" AutomationProperties.Name="1ページの表示件数" ToolTip="1ページの表示件数"/>
                        <TextBlock Text="件 / ページ" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource ThemeSecondaryText}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PageRange}" VerticalAlignment="Center" Foreground="{StaticResource ThemeSecondaryText}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
