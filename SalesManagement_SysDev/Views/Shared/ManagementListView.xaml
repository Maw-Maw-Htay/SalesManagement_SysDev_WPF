<UserControl x:Class="SalesManagement_SysDev.ManagementListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}" Style="{StaticResource {x:Type UserControl}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TypographyPageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="480" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="キーワード検索" Style="{StaticResource FormLabel}" />
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,6,12,6"
                                 AutomationProperties.Name="一覧を検索" ToolTip="ID・名前など、一覧の項目から検索できます" />
                        <local:LucideIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="12,0,0,0"
                                          HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="再読込">
                    <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="再読込" /></StackPanel>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ThemeCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="16">
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource TypographyLabel}" />
                    <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource ThemeSecondaryText}" Margin="12,0,0,0" />
                </DockPanel>
                <DataGrid x:Name="RowsGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" BorderThickness="0,1,0,0"
                          ColumnWidth="*" MinColumnWidth="100" AutoGeneratingColumn="FormatColumn" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}">
                    <local:LucideIcon Data="{StaticResource IconSearch}" Width="24" Height="24" Margin="0,0,0,16" />
                    <TextBlock Text="一致するデータがありません" TextAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="検索キーワードを変更してお試しください。" Style="{StaticResource PageSubtitle}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
