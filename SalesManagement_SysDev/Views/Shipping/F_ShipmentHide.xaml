<Window x:Class="SalesManagement_SysDev.F_ShipmentHide" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="出荷非表示" Width="520" MinWidth="400" SizeToContent="Height" MaxHeight="820" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0"><TextBlock Text="出荷を非表示にする" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Row="1" Margin="24,20">
                <TextBlock Text="この確定済み出荷を非表示にしますか？" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Border Background="{StaticResource ThemeSubtle}" CornerRadius="8" Padding="14"><TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" /></Border>
                <Border Background="{StaticResource ThemeWarningSurface}" CornerRadius="8" Padding="12" Margin="0,12,0,14"><TextBlock Text="出荷データは削除されません。管理状態だけが変わります。" TextWrapping="Wrap" Foreground="{StaticResource ThemeWarningText}" /></Border>
                <TextBlock Text="非表示理由（必須・500文字以内）" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" MinHeight="76" Height="Auto" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource ThemeDangerText}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="18,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" Click="Cancel_Click" MinWidth="92" Margin="0,0,8,0" /><Button Content="非表示にする" Style="{StaticResource ThemePrimaryButton}" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" MinWidth="116" /></StackPanel></Border>
        </Grid>
    </Border>
</Window>
