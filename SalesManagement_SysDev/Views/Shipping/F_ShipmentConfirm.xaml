<Window x:Class="SalesManagement_SysDev.F_ShipmentConfirm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="出荷確定" Width="520" MinWidth="400" SizeToContent="Height" MaxHeight="820" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0"><TextBlock Text="出荷を確定する" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Row="1" Margin="24,20">
                <TextBlock Text="この出荷情報を確定しますか？" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Border Background="{StaticResource ThemeSubtle}" CornerRadius="8" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="出荷番号" Style="{StaticResource FormLabel}" /><TextBlock Grid.Column="1" Text="{Binding Shipment.Code}" />
                    <TextBlock Grid.Row="1" Text="注文番号" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Shipment.OrderCode}" />
                    <TextBlock Grid.Row="2" Text="顧客名" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Shipment.CustomerName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="出荷元営業所" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Shipment.OfficeName}" />
                    <TextBlock Grid.Row="4" Text="明細・数量" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="4" Grid.Column="1"><Run Text="{Binding LineCountText, Mode=OneWay}" /><Run Text="　／　" /><Run Text="{Binding QuantityText, Mode=OneWay}" /></TextBlock>
                </Grid></Border>
                <Border Background="{StaticResource ThemePaleBlue}" CornerRadius="8" Padding="12" Margin="0,14,0,0"><TextBlock Text="出荷状況を確定済みに変更します。在庫・入荷・出荷は追加更新しません。既存の売上連携は必要な場合に1件だけ行い、売上があれば数量を照合して重複登録を防ぎます。" TextWrapping="Wrap" Foreground="{StaticResource ThemeText}" /></Border>
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,12,0,0" />
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="18,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" Click="Cancel_Click" MinWidth="92" Margin="0,0,8,0" /><Button Content="出荷を確定" Style="{StaticResource ThemePrimaryButton}" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" MinWidth="116" /></StackPanel></Border>
        </Grid>
    </Border>
</Window>
