<Window x:Class="SalesManagement_SysDev.F_ShipmentDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="出荷詳細" Width="940" Height="700" MinWidth="720" MinHeight="520" MaxWidth="1200" MaxHeight="900"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="22,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="出荷詳細" Foreground="White" FontSize="19" FontWeight="Bold" /><TextBlock Text="{Binding Shipment.Code}" Foreground="#D8E5F7" FontSize="14" Margin="12,3,0,0" /></StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Background="{Binding StateBackground}" CornerRadius="8" Padding="9,4" Margin="0,0,12,0"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateForeground}" FontSize="12" FontWeight="SemiBold" /></Border>
                        <Button Content="×" Click="Close_Click" Width="34" Height="34" Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="21" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,7,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="出荷情報" FontSize="15" FontWeight="Bold" Grid.ColumnSpan="2" Margin="0,0,0,12" />
                                <TextBlock Grid.Row="1" Text="出荷番号" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Shipment.Code}" />
                                <TextBlock Grid.Row="2" Text="注文番号" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Shipment.OrderCode}" />
                                <TextBlock Grid.Row="3" Text="確定日" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Shipment.ConfirmedDateText}" />
                                <TextBlock Grid.Row="4" Text="出荷元営業所" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Shipment.OfficeName}" />
                                <TextBlock Grid.Row="5" Text="確定担当者" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Shipment.EmployeeName}" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="7,0,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="顧客・管理情報" FontSize="15" FontWeight="Bold" Grid.ColumnSpan="2" Margin="0,0,0,12" />
                                <TextBlock Grid.Row="1" Text="顧客コード" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Shipment.CustomerId, StringFormat=CL-{0:000000}}" />
                                <TextBlock Grid.Row="2" Text="顧客名" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Shipment.CustomerName}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="出荷状況" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StateLabel}" />
                                <TextBlock Grid.Row="4" Text="管理状態" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ManagementLabel}" />
                                <TextBlock Grid.Row="5" Text="出荷数量" Style="{StaticResource FormLabel}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding QuantityText}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Background="{StaticResource ThemePaleBlue}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock Text="{Binding ArrivalReferenceNote}" Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap" /></Border>
                    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12" Visibility="{Binding HasHiddenReason, Converter={StaticResource BooleanVisibility}}">
                        <StackPanel><TextBlock Text="非表示理由" FontWeight="SemiBold" /><TextBlock Text="{Binding Shipment.HiddenReason}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                    </Border>
                    <TextBlock Text="出荷明細" FontSize="15" FontWeight="Bold" Margin="0,2,0,8" />
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="38" ColumnHeaderHeight="38" MaxHeight="280" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns><DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" Width="150" IsReadOnly="True" /><DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" /><DataGridTextColumn Header="出荷数量" Binding="{Binding QuantityText}" Width="120" IsReadOnly="True" /></DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="18,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ConfirmButton" Content="出荷確定" Style="{StaticResource ThemePrimaryButton}" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" Visibility="{Binding CanConfirm, Converter={StaticResource BooleanVisibility}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding HideUnavailableReason}" Foreground="{StaticResource ThemeWarningText}" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" MaxWidth="280"
                               Visibility="{Binding ShowHideAction, Converter={StaticResource BooleanVisibility}}" />
                    <Button x:Name="HideButton" Content="非表示" Click="Hide_Click" IsEnabled="{Binding CanHide}" Visibility="{Binding ShowHideAction, Converter={StaticResource BooleanVisibility}}"
                            ToolTip="確定済みの出荷だけを理由入力のうえ非表示にできます。" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" />
                    <Button Content="閉じる" Click="Close_Click" MinWidth="88" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
