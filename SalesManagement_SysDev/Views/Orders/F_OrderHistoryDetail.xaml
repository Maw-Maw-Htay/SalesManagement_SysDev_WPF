<Window x:Class="SalesManagement_SysDev.F_OrderHistoryDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="受注操作履歴" Width="760" SizeToContent="Height" MinHeight="280"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent" Style="{StaticResource {x:Type Window}}">
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}" /></Window.InputBindings>
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="56" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0" MouseLeftButtonDown="HeaderMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="履歴詳細 — 受注操作履歴" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HeaderSubtitle}" ToolTip="{Binding HeaderSubtitle}" Foreground="White" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="36" Height="36" Command="{Binding CloseCommand}" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="24" ToolTip="閉じる" AutomationProperties.Name="履歴詳細を閉じる" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                <StackPanel>
                    <TextBlock Text="操作情報" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}" Margin="0,0,0,8" />
                    <Border Background="{StaticResource ThemeCanvas}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="操作種別" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4,10,4" />
                            <TextBlock Grid.Column="1" Text="{Binding Operation}" Foreground="{StaticResource ThemeText}" FontWeight="SemiBold" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="操作日時" Foreground="{StaticResource ThemeSecondaryText}" Margin="12,4,10,4" />
                            <TextBlock Grid.Column="3" Text="{Binding Timestamp}" Foreground="{StaticResource ThemeText}" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="実行担当者" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4,10,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Actor}" Foreground="{StaticResource ThemeText}" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="営業所" Foreground="{StaticResource ThemeSecondaryText}" Margin="12,4,10,4" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Office}" Foreground="{StaticResource ThemeText}" Margin="0,4" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="対象受注" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4,10,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding OrderNumber}" Foreground="{StaticResource ThemeText}" Margin="0,4" />
                            <TextBlock Grid.Row="3" Text="履歴イベントID" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4,10,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EventId}" Foreground="{StaticResource ThemeText}" Margin="0,4" />
                        </Grid>
                    </Border>

                    <TabControl Margin="0,16,0,0">
                    <TabItem Header="変更内容">
                    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <Grid Background="{StaticResource ThemePaleBlue}" MinHeight="34" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="項目" FontWeight="SemiBold" FontSize="13" Margin="8,6" />
                                <TextBlock Grid.Column="1" Text="変更前" FontWeight="SemiBold" FontSize="13" Margin="8,6" />
                                <TextBlock Grid.Column="2" Text="変更後" FontWeight="SemiBold" FontSize="13" Margin="8,6" />
                            </Grid>
                            <TextBlock Text="記録された変更項目はありません。" Margin="8,8" Foreground="{StaticResource ThemeSecondaryText}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasRelevantComparisons}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding RelevantComparisons}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid MinHeight="36" Margin="0,1" Background="{StaticResource ThemeSurface}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Field}" VerticalAlignment="Center" Margin="8,5" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Before}" VerticalAlignment="Center" Margin="8,5" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource ThemeSecondaryText}" />
                                        <Border Grid.Column="2" CornerRadius="4" Padding="4,0">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding Changed}" Value="True"><Setter Property="Background" Value="{StaticResource ThemePaleBlue}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding After}" VerticalAlignment="Center" Margin="4,5" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource ThemeText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    </TabItem>
                    <TabItem Header="商品別変更" Visibility="{Binding HasProductChanges, Converter={StaticResource BooleanVisibility}}">
                    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <Grid Background="{StaticResource ThemePaleBlue}" MinHeight="34">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" MinWidth="78" /><ColumnDefinition Width="Auto" MinWidth="78" /><ColumnDefinition Width="Auto" MinWidth="105" /><ColumnDefinition Width="Auto" MinWidth="105" /><ColumnDefinition Width="Auto" MinWidth="90" /></Grid.ColumnDefinitions>
                                <TextBlock Text="商品ID・商品名" FontSize="12" FontWeight="SemiBold" Margin="6" />
                                <TextBlock Grid.Column="1" Text="変更前数量" FontSize="12" FontWeight="SemiBold" Margin="4" />
                                <TextBlock Grid.Column="2" Text="変更後数量" FontSize="12" FontWeight="SemiBold" Margin="4" />
                                <TextBlock Grid.Column="3" Text="変更前金額" FontSize="12" FontWeight="SemiBold" Margin="4" />
                                <TextBlock Grid.Column="4" Text="変更後金額" FontSize="12" FontWeight="SemiBold" Margin="4" />
                                <TextBlock Grid.Column="5" Text="明細金額÷数量" FontSize="12" FontWeight="SemiBold" Margin="4" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ProductChanges}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid MinHeight="36" Margin="0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" MinWidth="78" /><ColumnDefinition Width="Auto" MinWidth="78" /><ColumnDefinition Width="Auto" MinWidth="105" /><ColumnDefinition Width="Auto" MinWidth="105" /><ColumnDefinition Width="Auto" MinWidth="90" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="6,2"><TextBlock Text="{Binding Product}" TextWrapping="Wrap" /><TextBlock Foreground="{StaticResource ThemeSecondaryText}" FontSize="11"><Run Text="{Binding ProductIdText, Mode=OneWay}" /><Run Text="　" /><Run Text="{Binding ChangeKind, Mode=OneWay}" /></TextBlock></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding BeforeQuantity}" VerticalAlignment="Center" Margin="4" />
                                        <TextBlock Grid.Column="2" Text="{Binding AfterQuantity}" VerticalAlignment="Center" Margin="4"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding QuantityChanged}" Value="True"><Setter Property="Background" Value="{StaticResource ThemePaleBlue}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding BeforeAmount}" VerticalAlignment="Center" Margin="4" />
                                        <TextBlock Grid.Column="4" Text="{Binding AfterAmount}" VerticalAlignment="Center" Margin="4"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding AmountChanged}" Value="True"><Setter Property="Background" Value="{StaticResource ThemePaleBlue}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <TextBlock Grid.Column="5" Text="{Binding UnitPrice}" VerticalAlignment="Center" Margin="4" />
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </TabItem>

                    <TabItem Header="関連情報">
                    <Expander Header="記録本文を表示" IsExpanded="False" Margin="10" Foreground="{StaticResource ThemeText}">
                        <Border Background="{StaticResource ThemeCanvas}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <TextBlock Text="{Binding OriginalDetails}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource ThemeText}" xml:space="preserve" />
                        </Border>
                    </Expander>
                    </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="20,0">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="受注詳細を開く" Command="{Binding OpenOrderCommand}" Height="38" MinWidth="150" Margin="0,0,8,0" Style="{StaticResource ThemePrimaryButton}" />
                        <Button Content="閉じる" Command="{Binding CloseCommand}" Height="38" MinWidth="90" />
                    </StackPanel>
                    <TextBlock Text="{Binding FooterOrderNumber}" Foreground="{StaticResource ThemeSecondaryText}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
