<UserControl x:Class="SalesManagement_SysDev.OrderProductDetailsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Visibility="{Binding IsProductDetailsVisible, Converter={StaticResource BooleanVisibility}}"
             IsHitTestVisible="{Binding IsProductDetailsVisible}"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <local:ProductThumbnailConverter x:Key="ProductThumbnailSource" />
        <Style x:Key="ProductDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}" />
            <Setter Property="FontSize" Value="{StaticResource TypographyLabelSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProductDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeOrderText}" />
            <Setter Property="FontSize" Value="{StaticResource TypographyLabelSize}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,7,0,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProductDetailRowSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOrderDialogBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="ProductDetailStockNumbers" TargetType="StackPanel">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeSecondaryText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProductDetails.DetailStockCondition}" Value="Normal">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeStockNormalText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProductDetails.DetailStockCondition}" Value="Low">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeStockLowText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProductDetails.DetailStockCondition}" Value="Empty">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeDanger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProductDetailStockStatus" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProductDetails.DetailStockCondition}" Value="Normal">
                    <Setter Property="Text" Value="在庫あり" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProductDetails.DetailStockCondition}" Value="Low">
                    <Setter Property="Text" Value="低在庫" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProductDetails.DetailStockCondition}" Value="Empty">
                    <Setter Property="Text" Value="在庫切れ" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseProductDetailsCommand}" />
    </UserControl.InputBindings>

    <Grid Background="#66061A3D">
        <Grid x:Name="DialogViewport" Margin="12">
            <Grid Width="440"
                  MaxWidth="{Binding ActualWidth, ElementName=DialogViewport}"
                  MaxHeight="{Binding ActualHeight, ElementName=DialogViewport}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform><TranslateTransform x:Name="DialogOffset" /></Grid.RenderTransform>
                <Border CornerRadius="10" Background="{DynamicResource ThemeSurface}" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect Color="#091B38" BlurRadius="18" ShadowDepth="4" Opacity="0.20" /></Border.Effect>
                </Border>
                <Border x:Name="ProductDetailsCard" Background="{DynamicResource ThemeSurface}"
                        BorderBrush="{DynamicResource ThemeOrderDialogBorder}" BorderThickness="1"
                        CornerRadius="10" AutomationProperties.Name="商品詳細">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource DialogHeader}" Background="{DynamicResource ThemeOrderNavy}"
                                MinHeight="44" Padding="14,0,6,0" CornerRadius="9,9,0,0">
                            <DockPanel>
                                <Button x:Name="DismissProductDetailsButton" DockPanel.Dock="Right" Style="{StaticResource ThemeIconButton}"
                                        Command="{Binding CloseProductDetailsCommand}" VerticalAlignment="Center"
                                        ToolTip="閉じる (Esc)" AutomationProperties.Name="商品詳細を閉じる">
                                    <local:LucideIcon Data="{StaticResource IconX}" Width="17" Height="17" Stroke="{DynamicResource ThemeSidebarForeground}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <local:LucideIcon Data="{StaticResource IconProduct}" Width="18" Height="18"
                                                      Stroke="{DynamicResource ThemeSidebarForeground}" Margin="0,0,8,0" />
                                    <TextBlock Text="商品詳細" FontSize="16" FontWeight="{StaticResource TypographyBold}"
                                               Foreground="{DynamicResource ThemeSidebarForeground}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer x:Name="ProductDetailsScroller" Grid.Row="1" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="96" Height="96" VerticalAlignment="Top" CornerRadius="8"
                                            Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeOrderDialogBorder}" BorderThickness="1">
                                        <Grid>
                                            <Image x:Name="ProductThumbnail" Margin="4" Stretch="Uniform"
                                                   Source="{Binding ProductDetails.PrId, Converter={StaticResource ProductThumbnailSource}, Mode=OneWay}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="選択商品の画像" />
                                            <StackPanel x:Name="ProductThumbnailPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=ProductThumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <local:LucideIcon Data="{StaticResource IconProduct}" Width="27" Height="27"
                                                                  Stroke="{DynamicResource ThemeIconDefault}" />
                                                <TextBlock Text="画像なし" Foreground="{DynamicResource ThemeSecondaryText}"
                                                           FontSize="12" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductDetails.ProductCode}" ToolTip="{Binding ProductDetails.ProductCode}"
                                                   Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProductDetails.ProductName}" TextWrapping="Wrap" Margin="0,1,0,4"
                                                   Foreground="{DynamicResource ThemeOrderText}" FontSize="20" FontWeight="{StaticResource TypographyBold}" />
                                        <Border Background="{DynamicResource ThemeSubtle}" HorizontalAlignment="Left" Padding="7,2" CornerRadius="6">
                                            <TextBlock Text="{Binding ProductDetails.CategoryName}" Foreground="{DynamicResource ThemeOrderText}"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Text="{Binding ProductDetails.MakerDisplayName}" Foreground="{DynamicResource ThemeSecondaryText}"
                                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,10,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.ColumnSpan="2" Style="{StaticResource ProductDetailRowSeparator}" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ProductDetailRowSeparator}" />
                                    <TextBlock Text="商品コード" Style="{StaticResource ProductDetailLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProductDetails.ProductCode}" Style="{StaticResource ProductDetailValue}" />
                                    <TextBlock Grid.Row="1" Text="メーカー" Style="{StaticResource ProductDetailLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductDetails.MakerDisplayName}" Style="{StaticResource ProductDetailValue}" />
                                    <TextBlock Grid.Row="2" Text="カテゴリー" Style="{StaticResource ProductDetailLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductDetails.CategoryName}" Style="{StaticResource ProductDetailValue}" />
                                </Grid>

                                <Border Background="{DynamicResource ThemeSubtle}" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="単価" Style="{StaticResource ProductDetailLabel}" />
                                            <TextBlock x:Name="ProductDetailPrice" Text="{Binding ProductDetails.UnitPrice, StringFormat='¥{0:N0}'}"
                                                       FontSize="24" FontWeight="{StaticResource TypographyBold}" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource ThemeOrderNavy}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource ThemeOrderDialogBorder}" Margin="0,2" />
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource ProductDetailStockNumbers}">
                                            <TextBlock Text="現在庫数" Style="{StaticResource ProductDetailLabel}" TextAlignment="Right" />
                                            <TextBlock x:Name="ProductDetailStock" Text="{Binding ProductDetails.DetailStockText}"
                                                       TextAlignment="Right" TextWrapping="Wrap" Margin="0,2,0,0" FontWeight="{StaticResource TypographyBold}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="20" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProductDetails.DetailStockCondition}" Value="Unavailable">
                                                                <Setter Property="FontSize" Value="16" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock TextAlignment="Right" FontSize="11" Style="{StaticResource ProductDetailStockStatus}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Style="{StaticResource DialogFooter}" Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOrderDialogBorder}" MinHeight="54" Padding="14,7" CornerRadius="0,0,9,9">
                            <Button x:Name="CloseProductDetailsButton" Content="閉じる" Command="{Binding CloseProductDetailsCommand}"
                                    Style="{StaticResource ThemePrimaryButton}" Width="100" Height="38" HorizontalAlignment="Right"
                                    Background="{DynamicResource ThemeOrderNavy}" BorderBrush="{DynamicResource ThemeOrderNavy}"
                                    Foreground="{DynamicResource ThemeSidebarForeground}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
