<Window x:Class="SalesManagement_SysDev.F_OrderUpdate"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SalesManagement_SysDev" Title="受注更新" Width="1150" Height="760" MinWidth="900" MinHeight="580"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding EscapeCommand}"/></Window.InputBindings>
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SalesManagement_SysDev;component/Resources/Registration.xaml"/><ResourceDictionary Source="/SalesManagement_SysDev;component/Resources/QuantityInput.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource RegistrationHint}"/>
  <Style x:Key="UpdateQuantity" TargetType="local:QuantityUpDown" BasedOn="{StaticResource QuantityUpDown}"><Setter Property="Width" Value="106"/><Setter Property="Height" Value="38"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Validation.ErrorTemplate"><Setter.Value><ControlTemplate><AdornedElementPlaceholder/></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsQuantityChanged}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ThemeSecondary}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="UpdateDateFields" TargetType="UniformGrid"><Setter Property="Columns" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource RegistrationBelowBreakpoint}, ConverterParameter=330}" Value="True"><Setter Property="Columns" Value="1"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="UpdateFirstDate" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,6,0"/><Style.Triggers><DataTrigger Binding="{Binding Columns, RelativeSource={RelativeSource AncestorType=UniformGrid}}" Value="1"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="UpdateSecondDate" TargetType="StackPanel"><Setter Property="Margin" Value="6,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding Columns, RelativeSource={RelativeSource AncestorType=UniformGrid}}" Value="1"><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="UpdateNumber" TargetType="TextBlock" BasedOn="{StaticResource RegistrationMoney}"><Setter Property="TextAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/></Style>
  <DataTemplate x:Key="UpdateCustomerSuggestion"><StackPanel Margin="4"><TextBlock Text="{Binding ClName}" TextWrapping="Wrap"/><TextBlock Text="{Binding ClId, StringFormat='C-{0:0000}'}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="UpdateProductSuggestion"><StackPanel Margin="4"><TextBlock Text="{Binding ProductName}" TextWrapping="Wrap"/><TextBlock Text="{Binding ProductCode}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}"/></StackPanel></DataTemplate>
 </ResourceDictionary></Window.Resources>
 <Grid x:Name="RootLayout" Background="{StaticResource ThemeCanvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
  <Border x:Name="Header" Height="68" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="20,0" MouseLeftButtonDown="HeaderMouseDown">
   <DockPanel><Button x:Name="HeaderCloseButton" DockPanel.Dock="Right" Command="{Binding CloseCommand}" Style="{StaticResource ThemeIconButton}" ToolTip="閉じる"><local:LucideIcon Data="{StaticResource IconX}" Width="18" Height="18"/></Button>
    <TextBlock DockPanel.Dock="Right" Text="{Binding EmployeeHeader}" Foreground="{StaticResource ThemeSecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:LucideIcon Data="{StaticResource IconEdit}" Width="20" Height="20" Stroke="{StaticResource ThemePrimary}" Margin="0,0,12,0"/><TextBlock Text="受注更新" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource ThemePrimary}"/></StackPanel>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8">
   <TextBlock Text="{Binding Detail.FooterOrderNumber}" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Border Background="{StaticResource ThemeWarningSurface}" CornerRadius="10" Padding="9,3" Margin="12,0,0,0"><TextBlock Text="{Binding Detail.BusinessStatus.Text}" Foreground="{StaticResource ThemeWarningText}" FontSize="12"/></Border>
  </StackPanel>
  <Grid x:Name="RegistrationPanels" Grid.Row="2">
   <Grid x:Name="ContentLayout">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,6,12" Focusable="False">
     <StackPanel>
      <Border x:Name="CustomerCard" IsEnabled="{Binding CanEdit}" Style="{StaticResource RegistrationCard}"><StackPanel>
       <TextBlock Text="受注情報" Style="{StaticResource RegistrationHeading}"/>
       <UniformGrid Style="{StaticResource UpdateDateFields}" Margin="0,0,0,8">
        <StackPanel Style="{StaticResource UpdateFirstDate}">
         <TextBlock Text="発注元顧客 *" Style="{StaticResource RegistrationLabel}"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CustomerDisplay}" ToolTip="{Binding CustomerDisplay}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="1" Content="変更" Command="{Binding ChangeCustomerCommand}" Width="58" Height="38" Margin="8,0,0,0"/></Grid>
        </StackPanel>
        <StackPanel Style="{StaticResource UpdateSecondDate}">
         <TextBlock Text="受付営業所" Style="{StaticResource RegistrationLabel}"/>
         <local:RegistrationLookup x:Name="OfficeLookup" Text="{Binding Detail.OfficeName, Mode=OneWay}" ItemsSource="{Binding Entry.Offices}" IsEnabled="False" ToolTip="受付営業所は変更できません。" AccessibleName="受付営業所（変更不可）"/>
        </StackPanel>
       </UniformGrid>
       <local:RegistrationLookup x:Name="CustomerLookup" Visibility="{Binding IsCustomerSelectionVisible, Converter={StaticResource BooleanVisibility}}"
        Text="{Binding Entry.CustomerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Entry.Clients}" SelectCommand="{Binding SelectCustomerCommand}" SuggestionTemplate="{StaticResource UpdateCustomerSuggestion}" Placeholder="顧客ID・顧客名で検索" AccessibleName="変更する顧客" Margin="0,0,0,8"/>
       <UniformGrid Style="{StaticResource UpdateDateFields}" Margin="0,0,0,8">
        <StackPanel Style="{StaticResource UpdateFirstDate}"><TextBlock Text="受注日 *" Style="{StaticResource RegistrationLabel}"/><DatePicker x:Name="OrderDateInput" SelectedDate="{Binding OrderDate, Mode=TwoWay}" DateValidationError="DateValidationError" SelectedDateChanged="DateInputChanged" Height="38" AutomationProperties.Name="受注日"/></StackPanel>
        <StackPanel Style="{StaticResource UpdateSecondDate}"><TextBlock Text="納品希望日" Style="{StaticResource RegistrationLabel}"/><DatePicker x:Name="DeliveryDateInput" SelectedDate="{Binding DeliveryDate, Mode=TwoWay}" DateValidationError="DateValidationError" SelectedDateChanged="DateInputChanged" Height="38" AutomationProperties.Name="納品希望日"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="{Binding DateInputError}" Style="{StaticResource FieldError}"/>
       <TextBlock Text="受注受付担当者" Style="{StaticResource RegistrationLabel}"/><TextBlock Text="{Binding Detail.EmployeeName}" FontWeight="SemiBold"/>
      </StackPanel></Border>
      <Border IsEnabled="{Binding CanEdit}" Style="{StaticResource RegistrationCard}"><StackPanel>
       <TextBlock Text="商品入力" Style="{StaticResource RegistrationHeading}"/>
       <TextBlock Text="商品コード・商品名 *" Style="{StaticResource RegistrationLabel}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <local:RegistrationLookup x:Name="ProductLookup" Text="{Binding Entry.ProductSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Entry.Products}" SelectCommand="{Binding Entry.SelectProductCommand}" SuggestionTemplate="{StaticResource UpdateProductSuggestion}" Placeholder="コード・商品名・バーコードで検索" AccessibleName="商品コード・商品名・バーコード" Invalid="{Binding Entry.ProductInputInvalid}"/>
        <Button x:Name="ProductDetailsButton" Grid.Column="1" Content="詳細" Command="{Binding Entry.ShowProductDetailsCommand}" Width="58" Height="38" Margin="8,0,0,0"/>
       </Grid>
       <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Entry.QuantityLabel}" Style="{StaticResource RegistrationLabel}"/><local:QuantityUpDown x:Name="QuantityInput" Text="{Binding Entry.Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Maximum="{Binding Entry.MaximumQuantity}" Style="{StaticResource QuantityUpDown}" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="追加数量"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="単価" Style="{StaticResource RegistrationLabel}"/><TextBlock Text="{Binding Entry.UnitPriceDisplay}" Height="38" Padding="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}"/><Style.Triggers><DataTrigger Binding="{Binding Entry.HasSelectedProduct}" Value="True"><Setter Property="Foreground" Value="{StaticResource ThemePrimary}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
       </Grid>
       <TextBlock DataContext="{Binding EntryStockStatus}" Style="{StaticResource OrderStockHint}"/>
       <TextBlock Text="{Binding Entry.QuantityError}" Style="{StaticResource FieldError}"/>
       <TextBlock Text="{Binding Entry.Feedback}" Style="{StaticResource FieldError}"/>
       <Button x:Name="AddProductButton" Command="{Binding AddLineCommand}" Style="{StaticResource ThemePrimaryButton}" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconPlus}" Width="16" Height="16" Stroke="White" Margin="0,0,8,0"/><TextBlock Text="商品を追加"/></StackPanel></Button>
      </StackPanel></Border>
      <Border x:Name="RemarksCard" Style="{StaticResource RegistrationCard}" Margin="0"><StackPanel>
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="50文字以内" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}"/><TextBlock Text="備考" Style="{StaticResource RegistrationHeading}"/></DockPanel>
       <TextBox IsEnabled="{Binding CanEdit}" x:Name="RemarksInput" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding RemarksMaxLength}" Style="{StaticResource MultilineInput}" Height="72" AutomationProperties.Name="備考"/>
       <TextBlock Text="{Binding RemarksError}" Style="{StaticResource FieldError}"/>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Column="1" Margin="6,0,12,12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="ItemsCard" VerticalAlignment="Top" Style="{StaticResource RegistrationCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel x:Name="ItemsHeading" Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding QuantitySummary}" FontSize="12" Foreground="{StaticResource ThemeSecondaryText}"/><TextBlock Text="受注明細" Style="{StaticResource RegistrationHeading}" Margin="0"/></DockPanel>
      <DataGrid x:Name="ItemsGrid" Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
       HeadersVisibility="Column" RowHeaderWidth="0" ColumnHeaderHeight="36" RowHeight="NaN" MinRowHeight="56" GridLinesVisibility="Horizontal" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
       <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,6"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="{StaticResource ThemePaleBlue}"/></Style></DataGrid.ColumnHeaderStyle>
       <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Focusable" Value="False"/></Style></DataGrid.CellStyle>
       <DataGrid.Columns>
        <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="26" ElementStyle="{StaticResource UpdateNumber}"/>
        <DataGridTemplateColumn Header="商品コード / 商品名" Width="*" MinWidth="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,6" VerticalAlignment="Center"><TextBlock Text="{Binding ProductCode}" FontSize="11" Foreground="{StaticResource ThemeSecondaryText}"/><TextBlock Text="{Binding ProductName}" TextWrapping="Wrap" FontSize="13"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="数量" Width="0.8*" MinWidth="110" MaxWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="2,6"><local:QuantityUpDown Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Maximum="{Binding MaximumQuantity}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}" PreserveInvalidInput="True" Style="{StaticResource UpdateQuantity}" AutomationProperties.Name="数量"/>
         <TextBlock DataContext="{Binding StockStatus}" Style="{StaticResource OrderStockHint}" TextAlignment="Center"/><TextBlock Text="{Binding QuantityError}" Style="{StaticResource FieldError}"/>
        </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="単価" Width="74"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding UnitPrice, StringFormat='¥{0:N0}'}" Style="{StaticResource RegistrationMoney}" TextWrapping="Wrap" AutomationProperties.Name="単価"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="行合計（税込）" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TotalText}" Style="{StaticResource RegistrationMoney}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="操作" Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ThemeIconButton}" Width="32" Height="36" ToolTip="{Binding RemoveHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="商品を削除"><local:LucideIcon Data="{StaticResource IconTrash}" Width="16" Height="16" Stroke="{StaticResource ThemeDanger}"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid></Border>
     <Border Grid.Row="1" Visibility="{Binding HasUndo, Converter={StaticResource BooleanVisibility}}" Style="{StaticResource RegistrationCard}" Padding="8"><DockPanel><Button Content="元に戻す" Command="{Binding UndoRemoveLineCommand}" DockPanel.Dock="Right" Height="28"/><TextBlock Text="商品を削除しました。" VerticalAlignment="Center" FontSize="12"/></DockPanel></Border>
     <Border x:Name="AmountSummary" Grid.Row="2" Style="{StaticResource RegistrationCard}" Margin="0" ToolTip="{Binding RoundingNotice}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <TextBlock Text="税抜合計" Foreground="{StaticResource ThemeSecondaryText}"/><TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='¥{0:N0}'}" TextAlignment="Right"/>
      <TextBlock Grid.Row="1" Text="消費税" Foreground="{StaticResource ThemeSecondaryText}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tax, StringFormat='¥{0:N0}'}" TextAlignment="Right"/>
      <TextBlock Grid.Row="2" Text="税込合計" FontWeight="Bold" Foreground="{StaticResource ThemePrimary}" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Total, StringFormat='¥{0:N0}'}" TextAlignment="Right" FontWeight="Bold" FontSize="24" Foreground="{StaticResource ThemePrimary}" VerticalAlignment="Center"/>
     </Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="Footer" Grid.Row="3" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Feedback}" ToolTip="{Binding Feedback}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ThemeSecondaryText}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ThemeDangerText}"/></DataTrigger><DataTrigger Binding="{Binding HasSaved}" Value="True"><Setter Property="Foreground" Value="{StaticResource ThemeSuccessText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CancelButton" Content="キャンセル" Command="{Binding CloseCommand}" Width="110" Height="40" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Style="{StaticResource ThemePrimaryButton}" Width="150" Height="40"/></StackPanel>
  </Grid></Border>
  <local:OrderProductDetailsOverlay x:Name="ProductDetailsOverlay" DataContext="{Binding Entry}" Grid.RowSpan="4" Panel.ZIndex="90"/>
 </Grid>
</Window>
