<Window x:Class="SalesManagement_SysDev.PurchaseReceiptHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="発注履歴" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/SalesManagement_SysDev;component/Resources/OrderManagement.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="HistoryInput" TargetType="TextBox" BasedOn="{StaticResource FilterInput}">
                <Setter Property="Height" Value="36" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource ThemeCanvas}">
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
        <Border Background="{StaticResource OrderHeader}" Padding="16,0">
            <TextBlock Text="発注履歴 · 関連入庫" Foreground="White" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Margin="12,10,12,8">
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,6,0"><TextBlock Text="発注番号・入庫番号・仕入先" Style="{StaticResource OrderFilterLabel}" />
                    <TextBox x:Name="Search" TextChanged="Filters_Changed" Style="{StaticResource HistoryInput}" /></StackPanel>
                <StackPanel Margin="0,0,6,0"><TextBlock Text="入庫日（開始）" Style="{StaticResource OrderFilterLabel}" />
                    <DatePicker x:Name="StartDate" SelectedDateChanged="Filters_Changed" DateValidationError="Date_Invalid" PreviewTextInput="Date_Editing" Style="{StaticResource FilterDate}" /></StackPanel>
                <StackPanel><TextBlock Text="入庫日（終了）" Style="{StaticResource OrderFilterLabel}" />
                    <DatePicker x:Name="EndDate" SelectedDateChanged="Filters_Changed" DateValidationError="Date_Invalid" PreviewTextInput="Date_Editing" Style="{StaticResource FilterDate}" /></StackPanel>
            </UniformGrid>
            <TextBlock x:Name="FilterError" Foreground="{StaticResource OrderDanger}" Margin="0,5,0,0" />
        </StackPanel>
        <DataGrid x:Name="ReceiptsGrid" Grid.Row="2" Margin="12,0,12,0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="33"
                  ColumnHeaderStyle="{StaticResource OrderColumnHeader}" CellStyle="{StaticResource OrderListCell}" RowStyle="{StaticResource OrderGridRow}"
                  AlternationCount="2" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}" MouseDoubleClick="Receipt_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="入庫日" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="92" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="発注番号" Binding="{Binding OrderCode}" Width="99" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="入庫番号" Binding="{Binding Code}" Width="96" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="仕入先" Binding="{Binding MakerName}" Width="*" MinWidth="82" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="入庫数量" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="79" ElementStyle="{StaticResource TableNumber}" />
                <DataGridTextColumn Header="入庫担当者" Binding="{Binding EmployeeName}" Width="106" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="入庫状況" Binding="{Binding Status}" Width="119" ElementStyle="{StaticResource TableText}" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="入庫詳細" Click="Receipt_Click" Height="34" Margin="0,0,6,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OrderToolbarButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=ReceiptsGrid}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                    <Button Content="閉じる" IsCancel="True" Style="{StaticResource OrderToolbarButton}" Height="34" />
                </StackPanel>
                <TextBlock Text="発注の操作履歴は未記録です。" Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
