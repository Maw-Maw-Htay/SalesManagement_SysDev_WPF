<Window x:Class="SalesManagement_SysDev.F_SaleDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="売上詳細" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource TypographyFontFamily}" FontSize="14">
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="60" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Sale.DetailHeader}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="保存済みの売上情報を表示します。" FontSize="12" Foreground="White" Opacity="0.82" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#DCFCE7" /><Style.Triggers>
                            <DataTrigger Binding="{Binding Sale.ManagementLabel}" Value="非表示"><Setter Property="Background" Value="#F1F5F9" /></DataTrigger>
                            <DataTrigger Binding="{Binding Sale.ManagementLabel}" Value="要確認"><Setter Property="Background" Value="#FEF3C7" /></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding Sale.ManagementLabel}" FontSize="12">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#166534" /><Style.Triggers>
                                <DataTrigger Binding="{Binding Sale.ManagementLabel}" Value="非表示"><Setter Property="Foreground" Value="#475569" /></DataTrigger>
                                <DataTrigger Binding="{Binding Sale.ManagementLabel}" Value="要確認"><Setter Property="Foreground" Value="#92400E" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="売上情報" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ThemePrimary}" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="売上番号" Foreground="{StaticResource ThemeSecondaryText}" /><TextBlock Grid.Column="1" Text="{Binding Sale.Code}" /></Grid>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="売上日" Foreground="{StaticResource ThemeSecondaryText}" /><TextBlock Grid.Column="1" Text="{Binding Sale.SaleDate, StringFormat={}{0:yyyy/MM/dd}}" /></Grid>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="注文番号" Foreground="{StaticResource ThemeSecondaryText}" /><TextBlock Grid.Column="1" Text="{Binding Sale.OrderCode}" /></Grid>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="担当社員" Foreground="{StaticResource ThemeSecondaryText}" /><TextBlock Grid.Column="1" Text="{Binding Sale.EmployeeName}" TextWrapping="Wrap" /></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="営業所" Foreground="{StaticResource ThemeSecondaryText}" /><TextBlock Grid.Column="1" Text="{Binding Sale.OfficeName}" TextWrapping="Wrap" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="顧客・金額情報" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ThemePrimary}" Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="顧客コード" Foreground="{StaticResource ThemeSecondaryText}" /><TextBlock Grid.Column="1" Text="{Binding Sale.CustomerCode}" /></Grid>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="顧客名" Foreground="{StaticResource ThemeSecondaryText}" /><TextBlock Grid.Column="1" Text="{Binding Sale.CustomerName}" TextWrapping="Wrap" /></Grid>
                                <TextBlock Text="明細金額の合計" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,8,0,2" />
                                <TextBlock Text="{Binding Sale.AmountText}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource ThemeText}" />
                                <TextBlock Text="税額・税抜金額は既存データにないため表示していません。" Foreground="{StaticResource ThemeSecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="220" /></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="売上明細" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ThemePrimary}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Sale.LineCount, StringFormat={}{0:N0} 件}" Foreground="{StaticResource ThemeSecondaryText}" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="42" ColumnHeaderStyle="{StaticResource {x:Type DataGridColumnHeader}}"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" Width="120" />
                                    <DataGridTextColumn Header="JANコード" Binding="{Binding JanCode}" Width="150" />
                                    <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" MinWidth="160" />
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="90" ElementStyle="{StaticResource TableNumber}" />
                                    <DataGridTextColumn Header="保存済み明細金額" Binding="{Binding StoredAmount, StringFormat={}{0:¥#,##0}}" Width="160" ElementStyle="{StaticResource TableNumber}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0"
                            Visibility="{Binding Sale.HasHiddenReason, Converter={StaticResource BooleanVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="非表示理由：" Foreground="#9A3412" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Sale.HiddenReason}" Foreground="#9A3412" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="18,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="売上を非表示にする" Click="Hide_Click" Visibility="{Binding CanHideSale, Converter={StaticResource BooleanVisibility}}"
                            MinWidth="150" Padding="14,7" Margin="0,0,8,0" Foreground="{StaticResource ThemeDangerText}" BorderBrush="{StaticResource ThemeDanger}" />
                    <Button Content="閉じる" IsCancel="True" MinWidth="90" Padding="14,7" Click="Close_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
