<Window x:Class="SalesManagement_SysDev.F_ArrivalHide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入荷を非表示" Width="500" MinWidth="440" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border Background="{StaticResource ThemeSurface}" CornerRadius="8" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="64" /></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="20,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="入荷を非表示" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <Button DockPanel.Dock="Right" Content="×" Click="Cancel_Click" Width="32" Height="32" Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="20" />
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="22,20,22,18">
                <TextBlock Text="確定済みの入荷情報を非表示にします。" Foreground="{StaticResource ThemeText}" FontSize="14" TextWrapping="Wrap" />
                <Border Background="{StaticResource ThemeCanvas}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="{Binding TargetText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="入荷データは削除されず、管理状態だけが変更されます。関連する注文・出荷・在庫数量は変更されません。"
                           Foreground="{StaticResource ThemeSecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,12" />
                <TextBlock Text="非表示理由 *" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="82" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="500"
                         AutomationProperties.Name="非表示理由" AutomationProperties.HelpText="必須。500文字以内で入力してください。" />
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource ThemeDangerText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Padding="20,0" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="キャンセル" Click="Cancel_Click" IsCancel="True" MinWidth="110" Height="38" Margin="0,0,8,0" />
                    <Button Content="非表示にする" Click="Confirm_Click" MinWidth="130" Height="38" IsEnabled="{Binding CanConfirm}"
                            Background="{StaticResource ThemeDanger}" BorderBrush="{StaticResource ThemeDanger}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
