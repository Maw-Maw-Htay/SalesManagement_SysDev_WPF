<Window x:Class="SalesManagement_SysDev.OutboundArrivalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="関連入荷情報" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource ThemeCanvas}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/OrderManagement.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
        <Border Background="{StaticResource OrderHeader}" Padding="14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="関連入荷情報" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Code}" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <DataGrid x:Name="ArrivalsGrid" Grid.Row="1" Margin="12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="34" ColumnHeaderStyle="{StaticResource OrderColumnHeader}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="入荷番号" Binding="{Binding Code}" Width="102" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="入荷日" Binding="{Binding ArrivalDateText}" Width="102" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="入荷数量" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="88" ElementStyle="{StaticResource TableNumber}" />
                <DataGridTextColumn Header="入荷状態" Binding="{Binding ArrivalStateLabel}" Width="90" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="入荷担当者" Binding="{Binding EmployeeName}" Width="*" MinWidth="82" ElementStyle="{StaticResource TableText}" />
                <DataGridTemplateColumn Header="詳細" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <Button Content="詳細" Click="Detail_Click" Height="27" Padding="8,0" Style="{StaticResource OrderToolbarButton}" HorizontalAlignment="Center" />
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="関連する入荷データはありません。" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Grid.Row="2" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="0,1,0,0" Padding="12,0">
            <Button Content="閉じる" IsCancel="True" Style="{StaticResource OrderToolbarButton}" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
