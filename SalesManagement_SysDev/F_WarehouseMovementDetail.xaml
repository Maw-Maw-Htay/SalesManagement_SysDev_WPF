<Window x:Class="SalesManagement_SysDev.F_WarehouseMovementDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="900" Height="590" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Language="ja-JP">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/OrderManagement.xaml"/>
                <ResourceDictionary Source="Resources/EmployeeDetail.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ReceiptDetailField">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,0,8,0" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource ThemeText}" TextWrapping="Wrap"/>
                </Grid>
            </DataTemplate>
            <Style x:Key="ReceiptDetailCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ThemeSurface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,9"/>
            </Style>
            <Style x:Key="ReceiptReadGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="RowHeight" Value="34"/>
                <Setter Property="ColumnHeaderHeight" Value="34"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource OrderGridRow}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource OrderColumnHeader}"/>
                <Setter Property="CellStyle" Value="{StaticResource OrderListCell}"/>
                <Setter Property="RowBackground" Value="{StaticResource OrderSurface}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource OrderSurfaceAlt}"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource ThemeSurface}" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1" CornerRadius="9">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{StaticResource ThemePrimary}" CornerRadius="8,8,0,0" Padding="16,9,12,9">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Click="Close_Click" Width="32" Height="32" Padding="0"
                            Foreground="White" Background="Transparent" BorderThickness="0" ToolTip="閉じる" AutomationProperties.Name="閉じる"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Record.Code}" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Record.ReferenceCode}" Foreground="{StaticResource ThemePaleBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border Background="{Binding StateBackground}" CornerRadius="11" Padding="8,2">
                                <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateForeground}" FontSize="12"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl Grid.Row="1" Margin="14" Background="{StaticResource ThemeSurface}" BorderThickness="0">
                <TabItem Header="基本情報">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,10,5,2">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ReceiptDetailCard}" Margin="0,0,5,0">
                                    <ItemsControl ItemsSource="{Binding LeftFields}" ItemTemplate="{StaticResource ReceiptDetailField}"/>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource ReceiptDetailCard}" Margin="5,0,0,0">
                                    <ItemsControl ItemsSource="{Binding RightFields}" ItemTemplate="{StaticResource ReceiptDetailField}"/>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource ReceiptDetailCard}">
                                <StackPanel>
                                    <TextBlock Text="入庫商品明細" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}" Margin="0,0,0,6"/>
                                    <DataGrid x:Name="LinesGrid" ItemsSource="{Binding ReceiptLines}" Style="{StaticResource ReceiptReadGrid}" MaxHeight="264">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="48" ElementStyle="{StaticResource TableCenter}"/>
                                            <DataGridTextColumn Header="商品コード" Binding="{Binding Line.ProductCode}" Width="118" ElementStyle="{StaticResource TableText}"/>
                                            <DataGridTextColumn Header="商品名" Binding="{Binding Line.ProductName}" Width="*" MinWidth="110" ElementStyle="{StaticResource TableText}"/>
                                            <DataGridTextColumn x:Name="OrderedColumn" Header="発注数量" Binding="{Binding OrderedText}" Width="86" ElementStyle="{StaticResource TableNumber}"/>
                                            <DataGridTextColumn x:Name="QuantityColumn" Header="入庫数量" Binding="{Binding Line.QuantityText}" Width="86" ElementStyle="{StaticResource TableNumber}"/>
                                            <DataGridTextColumn x:Name="DifferenceColumn" Header="今回－発注" Binding="{Binding DifferenceText}" Width="100" ElementStyle="{StaticResource TableNumber}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding ReceiptTotals}" Foreground="{StaticResource ThemeText}" Background="{StaticResource OrderSurfaceAlt}"
                                               Padding="7,6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="同じ商品が複数明細に分かれている場合、明細単位の発注数量・差異は表示しません。"
                                               Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"
                                               Visibility="{Binding ShowReceiptDifferences, Converter={StaticResource BooleanVisibility}}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding HideRestrictionText}" Foreground="{StaticResource ThemeWarningText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding CanShowHideRestriction, Converter={StaticResource BooleanVisibility}}"/>
                            <TextBlock Text="非表示理由が記録された確定済みの入庫だけ復元できます。"
                                       Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding ShowRestoreRestriction, Converter={StaticResource BooleanVisibility}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="関連発注情報" Visibility="{Binding HasRelatedPurchase, Converter={StaticResource BooleanVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,10,5,2">
                            <Border Style="{StaticResource ReceiptDetailCard}" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding PurchaseFields}" ItemTemplate="{StaticResource ReceiptDetailField}"/>
                            </Border>
                            <DataGrid ItemsSource="{Binding RelatedPurchase.Lines}" Style="{StaticResource ReceiptReadGrid}" MaxHeight="248">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" Width="125" ElementStyle="{StaticResource TableText}"/>
                                    <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" MinWidth="110" ElementStyle="{StaticResource TableText}"/>
                                    <DataGridTextColumn Header="発注数量" Binding="{Binding OrderedQuantity, StringFormat=N0}" Width="95" ElementStyle="{StaticResource TableNumber}"/>
                                    <DataGridTextColumn Header="入庫済数量" Binding="{Binding ReceivedQuantity, StringFormat=N0}" Width="105" ElementStyle="{StaticResource TableNumber}"/>
                                    <DataGridTextColumn Header="未入庫数量" Binding="{Binding RemainingQuantity, StringFormat=N0}" Width="105" ElementStyle="{StaticResource TableNumber}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="発注詳細を開く" Click="Purchase_Click" HorizontalAlignment="Right" Height="34" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="在庫情報" Visibility="{Binding ShowStockTab, Converter={StaticResource BooleanVisibility}}">
                    <Grid Margin="2,10,5,2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="入庫商品ごとの現在庫" FontWeight="SemiBold" Foreground="{StaticResource ThemeText}" Margin="0,0,0,6"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding StockLines}" Style="{StaticResource ReceiptReadGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="商品コード" Binding="{Binding ProductCode}" Width="125" ElementStyle="{StaticResource TableText}"/>
                                <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*" MinWidth="115" ElementStyle="{StaticResource TableText}"/>
                                <DataGridTextColumn Header="現在庫数" Binding="{Binding CurrentStockText}" Width="95" ElementStyle="{StaticResource TableNumber}"/>
                                <DataGridTextColumn Header="安全在庫数" Binding="{Binding SafetyStockText}" Width="95" ElementStyle="{StaticResource TableNumber}"/>
                                <DataGridTextColumn Header="在庫状態" Binding="{Binding StockConditionText}" Width="95" ElementStyle="{StaticResource TableCenter}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="在庫移動の日時や処理前後の在庫数は記録されていません。" Margin="0,8,0,0"
                                   Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" BorderBrush="{StaticResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="14,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="非表示にする" Height="36" Margin="0,0,8,0" Click="Hide_Click"
                            Foreground="{StaticResource ThemeDangerText}" Visibility="{Binding CanHide, Converter={StaticResource BooleanVisibility}}"/>
                    <Button Content="表示を復元" Height="36" Margin="0,0,8,0" Click="Restore_Click"
                            Visibility="{Binding CanRestore, Converter={StaticResource BooleanVisibility}}"/>
                    <Button Content="{Binding ConfirmActionLabel}" Height="36" Margin="0,0,8,0" Click="Confirm_Click"
                            Style="{StaticResource ThemePrimaryButton}" Visibility="{Binding CanConfirm, Converter={StaticResource BooleanVisibility}}"/>
                    <Button Content="閉じる" IsCancel="True" Click="Close_Click" Height="36"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
