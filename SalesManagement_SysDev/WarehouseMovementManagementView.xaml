<UserControl x:Class="SalesManagement_SysDev.WarehouseMovementManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SalesManagement_SysDev"
             Background="{StaticResource ThemeCanvas}" Language="ja-JP" SizeChanged="ReceivingView_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/OrderManagement.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="MovementCell" TargetType="TextBlock" BasedOn="{StaticResource TableText}"><Setter Property="Margin" Value="7,0"/></Style>
            <Style x:Key="MovementHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource OrderColumnHeader}">
                <Setter Property="Background" Value="{StaticResource OrderSurfaceAlt}"/><Setter Property="Padding" Value="6,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource OrderQuickSearchFrame}" Background="{StaticResource OrderInput}" CornerRadius="8" MinHeight="44">
                <Grid>
                    <TextBox x:Name="QuickSearch" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                             Height="42" Padding="40,4,38,4" BorderThickness="0" Background="Transparent" AutomationProperties.Name="入庫番号・発注番号・仕入先名で検索"/>
                    <local:LucideIcon Data="{StaticResource IconSearch}" Width="17" Height="17" Margin="12,0,0,0" HorizontalAlignment="Left"
                                      Stroke="{StaticResource OrderSecondaryText}" IsHitTestVisible="False"/>
                    <TextBlock Text="入庫番号・発注番号・仕入先名で検索..." Foreground="{StaticResource OrderSecondaryText}" VerticalAlignment="Center"
                               Margin="40,0,38,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Button Click="ClearQuickSearch_Click" HorizontalAlignment="Right" Width="34" Height="34" Margin="0,0,3,0"
                            Background="Transparent" BorderBrush="Transparent" ToolTip="キーワードを消去" AutomationProperties.Name="キーワードを消去">
                        <local:LucideIcon Data="{StaticResource IconX}" Width="15" Height="15"/>
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ThemeIconButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button Click="ToggleFilters_Click" Style="{StaticResource OrderToolbarButton}" Margin="0,0,8,0"
                        ToolTip="{Binding FiltersToggleLabel}" AutomationProperties.Name="詳細条件">
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconOrderFilter}" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="詳細条件" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource OrderHover}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                Visibility="{Binding HasInboundAdvanced, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding InboundAdvancedCount}" VerticalAlignment="Center"/>
                        </Border>
                        <local:LucideIcon Width="12" Height="12" Margin="6,0,0,0">
                            <local:LucideIcon.Style><Style TargetType="local:LucideIcon" BasedOn="{StaticResource {x:Type local:LucideIcon}}">
                                <Setter Property="Data" Value="{StaticResource IconChevronDown}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsFiltersExpanded}" Value="True"><Setter Property="Data" Value="{StaticResource IconChevronUp}"/></DataTrigger></Style.Triggers>
                            </Style></local:LucideIcon.Style>
                        </local:LucideIcon>
                    </StackPanel>
                </Button>
                <Button Click="Reload_Click" Style="{StaticResource OrderToolbarButton}" IsEnabled="{Binding CanReload}" AutomationProperties.Name="再読込">
                    <StackPanel Orientation="Horizontal"><local:LucideIcon Data="{StaticResource IconRefresh}" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="再読込" VerticalAlignment="Center"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1"
                CornerRadius="8" Padding="8,8,8,2" Margin="0,0,0,8" Visibility="{Binding IsFiltersExpanded, Converter={StaticResource BooleanVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="条件クリア" Style="{StaticResource OrderToolbarButton}" Click="ClearConditions_Click"
                        Height="32" HorizontalAlignment="Right" IsEnabled="{Binding HasConditions}" Margin="4,2,4,6"/>
                <ScrollViewer x:Name="AdvancedScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,0,4,7">
                            <TextBlock Text="入庫番号" Style="{StaticResource OrderFilterLabel}"/>
                            <TextBox Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                     Height="34" AutomationProperties.Name="入庫番号"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,7">
                            <TextBlock Text="発注番号" Style="{StaticResource OrderFilterLabel}"/>
                            <TextBox Text="{Binding PurchaseNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                     Height="34" AutomationProperties.Name="発注番号"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,4,7">
                            <TextBlock Text="仕入先名" Style="{StaticResource OrderFilterLabel}"/>
                            <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                     Height="34" AutomationProperties.Name="仕入先名"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,4,7">
                            <TextBlock Text="メーカー" Style="{StaticResource OrderFilterLabel}"/>
                            <ComboBox ItemsSource="{Binding PrimaryOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding PrimarySelection, Mode=TwoWay}" Style="{StaticResource FilterCombo}" Height="34" AutomationProperties.Name="メーカー"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,0,4,7">
                            <TextBlock Text="入庫日（開始）" Style="{StaticResource OrderFilterLabel}"/>
                            <DatePicker Style="{StaticResource FilterDate}" Height="34" SelectedDateFormat="Short"
                                        SelectedDate="{Binding StartDate}" DateValidationError="Date_ValidationError" SelectedDateChanged="Date_Changed"
                                        AutomationProperties.Name="入庫日（開始）"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,7">
                            <TextBlock Text="入庫日（終了）" Style="{StaticResource OrderFilterLabel}"/>
                            <DatePicker Style="{StaticResource FilterDate}" Height="34" SelectedDateFormat="Short"
                                        SelectedDate="{Binding EndDate}" DateValidationError="Date_ValidationError" SelectedDateChanged="Date_Changed"
                                        AutomationProperties.Name="入庫日（終了）"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,4,7">
                            <TextBlock Text="入庫状態" Style="{StaticResource OrderFilterLabel}"/>
                            <ComboBox x:Name="BusinessStatusPicker" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedStatus, Mode=TwoWay}" Style="{StaticResource FilterCombo}" Height="34" AutomationProperties.Name="入庫状態"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,0,4,7">
                            <TextBlock Text="入庫担当者" Style="{StaticResource OrderFilterLabel}"/>
                            <ComboBox ItemsSource="{Binding EmployeeOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding EmployeeSelection, Mode=TwoWay}" Style="{StaticResource FilterCombo}" Height="34" AutomationProperties.Name="入庫担当者"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="4,0,4,7">
                            <TextBlock Text="商品コード" Style="{StaticResource OrderFilterLabel}"/>
                            <TextBox Text="{Binding ReceiptProductCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                     Height="34" AutomationProperties.Name="商品コード"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,4,7">
                            <TextBlock Text="商品名" Style="{StaticResource OrderFilterLabel}"/>
                            <TextBox Text="{Binding ReceiptProductName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterInput}"
                                     Height="34" AutomationProperties.Name="商品名"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="4,0,4,7">
                            <TextBlock Text="発注日（開始）" Style="{StaticResource OrderFilterLabel}"/>
                            <DatePicker Style="{StaticResource FilterDate}" Height="34" SelectedDateFormat="Short"
                                        SelectedDate="{Binding PurchaseFrom}" DateValidationError="Date_ValidationError" SelectedDateChanged="Date_Changed"
                                        AutomationProperties.Name="発注日（開始）"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="4,0,4,7">
                            <TextBlock Text="発注日（終了）" Style="{StaticResource OrderFilterLabel}"/>
                            <DatePicker Style="{StaticResource FilterDate}" Height="34" SelectedDateFormat="Short"
                                        SelectedDate="{Binding PurchaseTo}" DateValidationError="Date_ValidationError" SelectedDateChanged="Date_Changed"
                                        AutomationProperties.Name="発注日（終了）"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="HistoryButton" DockPanel.Dock="Right" Content="{Binding InboundHistoryButtonText}" Click="History_Click"
                    Height="34" Padding="9,2" Margin="8,0,0,0"/>
            <Menu x:Name="StatusMenu" Background="Transparent" Padding="0" IsMainMenu="False" AutomationProperties.Name="入庫状態">
                <Menu.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></Menu.ItemsPanel>
            <MenuItem x:Name="AllTab" Style="{StaticResource StatusMenuItem}" Click="AllTab_Click">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconInbound}" Width="15" Height="15" Margin="0,0,6,0"
                                          Tag="{StaticResource OrderText}" Style="{StaticResource StatusTabIcon}"/>
                        <TextBlock Text="すべて" Tag="{StaticResource OrderText}" Style="{StaticResource StatusTabColoredText}"/>
                        <Border Tag="{StaticResource OrderInput}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0">
                            <TextBlock Text="{Binding VisibleCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderText}" Style="{StaticResource StatusTabColoredText}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="PendingTab" Style="{StaticResource StatusMenuItem}" Click="PendingTab_Click">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconClock}" Width="15" Height="15" Margin="0,0,6,0"
                                          Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabIcon}"/>
                        <TextBlock Text="未確定" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabColoredText}"/>
                        <Border Tag="{StaticResource OrderOrangeSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0">
                            <TextBlock Text="{Binding PendingCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderOrange}" Style="{StaticResource StatusTabColoredText}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="ConfirmedTab" Style="{StaticResource StatusMenuItem}" Click="ConfirmedTab_Click">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconCheckCircle}" Width="15" Height="15" Margin="0,0,6,0"
                                          Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabIcon}"/>
                        <TextBlock Text="確定済み" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabColoredText}"/>
                        <Border Tag="{StaticResource OrderGreenSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0">
                            <TextBlock Text="{Binding ConfirmedCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderGreen}" Style="{StaticResource StatusTabColoredText}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem x:Name="HiddenTab" Style="{StaticResource StatusMenuItem}" Click="HiddenTab_Click" Visibility="{Binding CanViewHidden, Converter={StaticResource BooleanVisibility}}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <local:LucideIcon Data="{StaticResource IconHidden}" Width="15" Height="15" Margin="0,0,6,0"
                                          Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabIcon}"/>
                        <TextBlock Text="非表示" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}"/>
                        <Border Tag="{StaticResource OrderDangerSurface}" Style="{StaticResource StatusTabCountBadge}" CornerRadius="4" Padding="5,0" Margin="6,0,0,0">
                            <TextBlock Text="{Binding HiddenCount, StringFormat={}{0:N0}}" Tag="{StaticResource OrderDanger}" Style="{StaticResource StatusTabColoredText}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            </Menu>
        </DockPanel>
        <Border Grid.Row="3" Background="{StaticResource OrderSurface}" BorderBrush="{StaticResource OrderDivider}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,6,10,5">
                    <DockPanel>
                        <StackPanel x:Name="ReceiptActions" DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="{Binding ReceiptSelectionText}" Foreground="{StaticResource ThemeSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="選択を確定" Click="ConfirmSelected_Click" IsEnabled="{Binding CanConfirmReceipt}"
                                    Style="{StaticResource ThemePrimaryButton}" Height="32" Padding="9,2"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding InboundListTitle}" FontWeight="SemiBold" Foreground="{StaticResource OrderText}"/>
                            <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" Foreground="{StaticResource ThemeSecondaryText}" FontSize="12"/>
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Text="確定済みの入庫記録です。入庫の操作履歴は記録されていません。" FontSize="12"
                               Foreground="{StaticResource ThemeSecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ShowingInboundHistory, Converter={StaticResource BooleanVisibility}}"/>
                    <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource ThemeSecondaryText}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Feedback}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <DataGrid x:Name="MovementsGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="34"
                          ColumnHeaderHeight="34" AlternationCount="2" GridLinesVisibility="Horizontal"
                          ColumnHeaderStyle="{StaticResource MovementHeader}" CellStyle="{StaticResource OrderListCell}" RowStyle="{StaticResource OrderGridRow}"
                          RowBackground="{StaticResource OrderSurface}" AlternatingRowBackground="{StaticResource OrderSurfaceAlt}"
                          EnableColumnVirtualization="True" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          PreviewMouseDoubleClick="MovementsGrid_MouseDoubleClick" Sorting="MovementsGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="SelectionColumn" Header="選択" Width="42" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding SelectedForConfirmation, Mode=OneWay}" IsEnabled="{Binding CanSelectInbound}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectReceipt_Click"
                                          AutomationProperties.Name="{Binding Code, StringFormat={}{0}を選択}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="入庫番号" Binding="{Binding Code}" Width="101" ElementStyle="{StaticResource MovementCell}"/>
                        <DataGridTextColumn Header="関連発注番号" Binding="{Binding ReferenceCode}" Width="105" ElementStyle="{StaticResource MovementCell}"/>
                        <DataGridTextColumn Header="仕入先名" Binding="{Binding PartnerDisplay}" Width="1.35*" MinWidth="115" ElementStyle="{StaticResource MovementCell}"/>
                        <DataGridTextColumn Header="入庫日" Binding="{Binding MovementDateText}" Width="94" ElementStyle="{StaticResource MovementCell}"/>
                        <DataGridTextColumn Header="明細数" Binding="{Binding Data.LineCount, StringFormat=N0}" Width="58"
                                            HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}"/>
                        <DataGridTextColumn Header="入庫数量" Binding="{Binding QuantityText}" Width="74"
                                            HeaderStyle="{StaticResource OrderRightHeader}" ElementStyle="{StaticResource TableNumber}"/>
                        <DataGridTemplateColumn Header="入庫状態" SortMemberPath="BusinessStatusLabel" Width="88">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Background="{Binding BusinessStatusBackground}" CornerRadius="10" Padding="8,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BusinessStatusLabel}" Foreground="{Binding BusinessStatusForeground}" FontSize="12"/>
                                </Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="VisibilityColumn" Header="管理状態" Width="80" Visibility="Collapsed" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Background="{Binding ManagementBackground}" CornerRadius="10" Padding="8,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ManagementLabel}" Foreground="{Binding ManagementForeground}" FontSize="12"/>
                                </Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="詳細" Width="57" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="詳細" Tag="{Binding}" Click="Detail_Click" Height="25" Padding="5,0" Margin="3,0" VerticalAlignment="Center"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyDescription}" Foreground="{StaticResource ThemeSecondaryText}" Margin="0,6,0,0" TextAlignment="Center"/>
                </StackPanel>
                <DockPanel Grid.Row="2" Margin="10,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="前へ" Click="Previous_Click" IsEnabled="{Binding CanPrevious}" Height="32" Padding="7,2" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding InboundPages}" SelectedItem="{Binding InboundPageSelection, Mode=TwoWay}" Style="{StaticResource FilterCombo}"
                                  Width="76" Height="32" AutomationProperties.Name="ページ番号"/>
                        <TextBlock Text="{Binding PageCount, StringFormat={}/ {0}}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                        <Button Content="次へ" Click="Next_Click" IsEnabled="{Binding CanNext}" Height="32" Padding="7,2" Margin="0,0,9,0"/>
                        <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}" Style="{StaticResource FilterCombo}"
                                  Width="76" Height="32" AutomationProperties.Name="1ページの表示件数"/>
                        <TextBlock Text="件 / ページ" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ThemeSecondaryText}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
